# The Otta commerce service (@otta-sh/service) as a container — DEPLOYMENT.md
# §3bis. Serves the Hono REST API on PORT (3000) against the Postgres in
# PG_CONNECTION_STRING, running the same forward-only migrations on boot that
# the Node and Worker entries do.
#
# Build from the REPO ROOT, this is not a package-local build context:
#   docker build -f Dockerfile.service -t otta-service .
FROM node:22-slim AS base
# pnpm via npm rather than corepack: corepack resolves and verifies the package
# manager over the network on first invocation, which makes every build stage a
# separate network failure point.
RUN npm install -g pnpm@11.10.0
WORKDIR /app

FROM base AS build
COPY . .
# --ignore-scripts skips better-sqlite3's native compile, which this image has
# no C++ toolchain for and no use for: the service is postgres-only and
# src/index.ts imports the sqlite-free `@otta-sh/store-postgres/pg` subpath
# (pinned by test/container-entry.test.ts). Every other package's install
# script is a no-op validation or ships prebuilt platform binaries as ordinary
# optional dependencies.
RUN pnpm install --frozen-lockfile --ignore-scripts
# One self-contained ESM file — see tsdown.container.config.ts for why the
# container build bundles where the published build externalizes.
RUN pnpm --filter @otta-sh/service build:container

FROM base AS runtime
ENV NODE_ENV=production
# No `pnpm install` and no node_modules: the bundle carries its whole
# dependency graph. Only Node's own builtins are resolved at runtime.
COPY --from=build /app/packages/service/dist/container/index.mjs ./index.mjs
RUN chown -R node:node /app
USER node

# @hono/node-server binds 0.0.0.0 by default, which is what the kubelet's
# probes need (a loopback bind fails liveness and the container is killed).
# There is no HOST support to narrow that today — issue #43.
ENV PORT=3000
EXPOSE 3000

# Required: PG_CONNECTION_STRING.
# Strongly recommended: SERVICE_API_TOKEN (without it the write surface is
# open — the entry logs a warning at boot). See DEPLOYMENT.md §4 for the rest
# (INTERNAL_API_TOKEN, STRIPE_*, EMAIL_*, X402_*).
# Health: GET /health -> {"ok":true}
CMD ["node", "./index.mjs"]
