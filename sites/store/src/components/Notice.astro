---
/**
 * Notice — degraded, not crashed (docs/theme/TEMPERED.md §4, §8).
 *
 * The theme already renders 200 when the commerce service is unreachable:
 * content survives, money does not. That deserves a designed treatment rather
 * than a yellow box, so the device is the theme's own — the continuous hairline
 * BREAKS into a dashed bronze one, top and bottom, with a dashed mark beside
 * the text. Same grammar as a released hold and an expired order.
 *
 * Explicitly NO filled background. A filled panel would be the only fill on the
 * page and would read as more alarming than the situation usually is; and a
 * tinted panel already means one thing in this theme ("image goes here").
 *
 * The root class is `u-notice`, not `notice`, and the prefix is VESTIGIAL — it
 * pre-dates the convention `u-` now carries, and it is left alone rather than
 * renamed. The name was chosen to dodge the rollout's transitional sheet, which
 * carried a GLOBAL `.notice { color: #131a20 }` — a literal pinning ink to the
 * pale panel the unmigrated pages painted — that would otherwise have landed a
 * hard-coded near-black on this text under the dark palette. Increment 6 deleted
 * that sheet.
 *
 * It does NOT mean what `u-` means elsewhere. `.u-btn`, `.u-mono` and `.u-label`
 * are globals in tokens.css that any page may write on any element; this class
 * is Astro-SCOPED to this component, so a page writing `class="u-notice"` gets
 * nothing at all. Renaming it is a bigger change than it looks (the class is
 * pinned by `notice-qty.test.ts` and by the page sweep's "no legacy `.notice`"
 * rule), so the fix is to say so here and keep `u-` meaning one thing.
 *
 * Copy is the caller's: `src/lib/error-messages.ts` is already written from the
 * shopper's side and is quoted, not rewritten (§10).
 */
import type { HTMLAttributes } from "astro/types";
import { restProps } from "../lib/rest-props.js";

interface Props extends HTMLAttributes<"div"> {
	/** The sentence that leads — what happened. Set in the body face, bold. */
	lead?: string;
}

const { lead, class: className, ...rest } = Astro.props;
const hasLead = lead !== undefined && lead !== "";
---

<div class:list={["u-notice", className]} {...restProps(rest)}>
	<span class="mark" aria-hidden="true"></span>
	<p class="text">
		{hasLead && <b>{lead}</b>}
		{hasLead && " "}
		<slot />
	</p>
</div>

<style>
	.u-notice {
		display: flex;
		gap: 0.875rem;
		align-items: flex-start;
		padding: 0.875rem 1rem 0.875rem 0;
		border-top: 1px dashed var(--u-bronze);
		border-bottom: 1px dashed var(--u-bronze);
		background: transparent;
	}

	/* The broken rule, again. */
	.mark {
		flex: none;
		width: 2.5rem;
		height: 2px;
		margin-top: 0.5rem;
		background: repeating-linear-gradient(90deg, var(--u-bronze) 0 4px, transparent 4px 8px);
	}

	/* Full-contrast ink, not bronze: the message has to be READ. Bronze is the
	   signal, the text is the information. */
	.text {
		margin: 0;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--u-ink);
		max-width: 58ch;
	}

	.text b {
		font-weight: 600;
	}

	@media (max-width: 26rem) {
		.mark {
			width: 1.5rem;
		}
	}
</style>
