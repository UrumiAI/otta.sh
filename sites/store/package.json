{
	"name": "@urumi.ai/otta-store",
	"version": "0.2.0",
	"description": "The Otta storefront and admin as one Astro integration: EmDash on Cloudflare Workers with the Otta plugin registered trusted in-process. A site's whole config is otta({ template: 1 }).",
	"keywords": [
		"astro-integration",
		"cloudflare-workers",
		"emdash",
		"otta"
	],
	"homepage": "https://github.com/UrumiAI/otta.sh#readme",
	"bugs": {
		"url": "https://github.com/UrumiAI/otta.sh/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/UrumiAI/otta.sh.git",
		"directory": "sites/store"
	},
	"files": [
		"dist",
		"!dist/**/*.d.mts.map",
		"src",
		"public",
		"seed",
		"scripts",
		"emdash-env.d.ts"
	],
	"type": "module",
	"exports": {
		".": "./src/integration.ts",
		"./worker": "./src/worker.ts",
		"./playground-worker": "./src/playground-worker.ts",
		"./live-config": "./src/live.config.ts",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/integration.d.mts",
				"default": "./dist/integration.mjs"
			},
			"./worker": "./src/worker.ts",
			"./playground-worker": "./src/playground-worker.ts",
			"./live-config": "./src/live.config.ts",
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"prepack": "tsdown",
		"typecheck": "astro check"
	},
	"dependencies": {
		"kysely": "catalog:"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/cloudflare": "^14.1.2",
		"@astrojs/react": "^6.0.1",
		"@cloudflare/workers-types": "^5.20260708.1",
		"@emdash-cms/cloudflare": "1.3.1",
		"@types/better-sqlite3": "catalog:",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@urumi.ai/otta-admin-react": "workspace:*",
		"@urumi.ai/otta-domain": "workspace:*",
		"@urumi.ai/otta-plugin": "workspace:*",
		"astro": "^7.0.7",
		"better-sqlite3": "catalog:",
		"emdash": "1.3.1",
		"happy-dom": "^21.0.4",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	},
	"peerDependencies": {
		"@astrojs/cloudflare": "~14.1.2",
		"@astrojs/react": "~6.0.1",
		"@emdash-cms/cloudflare": "1.3.1",
		"@urumi.ai/otta-admin-react": "workspace:*",
		"@urumi.ai/otta-plugin": "workspace:*",
		"astro": "~7.3.6",
		"emdash": "1.3.1",
		"react": "~19.2.7",
		"react-dom": "~19.2.7"
	},
	"engines": {
		"node": ">=22.16"
	}
}
