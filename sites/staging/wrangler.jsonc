// Otta storefront Worker — TEMPLATE (plan D5). This tracked file carries
// PLACEHOLDER resource values: copy it to `wrangler.local.jsonc` (gitignored)
// — or edit this file in place — and fill in YOUR Worker name, D1 database
// name/id, and R2 buckets (see the root DEPLOYMENT.md §2.1 runbook).
// When `wrangler.local.jsonc` exists, astro.config.ts points the Cloudflare
// adapter at it (`configPath`) at BUILD time; plain `wrangler deploy` then
// deploys those values via the adapter-generated dist config — do NOT use
// `wrangler deploy --config wrangler.local.jsonc` (it bypasses the
// .wrangler/deploy redirect and tries to rebundle the raw worker source).
//
// Structure mirrors em-dash's templates/starter-cloudflare/wrangler.jsonc
// MINUS `worker_loaders`: the LOADER binding is consumed only by the plugin
// sandbox runner and flips the account onto Workers Paid; this deployment
// runs the Otta plugin trusted in-process instead (ADR-0006).
//
// Secrets are NEVER committed here. Post-merge:
//   npx emdash secrets generate && wrangler secret put EMDASH_ENCRYPTION_KEY
//
// OPTIONAL, for the Stripe webhook edge (`src/pages/webhooks/stripe.ts`):
//   wrangler secret put OTTA_WH_TOKEN
// A shared secret this Worker attaches as `X-Otta-Wh-Token` when it forwards a
// delivery to the plugin's `webhooks/stripe/settle` route. Set the SAME value
// in Otta's admin settings, where the plugin keeps its half as a write-only kv
// secret (`otta-wh-token`, under the plugin's own settings prefix — it is NOT
// provisioned here, and `test/site-config.test.ts` pins that it never is).
// Provisioning the PLUGIN side alone 401s every delivery. It is a
// `secret` and not a `vars` entry both because it is one and because
// `test/wrangler-config.test.ts` forbids any `vars` key matching
// /SECRET|KEY|TOKEN|PASSWORD/i. Leaving BOTH sides unset is a supported
// degraded state: the plugin's gate passes through, and the Stripe HMAC — the
// real trust anchor, never skippable — still rejects a forgery.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	// PLACEHOLDER — your Worker name (pick one that cannot collide with any
	// existing Worker on your account).
	"name": "my-otta-store",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	// NO `global_fetch_strictly_public` (issue #375; pinned ABSENT by
	// test/wrangler-config.test.ts). It was added for the site's ctx.http calls
	// to a commerce-service Worker on workers.dev, which Cloudflare otherwise
	// blocks and stubs 404; that service and the call are gone (ADR-0020). The
	// remaining egress (DEPLOYMENT.md §4) is api.stripe.com and the deployment's
	// x402 facilitator, none on workers.dev (email goes through EmDash's
	// ctx.email, ADR-0031). Without the flag, a fetch to a
	// hostname on THIS Worker's own zone goes to the zone's origin rather than
	// back through Cloudflare's front door — so do not point the facilitator URL at
	// this site's zone. Do not bring the flag back: D1 sessions are ON
	// (`session: "primary-first"` in src/emdash-options.ts), and the flag
	// hangs D1 session queries (emdash issue #1273: a ~5 s stall per new
	// isolate, then sessions off, and an in-flight write may be rejected) —
	// DEPLOYMENT.md §2.4. Pinned by test/site-config.test.ts, and astro.config.ts
	// refuses to build from a copy of this file (wrangler.local.jsonc) that
	// still lists it.
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			// PLACEHOLDERS — from `wrangler d1 create <name>` (DEPLOYMENT.md §2.1).
			// The id is a syntactically-valid dummy, not a real database.
			"database_name": "YOUR-D1-DATABASE-NAME",
			"database_id": "00000000-0000-0000-0000-000000000000",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			// PLACEHOLDER — from `wrangler r2 bucket create <name>`.
			"bucket_name": "your-media-bucket",
		},
		{
			// PRIVATE — paid digital downloads (issue #376). The site's download
			// endpoint (src/pages/orders/[orderId]/download/[sku].ts) is the ONLY
			// reader, and it re-checks the buyer's entitlement on every request.
			// MUST be a different bucket from MEDIA: EmDash serves every MEDIA key
			// publicly. The build refuses a config that shares them
			// (src/lib/downloads-bucket.ts). NEVER turn on r2.dev public access or
			// a custom domain for this bucket (DEPLOYMENT.md §2.1).
			"binding": "DOWNLOADS",
			// PLACEHOLDER — from `wrangler r2 bucket create <name>`.
			"bucket_name": "your-downloads-bucket",
		},
	],
	"observability": {
		"enabled": true,
	},
	// Drives scheduled publishing, plugin cron, and maintenance (src/worker.ts).
	// Every-minute matches EmDash's minute-granular scheduled publishing AND the
	// commerce sweep's own cadence (due every minute: hold expiry and the order
	// email outbox), and stays within D1's free limits (the sweep budgets itself to
	// Workers Free's 50 queries per invocation — DEPLOYMENT.md §5). Do not relax it:
	// a slower trigger directly lengthens how long an expired hold keeps stock off
	// sale and how long a queued order email waits.
	"triggers": {
		"crons": ["* * * * *"],
	},
}
