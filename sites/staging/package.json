{
	"name": "@urumi.ai/otta-site-staging",
	"version": "0.0.0",
	"private": true,
	"description": "Otta staging storefront + admin — the reference site: @urumi.ai/otta-store's otta() integration on Cloudflare Workers, plus the e2e suite and the playground config (ADR-0045).",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"dev:playground": "astro dev --config astro.config.playground.ts",
		"build": "astro build",
		"build:playground": "astro build --config astro.config.playground.ts",
		"preview": "astro preview",
		"typecheck": "astro check",
		"deploy": "wrangler deploy"
	},
	"dependencies": {
		"@astrojs/cloudflare": "~14.1.2",
		"@astrojs/react": "~6.0.1",
		"@emdash-cms/cloudflare": "1.3.1",
		"@urumi.ai/otta-admin-react": "workspace:*",
		"@urumi.ai/otta-plugin": "workspace:*",
		"@urumi.ai/otta-store": "workspace:*",
		"astro": "~7.3.6",
		"emdash": "1.3.1",
		"react": "~19.2.7",
		"react-dom": "~19.2.7"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@cloudflare/workers-types": "^5.20260708.1",
		"@types/better-sqlite3": "catalog:",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@urumi.ai/otta-domain": "workspace:*",
		"@urumi.ai/otta-payments-stripe": "workspace:*",
		"better-sqlite3": "catalog:",
		"happy-dom": "^21.0.4",
		"kysely": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	},
	"engines": {
		"node": ">=22.16"
	},
	"emdash": {
		"seed": "node_modules/@urumi.ai/otta-store/seed/seed.json"
	}
}
