{
	"name": "@otta-sh/site-staging",
	"version": "0.0.0",
	"private": true,
	"description": "Otta staging storefront + admin — EmDash with the Otta plugin registered trusted in-process (ADR-0004), on Cloudflare Workers or in a Node container (OTTA_SITE_TARGET).",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro check && astro build",
		"build:node": "OTTA_SITE_TARGET=node astro build",
		"preview": "astro preview",
		"start": "node ./server/cluster.mjs",
		"typecheck": "astro check",
		"deploy": "wrangler deploy"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.1.2",
		"@astrojs/node": "^11.0.0",
		"@astrojs/react": "^6.0.1",
		"@aws-sdk/client-s3": "^3.1097.0",
		"@aws-sdk/s3-request-presigner": "^3.1097.0",
		"@emdash-cms/cloudflare": "0.31.1",
		"@otta-sh/admin-react": "workspace:*",
		"@otta-sh/plugin": "workspace:*",
		"astro": "^7.0.7",
		"emdash": "0.31.1",
		"pg": "catalog:",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@cloudflare/workers-types": "^5.20260708.1",
		"@otta-sh/payments-stripe": "workspace:*",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	},
	"emdash": {
		"seed": "seed/seed.json"
	}
}
