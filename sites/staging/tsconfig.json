{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"types": ["node"]
	},
	"include": [
		"src",
		"test",
		// The Playwright harness. Also covered by the root `tsconfig.e2e.json`
		// (which is what `pnpm typecheck` runs); listed here so `astro check`
		// sees it too and it cannot rot in either direction.
		"e2e",
		"scripts",
		".astro/types.d.ts",
		"emdash-env.d.ts",
		"astro.config.ts",
		"vitest.config.ts"
	],
	"exclude": ["dist", ".wrangler", "node_modules"]
}
