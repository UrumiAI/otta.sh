---
/**
 * Where the shopper is in checkout, in Counter's voice: four quiet words in a
 * row, the done ones with a small check, the current one in ink at weight 600.
 * The steps and their order are the shared `CHECKOUT_STEPS` (the same list
 * Tempered's track draws), so no theme can invent a step. A real ordered list,
 * with `aria-current="step"` on the one you are on.
 */
import { CHECKOUT_STEPS, type CheckoutStep } from "../../components/StepTrack.astro";

interface Props {
	current: CheckoutStep;
}

const { current } = Astro.props;
const currentIndex = CHECKOUT_STEPS.findIndex((step) => step.id === current);
---

<ol class="c-steps" aria-label="Checkout progress">
	{
		CHECKOUT_STEPS.map((step, index) => (
			<li
				class="c-step"
				data-done={index < currentIndex ? "" : undefined}
				aria-current={index === currentIndex ? "step" : undefined}
			>
				{index < currentIndex && (
					<svg class="c-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<path d="M5 12.5l4.5 4.5L19 7.5" />
					</svg>
				)}
				{step.label}
			</li>
		))
	}
</ol>
