---
/**
 * Counter's signature: the bag drawer (brief "CART DRAWER" and "Motion").
 *
 * NO CLIENT JAVASCRIPT — it is the native Popover API. The header's bag button
 * carries `popovertarget="bag"`; this element is `popover` (auto), so the
 * browser opens and closes it, draws the scrim (`::backdrop`), closes it on Esc
 * and on a click outside, puts it in the top layer, moves focus to the close
 * button (`autofocus`, the first thing in it you can focus) and hands focus
 * back to the bag button on close. The slide is CSS (`:popover-open`,
 * `@starting-style`, `transition-behavior: allow-discrete`) in `commerce.css`.
 * Where the Popover API does not exist the header shows a plain link to `/cart`
 * instead (see the Layout), and this element is never displayed.
 *
 * The quantity steppers and "Remove" are the SAME plain forms `/cart` uses —
 * the same endpoints and the same hidden fields (`forms/CartLineFields.astro`),
 * so a change lands on `/cart`, where it is visible (no JS reopens a drawer
 * after the redirect, so landing back here would show it only as the badge).
 * A stepper is two submit buttons that each post the quantity they name; the
 * minus is disabled at 1 (a quantity of 0 is a removal, which is "Remove").
 *
 * Holds are STATIC wall-clock copy ("Held for you until 2:10 pm UTC"): there is
 * no countdown script outside `/cart`. Everything printed was decided by
 * `lib/bag.ts`; a bag it could not read offers the way to `/cart` instead.
 */
import CartLineFields from "../../forms/CartLineFields.astro";
import { isUnpricedText } from "../../lib/totals.js";
import type { BagModel } from "../contract.js";
import Art from "./Art.astro";
import Price from "./Price.astro";

interface Props {
	bag: BagModel;
	/** Where "View bag" goes — the menu's cart link. */
	bagHref: string;
}

const { bag, bagHref } = Astro.props;
const count = bag.count ?? 0;
---

<div popover id="bag" class="c-drawer" role="dialog" aria-labelledby="bag-title">
	<div class="c-drawer-head">
		<h2 class="c-drawer-title" id="bag-title">
			Your bag{count > 0 && <span class="c-drawer-count"> ({count})</span>}
		</h2>
		<button
			type="button"
			class="c-drawer-x"
			popovertarget="bag"
			popovertargetaction="hide"
			autofocus
			aria-label="Close bag"
		>
			<svg class="c-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
				<path d="M6 6l12 12M18 6L6 18" />
			</svg>
		</button>
	</div>

	{
		bag.state === "lines" ? (
			<>
				<ul class="c-drawer-lines" role="list">
					{bag.lines.map((line, index) => (
						<li class="c-bl" role="listitem" style={`--i: ${Math.min(index, 6)}`}>
							<div class="c-bl-thumb">
								<Art seed={line.artKey} title={line.name} image={line.image} />
							</div>
							<div class="c-bl-info">
								<p class="c-bl-name">{line.title ?? line.sku}</p>
								{line.title !== null && <p class="c-bl-sku">{line.sku}</p>}
								<div class="c-bl-ctl">
									<form
										method="POST"
										action="/cart/update"
										class="c-stepper"
										id={`bag-update-${line.lineId}`}
									>
										<CartLineFields
											lineId={line.lineId}
											idempotencyKey={line.updateKey}
										/>
										<button
											type="submit"
											name="qty"
											value={line.qty - 1}
											disabled={line.qty <= 1}
											aria-label={`Decrease quantity, ${line.name}`}
										>
											<svg class="c-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
												<path d="M6 12h12" />
											</svg>
										</button>
										<span class="c-stepper-n">
											<span class="u-sr-only">Quantity </span>
											{line.qty}
										</span>
										<button
											type="submit"
											name="qty"
											value={line.qty + 1}
											aria-label={`Increase quantity, ${line.name}`}
										>
											<svg class="c-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
												<path d="M6 12h12M12 6v12" />
											</svg>
										</button>
									</form>
									<form method="POST" action="/cart/remove">
										<CartLineFields
											lineId={line.lineId}
											idempotencyKey={line.removeKey}
										/>
										<button type="submit" class="c-textbtn">
											Remove<span class="u-sr-only"> {line.name}</span>
										</button>
									</form>
								</div>
								{line.hold !== null && (
									<p class="c-bl-hold" data-state={line.hold.state}>
										<svg class="c-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
											<circle cx="12" cy="12" r="8" />
											<path d="M12 8v4l2.5 2" />
										</svg>
										<span>
											{line.hold.text}
											{line.hold.state === "released" && (
												<>
													{". "}
													<button
														type="submit"
														form={`bag-update-${line.lineId}`}
														name="qty"
														value={line.qty}
														class="c-textbtn c-textbtn-brand"
													>
														Hold it again<span class="u-sr-only">, {line.name}</span>
													</button>
												</>
											)}
										</span>
									</p>
								)}
							</div>
							<p class="c-bl-money">
								{isUnpricedText(line.money) ? (
									<span class="c-bl-prose">{line.money}</span>
								) : (
									<Price formatted={line.money} />
								)}
							</p>
						</li>
					))}
				</ul>
				<div class="c-drawer-foot">
					<p class="c-sub">
						<span>Subtotal</span>
						{bag.subtotal === null || isUnpricedText(bag.subtotal) ? (
							<span class="c-sub-prose">{bag.subtotal ?? "Confirmed at checkout"}</span>
						) : (
							<Price formatted={bag.subtotal} />
						)}
					</p>
					{bag.partial && (
						<p class="c-sub-note">Some items are priced at checkout, so this isn't complete yet.</p>
					)}
					<p class="c-sub-note">Shipping and tax are calculated at checkout.</p>
					<a class="u-btn c-drawer-go" href="/checkout">
						Check out
					</a>
					<div class="c-drawer-more">
						<a class="c-quiet" href={bagHref}>
							View bag
						</a>
						<button type="button" class="c-quiet" popovertarget="bag" popovertargetaction="hide">
							Continue shopping
						</button>
					</div>
				</div>
			</>
		) : (
			<div class="c-drawer-state">
				{bag.state === "empty" ? (
					<>
						<p class="c-drawer-state-lead">Your bag is empty.</p>
						<p>Add something you like and we'll hold it for you while you decide.</p>
						<a class="u-btn c-drawer-go" href="/products">
							Browse products
						</a>
					</>
				) : bag.state === "checkedOut" ? (
					<>
						<p class="c-drawer-state-lead">This bag has been checked out.</p>
						<p>Its items are part of an order now. Your bag page shows where it stands.</p>
						<a class="u-btn u-btn-ghost c-drawer-go" href={bagHref}>
							View bag
						</a>
					</>
				) : (
					<>
						<p class="c-drawer-state-lead">We couldn't load your bag just now.</p>
						<p>Open your bag page to try again.</p>
						<a class="u-btn u-btn-ghost c-drawer-go" href={bagHref}>
							View bag
						</a>
					</>
				)}
			</div>
		)
	}
</div>
