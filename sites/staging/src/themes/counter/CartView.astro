---
/**
 * Counter's bag page (brief "CART DRAWER", laid out as a page): the lines on
 * the left — picture, name, SKU, the hold as a clock and a sentence, and the
 * quantity controls — and a quiet summary panel on the right with the subtotal,
 * the shipping-and-tax line and the one brand action, "Check out". On a phone
 * the panel follows the lines.
 *
 * `/cart` is the full-page fallback for the drawer (`BagDrawer.astro`) and the
 * one page that COUNTS DOWN: each line's hold is `HoldRibbon.astro` — markup
 * hooks only — and `components/HoldClock.astro`, which the PAGE renders, ticks
 * them. No script lives in a view (ADR-0012; see `themes/contract.ts`).
 *
 * Presentation only: `src/pages/cart/index.astro` decides every arm (empty /
 * degraded / terminal / live), mints the per-form keys, and composes every
 * money string. The arms are written in the page's order — empty, terminal,
 * live — and a degraded read is never drawn as an empty bag.
 */
import {
	CART_CHECKED_OUT_BODY,
	CART_CHECKED_OUT_TITLE,
	CART_NEW_CART_CONSEQUENCE,
	CART_NO_ORDER_LINK,
	CART_RESUME_PURPOSE,
} from "../../lib/cart-view.js";
import { isUncalculated, isUnpricedText, sumRowText } from "../../lib/totals.js";
import type { CartModel } from "../contract.js";
import Art from "./Art.astro";
import HoldRibbon from "./HoldRibbon.astro";
import Notice from "./Notice.astro";
import Price from "./Price.astro";
import QtyInput from "./QtyInput.astro";

interface Props {
	model: CartModel;
}

const {
	summary,
	errorMessage,
	degraded,
	degradedLead,
	pricingNotice,
	empty,
	terminal,
	placedOrderId,
	lineViews,
	sumRows,
	partialNote,
} = Astro.props.model;

/* The subtotal leads the panel. Any further row that carries a FIGURE is drawn
   under it; a prose row ("Shipping: At checkout") is already said, in full, by
   the panel's shipping-and-tax sentence, so it is not said twice. */
const [lead, ...others] = sumRows;
const figureRows = others.filter((row) => !isUncalculated(row.amount));
---

<header class="c-bar c-bar-top">
	<h1 class="c-h1">Your bag</h1>
	{summary !== null && <p class="c-bar-meta">{summary}</p>}
</header>

{
	errorMessage !== null && (
		<div class="c-notice-slot">
			<Notice tone="error">{errorMessage}</Notice>
		</div>
	)
}
{
	degraded && (
		<div class="c-notice-slot">
			<Notice lead={degradedLead}>We haven't changed anything — try again in a moment.</Notice>
		</div>
	)
}
{
	pricingNotice && (
		<div class="c-notice-slot">
			<Notice lead="Totals are unavailable right now.">
				Your quantities and your holds are still exact.
			</Notice>
		</div>
	)
}

{
	empty ? (
		!degraded && (
			<div class="c-empty c-cart-empty">
				<h2 class="c-h2">Your bag is empty.</h2>
				<p class="c-empty-copy">
					Pick something you like and we'll hold it for you while you decide.
				</p>
				<div class="c-acts">
					<a href="/products" class="u-btn">
						Browse products
					</a>
				</div>
			</div>
		)
	) : terminal ? (
		<div class="c-cart-terminal">
			<h2 class="c-h2">{CART_CHECKED_OUT_TITLE}</h2>
			<p class="c-cart-terminal-body">{CART_CHECKED_OUT_BODY}</p>

			<ul class="c-cart-terminal-lines" role="list">
				{lineViews.map((view) => (
					<li class="c-cart-terminal-line" role="listitem">
						<span class="c-cart-terminal-id">
							{view.title !== null && <span class="c-cart-terminal-name">{view.title}</span>}
							<span class="c-cart-terminal-sku">{view.line.sku}</span>
						</span>
						<span class="c-cart-terminal-qty">Qty {view.line.qty}</span>
					</li>
				))}
			</ul>

			<div class="c-cart-terminal-actions">
				{placedOrderId !== null && (
					<a href={`/orders/${encodeURIComponent(placedOrderId)}`} class="u-btn">View your order</a>
				)}

				{placedOrderId === null && (
					<div class="c-cart-terminal-resume">
						<a href="/checkout" class="u-btn">Return to this checkout</a>
						<p class="c-cart-terminal-note">{CART_RESUME_PURPOSE}</p>
						<p class="c-cart-terminal-note">{CART_NO_ORDER_LINK}</p>
					</div>
				)}

				<div class="c-cart-terminal-restart">
					<form method="POST" action="/checkout/new-cart">
						<button type="submit" class="u-btn u-btn-ghost">Start a new cart</button>
					</form>
					<p class="c-cart-terminal-note">{CART_NEW_CART_CONSEQUENCE}</p>
				</div>
			</div>
		</div>
	) : (
		<div class="c-cart">
			<ul class="c-cart-lines" role="list">
				{lineViews.map((view) => (
					<li class="c-cart-line" role="listitem">
						<div class="c-cart-thumb">
							<Art seed={view.artKey} title={view.name} image={view.image} />
						</div>
						<div class="c-cart-info">
							<p class="c-cart-name">{view.title ?? view.line.sku}</p>
							{view.title !== null && <p class="c-cart-sku">{view.line.sku}</p>}
							<HoldRibbon expiresAt={view.line.expiresAt} />
							<div class="c-cart-ctl">
								<form method="POST" action="/cart/update" class="c-cart-update">
									<input type="hidden" name="lineId" value={view.line.lineId} />
									<input type="hidden" name="idempotencyKey" value={view.updateKey} />
									<QtyInput value={view.line.qty} label={`Quantity, ${view.name}`} />
									<button type="submit" class="c-textbtn">
										Update<span class="u-sr-only"> {view.name}</span>
									</button>
								</form>
								<form method="POST" action="/cart/remove">
									<input type="hidden" name="lineId" value={view.line.lineId} />
									<input type="hidden" name="idempotencyKey" value={view.removeKey} />
									<button type="submit" class="c-textbtn">
										Remove<span class="u-sr-only"> {view.name}</span>
									</button>
								</form>
							</div>
						</div>
						<div class="c-cart-money">
							{isUnpricedText(view.money) ? (
								<span class="c-cart-prose">{view.money}</span>
							) : (
								<Price formatted={view.money} />
							)}
							{view.each !== null && <span class="c-cart-each">{view.each}</span>}
						</div>
					</li>
				))}
			</ul>

			<aside class="c-cart-summary" aria-labelledby="c-cart-summary-title">
				<h2 class="c-cart-summary-title" id="c-cart-summary-title">
					Summary
				</h2>
				{lead !== undefined && (
					<p class="c-sub">
						<span>{lead.label}</span>
						{isUncalculated(lead.amount) ? (
							<span class="c-sub-prose">{sumRowText(lead)}</span>
						) : (
							<Price formatted={sumRowText(lead)} />
						)}
					</p>
				)}
				{figureRows.map((row) => (
					<p class="c-sub c-sub-minor">
						<span>{row.label}</span>
						<Price formatted={sumRowText(row)} />
					</p>
				))}
				{partialNote !== null && <p class="c-sub-note">{partialNote}</p>}
				<p class="c-sub-note">Shipping and tax are calculated at checkout.</p>
				<a href="/checkout" class="u-btn c-cart-go">
					Check out
				</a>
				<p class="c-sub-fine">
					Prices are live and may change; your total is confirmed at checkout.
				</p>
			</aside>
		</div>
	)
}
