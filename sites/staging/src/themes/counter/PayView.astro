---
/**
 * Counter's pay step — the FRAME around the card fields: the step track, a
 * single calm column, one sentence about where the card details go, and the way
 * back to the order.
 *
 * WHAT IS NOT HERE, AND MUST NOT BE. The Stripe mount, the pay button, the
 * `<noscript>` explanation and Stripe's script are `src/pages/checkout/pay.astro`'s
 * — the one page ADR-0012 lets carry client JavaScript and a third-party origin
 * — and arrive as the `payment` slot, rendered exactly once, and only when the
 * page says payment is configured. The pay button is the page's `.u-btn`, so
 * it wears Counter's brand fill like every other action.
 */
import type { PayModel } from "../contract.js";
import Notice from "./Notice.astro";
import StepTrack from "./StepTrack.astro";

interface Props {
	model: PayModel;
}

const { paymentConfigured, notConfiguredLead, orderPath } = Astro.props.model;
---

<div class="c-pay">
	<div class="c-co-steps"><StepTrack current="payment" /></div>
	<h1 class="c-co-title">Payment</h1>

	{
		!paymentConfigured ? (
			<Notice lead={notConfiguredLead}>
				This order can't be paid. No charge has been made. <a href={orderPath}>View your order</a>.
			</Notice>
		) : (
			<div class="c-pay-panel">
				<p class="c-pay-trust">
					<svg class="c-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<rect x="5" y="10.5" width="14" height="9.5" rx="2.5" />
						<path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5" />
					</svg>
					<span>
						Your card details are handled directly by our payment provider and never reach this
						site.
					</span>
				</p>

				<slot name="payment" />
			</div>
		)
	}

	<p class="c-co-back"><a class="c-link" href={orderPath}>View your order</a></p>
</div>
