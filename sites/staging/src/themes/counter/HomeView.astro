---
/**
 * Counter's home (brief "Layout (b)"): a 5fr / 7fr hero — the store's own
 * thesis, left-aligned, beside a picture — and then the shelf itself as a grid.
 *
 * THE PICTURE is the catalog's first photograph when it has one (real content
 * first), and otherwise the approved still life of generated everyday objects.
 * It is decorative either way: the thesis is the hero's content, so the image
 * carries empty alt text.
 *
 * Presentation only: `src/pages/index.astro` makes the reads and computes the
 * model. The DEGRADED RULE rides the model — when a read failed the page hands
 * over no cards (and no rows), and the hero renders alone rather than with an
 * error box: a shopper who has not asked for a price does not need to be told
 * the shop is having a moment.
 *
 * THE SHELF is at most eight cards (two rows of the 4-up grid); "See
 * everything" is the way to the rest.
 *
 * Styles: `views.css` (`c-hero`, `c-shelf`, `c-grid`), linked by the Layout.
 */
import type { HomeModel } from "../contract.js";
import { heroScene } from "./art.js";
import Card from "./Card.astro";

interface Props {
	model: HomeModel;
}

const { model } = Astro.props;
const leadImage = model.cards.find((card) => card.image !== null)?.image ?? null;
const shelf = model.cards.slice(0, 8);
---

<section class="c-hero">
	<div class="c-hero-txt">
		<h1 class="c-hero-title">{model.thesis}</h1>
		<p class="c-hero-lede">{model.lede}</p>
		<div class="c-acts">
			<a class="u-btn" href={model.shopHref}>{model.shopLabel}</a>
		</div>
	</div>
	<div class="c-hero-media">
		{
			leadImage !== null ? (
				<img src={leadImage} alt="" decoding="async" fetchpriority="high" />
			) : (
				<Fragment set:html={heroScene()} />
			)
		}
	</div>
</section>

{
	shelf.length > 0 && (
		<section class="c-shelf" aria-labelledby="c-shelf-title">
			<div class="c-bar">
				<h2 id="c-shelf-title" class="c-h2">
					In the shop
				</h2>
				<a class="c-link" href={model.shopHref}>
					See everything
				</a>
			</div>
			<div class="c-grid">
				{shelf.map((card) => (
					<Card card={card} />
				))}
			</div>
		</section>
	)
}
