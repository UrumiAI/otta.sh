---
/**
 * A price in Counter's voice: the figure at the surrounding weight, the
 * currency sign one step smaller and lighter (brief "Personality move"). The
 * string arrives pre-formatted; `priceParts` only splits it (see money.ts).
 */
import { priceParts } from "./money.js";

interface Props {
	formatted: string;
	/** Struck through and muted — not in stock. */
	struck?: boolean;
	class?: string;
}

const { formatted, struck = false, class: className } = Astro.props;
const { lead, figure, trail } = priceParts(formatted);
const Tag = struck ? "s" : "span";
---

{/* One line on purpose: whitespace between the parts would render as a gap
    between the sign and the figure. */}
<Tag class:list={["c-price", className]}>{lead !== "" && <span class="c-cur">{lead}</span>}{figure}{trail !== "" && <span class="c-cur">{trail}</span>}</Tag>
