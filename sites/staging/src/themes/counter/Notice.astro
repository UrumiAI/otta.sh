---
/**
 * Counter's notice: a surface panel with a small icon, the lead in ink and the
 * rest in muted ink. The ochre is the ICON's, never the panel's — a notice is
 * information, and the brief keeps colour for states and actions, not surfaces.
 * `tone="error"` swaps the icon to the error colour and makes it an alert.
 */
interface Props {
	lead?: string | null;
	tone?: "info" | "error";
}

const { lead = null, tone = "info" } = Astro.props;
---

<div class="c-notice" data-tone={tone} role={tone === "error" ? "alert" : "status"}>
	<svg class="c-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
		<circle cx="12" cy="12" r="8.5"></circle>
		<path d="M12 7.5v5.5"></path>
		<path d="M12 16.2v.3"></path>
	</svg>
	<p>
		{lead !== null && <><strong>{lead}</strong>{" "}</>}
		<slot />
	</p>
</div>
