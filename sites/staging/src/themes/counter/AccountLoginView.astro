---
/**
 * Counter's sign-in (issue #306, ADR-0004): one email field, magic link only,
 * in a narrow left-aligned column. Presentation only —
 * `src/pages/account/login/index.astro` sets the no-store header, reads `?sent`
 * / `?error`, and hands over the copy. The `sent` notice is the SAME sentence
 * for every address, so the page is not an account oracle; a theme may restyle
 * it and must not vary it.
 */
import type { AccountLoginModel } from "../contract.js";
import Notice from "./Notice.astro";

interface Props {
	model: AccountLoginModel;
}

const { sent, sentCopy, errorMessage } = Astro.props.model;
---

<div class="c-acct">
	<h1 class="c-h1">Sign in</h1>
	<p class="c-acct-lede">
		We'll email you a link that signs you in — no password. Orders you placed as a guest with the
		same address appear in your account once you sign in.
	</p>

	{
		sent && (
			<div class="c-notice-slot">
				<Notice lead="Check your inbox.">{sentCopy}</Notice>
			</div>
		)
	}
	{
		errorMessage !== null && (
			<div class="c-notice-slot">
				<Notice tone="error">{errorMessage}</Notice>
			</div>
		)
	}

	<form method="POST" action="/account/login/request" class="c-acct-form">
		<div class="c-co-field">
			<label class="c-label" for="email">Email</label>
			<input type="email" id="email" name="email" required autocomplete="email" />
		</div>
		<button type="submit" class="u-btn c-co-go">Email me a sign-in link</button>
	</form>
</div>
