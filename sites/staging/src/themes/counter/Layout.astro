---
/**
 * Counter's Layout — the document shell and the chrome (theme-briefs.md §5,
 * "Layout (a)"): a 68px sticky header with one line below it — wordmark, the
 * primary menu, and the bag on the right carrying its count in the brand
 * colour — and a surface-band footer.
 *
 * PRESENTATION ONLY. Everything arrives on `chrome`, built by
 * `src/layouts/Storefront.astro` (the guarded CMS reads, their fallbacks, the
 * Account link, the cart count and its spoken label, the currency). The menu is
 * the operator's, so it is printed as given; the one item flagged `isCart` is
 * drawn as the bag.
 *
 * The brief's header search and footer newsletter are NOT drawn: this store has
 * neither a search nor a mailing list behind them, and a field that goes
 * nowhere is worse than no field.
 *
 * THE BAG. Counter opts into the chrome's cart-lines read
 * (`ThemeModule.chrome.cartLines`), so on the pages that draw it `chrome.bag`
 * carries the lines and the header's bag opens Counter's drawer
 * (`BagDrawer.astro`) — the native Popover API, no script. PROGRESSIVE: the bag
 * is drawn TWICE, as a plain `<a href="/cart">` and as the popover's
 * `<button popovertarget>`, and `commerce.css` shows the button only inside
 * `@supports selector(:popover-open)` — true exactly where the Popover API
 * exists. Anywhere else (an old browser, or no CSS at all) the link is what a
 * shopper gets, and `/cart` is the full-page bag. On a page with no `bag` (the
 * checkout flow) the link alone is drawn.
 *
 * THE DRAWER IS NON-MODAL, knowingly. A popover is not a modal dialog: there
 * is no focus trap, and the page behind it stays in the tab order (Tab past the
 * drawer's last control reaches the page; Esc and a click outside close it, and
 * focus returns to the bag button). A trap needs `<dialog>.showModal()`, which
 * needs script, and this theme ships none. The page behind is kept from
 * scrolling while it is open (`html:has(#bag:popover-open)` in `commerce.css`).
 * The future path is a `<dialog>` opened by invoker commands
 * (`commandfor`/`command="show-modal"`) once browsers ship them widely: modal,
 * trapped, and still script-free.
 *
 * STYLES are linked through `?url` (the registry imports every theme, so a
 * theme `.astro` file carries no `<style>`): `theme.css` is the tokens, the
 * shared recipes and all of the theme's motion; `views.css` is the chrome and
 * the three catalog views; `commerce.css` the bag drawer and the commerce
 * views. The face is Rethink Sans, self-hosted through Astro's font API under
 * `--f-counter-sans` (astro.config.ts).
 */
import { Font } from "astro:assets";
import type { ChromeModel } from "../contract.js";
import BagDrawer from "./BagDrawer.astro";
import BagMark from "./BagMark.astro";
import commerceHref from "./commerce.css?url";
import themeHref from "./theme.css?url";
import viewsHref from "./views.css?url";

interface Props {
	chrome: ChromeModel;
}

const { chrome } = Astro.props;
const menu = chrome.navItems.filter((item) => !item.isCart);
const bag = chrome.navItems.find((item) => item.isCart) ?? null;
---

<!doctype html>
<html lang="en" data-theme-id={chrome.themeId}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="light dark" />
		<title>{chrome.fullTitle}</title>
		{chrome.description && <meta name="description" content={chrome.description} />}
		<Font cssVariable="--f-counter-sans" preload />
		<link rel="stylesheet" href={themeHref} />
		<link rel="stylesheet" href={viewsHref} />
		<link rel="stylesheet" href={commerceHref} />
		<slot name="head" />
		{/* A shopping bag on the brand teal — the one action colour, the one
		    object the chrome is organised around. Inline, so no second request. */}
		<link
			rel="icon"
			type="image/svg+xml"
			href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%230E6B64'/%3E%3Cpath d='M9 12h14l-1.2 12.2H10.2z' fill='none' stroke='%23fff' stroke-width='2' stroke-linejoin='round'/%3E%3Cpath d='M12.5 12v-1.5a3.5 3.5 0 0 1 7 0V12' fill='none' stroke='%23fff' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E"
		/>
	</head>
	<body>
		<div class="c-skip-shell">
			<a href="#main" class="c-skip-link">Skip to the main content</a>
		</div>
		<header class="c-head">
			<div class="c-shell c-head-row">
				<a href="/" class="c-word">{chrome.siteTitle}</a>
				{
					menu.length > 0 && (
						<nav class="c-nav" aria-label="Primary">
							{menu.map((item) => (
								<a href={item.url}>{item.label}</a>
							))}
						</nav>
					)
				}
				{
					bag !== null && (
						<Fragment>
							<a class="c-bag c-bag-link" href={bag.url}>
								<BagMark label={bag.label} count={chrome.cartCount} countLabel={chrome.cartCountLabel} />
							</a>
							{chrome.bag !== null && (
								<button type="button" class="c-bag c-bag-open" popovertarget="bag">
									<BagMark
										label={bag.label}
										count={chrome.cartCount}
										countLabel={chrome.cartCountLabel}
									/>
								</button>
							)}
						</Fragment>
					)
				}
			</div>
		</header>
		{bag !== null && chrome.bag !== null && <BagDrawer bag={chrome.bag} bagHref={bag.url} />}
		<main id="main" class="c-shell c-main">
			<slot />
		</main>
		<footer class="c-foot">
			<div class="c-shell c-foot-grid">
				<div class="c-foot-about">
					<p class="c-foot-word">{chrome.siteTitle}</p>
					<p>Content by EmDash, commerce by Otta.</p>
				</div>
				{
					chrome.navItems.length > 0 && (
						<nav class="c-foot-nav" aria-label="Footer">
							{chrome.navItems.map((item) => (
								<a href={item.url}>{item.label}</a>
							))}
						</nav>
					)
				}
				{
					chrome.currency !== null && (
						<p class="c-foot-currency">
							Prices in <span class="u-mono">{chrome.currency}</span>
						</p>
					)
				}
			</div>
		</footer>
	</body>
</html>
