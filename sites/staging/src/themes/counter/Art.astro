---
/**
 * The product's picture: its own image when it has one, otherwise Counter's
 * generated everyday object on a seeded tint (art.ts). The markup `art.ts`
 * returns carries no caller string — see the note there — so `set:html` is safe.
 */
import { productArt } from "./art.js";

interface Props {
	/** The product's slug or id — seeds the object, its colour and the tint. */
	seed: string;
	/** Picks the object ("… mug" → a mug); never rendered. */
	title: string;
	image: string | null;
	/** Empty on a card, whose title is already the link's text. */
	alt?: string;
	/** Eager for the PDP's hero image, lazy everywhere else. */
	eager?: boolean;
}

const { seed, title, image, alt = "", eager = false } = Astro.props;
---

{
	image !== null ? (
		<img
			src={image}
			alt={alt}
			loading={eager ? "eager" : "lazy"}
			decoding="async"
			fetchpriority={eager ? "high" : undefined}
		/>
	) : (
		<Fragment set:html={productArt(seed, title)} />
	)
}
