---
/**
 * A quantity field in Counter's controls voice (radius 10, 1px line, the one
 * place lines are allowed). The label is a real `<label>` around the input,
 * visually hidden in a cart row — name the product in it ("Quantity, Mug") so
 * the fields on a page are distinguishable. Posts as `qty`, which is what
 * `/cart/update` reads.
 */
interface Props {
	value: number;
	label: string;
}

const { value, label } = Astro.props;
---

<label class="c-qtyin">
	<span class="u-sr-only">{label}</span>
	<input type="number" name="qty" value={value} min="1" inputmode="numeric" required />
</label>
