---
/**
 * Counter's totals block — the same honesty contract as the shared `Sum`
 * (docs/theme/TEMPERED.md §7), in Counter's voice: label left, value right, a
 * row with no figure set as quieter prose so it can never be read as an amount,
 * and the total at the title's weight with the small currency sign.
 *
 * Nothing money-shaped is built here: a row prints `sumRowText` (which never
 * lets a bare dash through), the total prints the view model's own label, and
 * the footnote is the page's or `uncalculatedFootnote`'s.
 */
import type { CheckoutAmountView } from "@otta-sh/plugin";
import { isUncalculated, sumRowText, uncalculatedFootnote, type SumRow } from "../../lib/totals.js";
import Price from "./Price.astro";

interface Props {
	rows: SumRow[];
	total: CheckoutAmountView;
	totalLabel?: string;
	excludesUncalculated?: boolean;
	/** `null` suppresses the footnote; omitted derives it. */
	footnote?: string | null;
}

const { rows, total, totalLabel = "Total", excludesUncalculated = false, footnote } = Astro.props;
const note = footnote !== undefined ? footnote : uncalculatedFootnote(rows, excludesUncalculated);
---

<dl class="c-totals">
	{
		rows.map((row) => (
			<div class="c-totals-row" data-prose={isUncalculated(row.amount) ? "" : undefined}>
				<dt>{row.label}</dt>
				<dd>
					{isUncalculated(row.amount) ? sumRowText(row) : <Price formatted={sumRowText(row)} />}
				</dd>
			</div>
		))
	}
	<div class="c-totals-row c-totals-grand" data-prose={isUncalculated(total) ? "" : undefined}>
		<dt>{totalLabel}</dt>
		<dd>{isUncalculated(total) ? total.label : <Price formatted={total.label} />}</dd>
	</div>
</dl>
{note !== null && <p class="c-totals-note">{note}</p>}
