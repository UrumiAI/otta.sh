---
/**
 * Plinth's shop: "All objects" at 22px, the exact count beside it in muted
 * ink when the page can prove one, then a 3-up grid of 4:5 stone fields with
 * 48px gutters. No card borders, no dividers — tone and air are the only
 * containers.
 *
 * Presentation only: `src/pages/products/index.astro` decides the state
 * (unavailable / empty / list), chooses the degraded notice's lead (BUSY copy
 * included) and maps every card.
 */
import type { ShopModel } from "../contract.js";
import Card from "./Card.astro";
import { firstOfEachKey } from "./continuity.js";

interface Props {
	model: ShopModel;
}

const { model } = Astro.props;
/* One set of view-transition names per product per page (continuity.ts). */
const named = firstOfEachKey(model.cards.map((card) => card.slug));
---

{
	model.degradedNotice !== null && (
		<div class="pl-notice pl-notice-shop" role="status">
			<p class="pl-notice-lead">{model.degradedNotice.lead}</p>
			<p>The catalog below is complete — check back in a moment for live figures.</p>
		</div>
	)
}

{
	model.state === "unavailable" ? (
		<div class="pl-empty">
			<h1 class="pl-h">Shop</h1>
			<div class="pl-notice" role="status">
				<p class="pl-notice-lead">The catalog is unavailable right now.</p>
				<p>Try again in a moment.</p>
			</div>
		</div>
	) : model.state === "empty" ? (
		<div class="pl-empty">
			<h1 class="pl-h">No products yet.</h1>
			<p class="pl-empty-copy">
				Create a product in the admin, price it there, and it appears here with live stock.
			</p>
			<a class="u-btn u-btn-ghost" href={model.adminHref}>
				Open the admin
			</a>
		</div>
	) : (
		<Fragment>
			<div class="pl-shop-head">
				<h1 class="pl-h">All objects</h1>
				{model.countLabel !== null && <p class="pl-count-label">{model.countLabel}</p>}
			</div>
			<ul class="pl-grid" role="list">
				{model.cards.map((card, index) => (
					<li>
						<Card card={card} headingLevel={2} named={named[index] ?? false} />
					</li>
				))}
			</ul>
		</Fragment>
	)
}
