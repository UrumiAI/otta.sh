---
/**
 * Plinth's view of one of a signed-in customer's orders (issue #306): the
 * confirmation page's shape — its reference small, its state as the heading,
 * then the lines as bought (the purchase-time snapshot — title and price —
 * which is what a receipt must show) in the wide column and the totals in the
 * narrow one. Presentation only — `src/pages/account/orders/[id].astro` reads
 * through the session route (NOT_FOUND for an order that is not theirs, the
 * same answer as for one that does not exist), sets the status and the
 * no-store header, and formats every figure.
 */
import { isUnpricedText } from "../../lib/totals.js";
import type { AccountOrderModel } from "../contract.js";
import Notice from "./Notice.astro";
import Receipt from "./Receipt.astro";

interface Props {
	model: AccountOrderModel;
}

const { order, errorMessage } = Astro.props.model;
---

<div class="pl-co pl-order">
	<nav class="pl-trail" aria-label="Breadcrumb">
		<a href="/account/orders">Your orders</a>
		<span aria-hidden="true">/</span>
		<span aria-current="page">{order === null ? "Order" : order.id}</span>
	</nav>

	{
		order === null ? (
			<div class="pl-order-head">
				<h1 class="pl-h">Order</h1>
				<div class="pl-co-notice-slot">
					<Notice tone="error">{errorMessage}</Notice>
				</div>
			</div>
		) : (
			<>
				<header class="pl-order-head">
					<p class="pl-order-ref">
						Order <span class="pl-order-id">{order.id}</span>
					</p>
					<h1 class="pl-h pl-order-title">{order.state}</h1>
				</header>

				<div class="pl-order-cols">
					<section class="pl-order-panel">
						<h2 class="u-label pl-co-head-label">Items</h2>
						<Receipt rows={order.ledgerRows} />
					</section>

					<section class="pl-order-panel">
						<h2 class="u-label pl-co-head-label">Totals</h2>
						<dl class="pl-totals">
							{order.totals.map((row) => (
								<div class="pl-totals-row" data-prose={isUnpricedText(row.value) ? "" : undefined}>
									<dt>{row.label}</dt>
									<dd class="u-mono">{row.value}</dd>
								</div>
							))}
							<div class="pl-totals-row pl-totals-grand">
								<dt>Total</dt>
								<dd class="u-mono">{order.total}</dd>
							</div>
						</dl>
					</section>
				</div>
			</>
		)
	}
</div>
