---
/**
 * Plinth's notice: tone, never a box with a border — a field of stone, the
 * lead in the state's colour and the rest in muted ink (the product page's
 * `.pl-notice`, reused). `tone="warn"` is ochre — Plinth's only colour, kept
 * for warnings (a degraded read); `tone="error"` is the error red and makes it
 * an alert; the default is plain information, the lead in ink.
 */
interface Props {
	lead?: string | null;
	tone?: "info" | "warn" | "error";
}

const { lead = null, tone = "info" } = Astro.props;
---

<div
	class:list={["pl-notice", "pl-note", { "pl-notice-error": tone === "error" }]}
	data-tone={tone}
	role={tone === "error" ? "alert" : "status"}
>
	{lead !== null && <p class="pl-notice-lead">{lead}</p>}
	<p class="pl-note-body"><slot /></p>
</div>
