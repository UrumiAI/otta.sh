---
/**
 * Plinth's order confirmation: a still page. The order's reference small and
 * muted, then the order's OWN state as the heading at 22px (nothing on the
 * storefront is larger except the home statement), the body at 60ch, and what
 * you can do next. Beneath, the product page's split: the items in the wide
 * column, the totals in the narrow one. No stamp, no flourish — the words are
 * the page's answer, and the space around them does the celebrating.
 *
 * Presentation only: `src/pages/orders/[orderId].astro` reads the order,
 * deletes the checkout stash, sets 404/503, picks the copy for the order's
 * state, and runs the bounded meta-refresh poll (the `<meta>` tags are the
 * page's, and so is `no-referrer`). Stripe's redirect parameters never reach
 * this file: the page reads them to choose between two copy variants and hands
 * over only the words (`checkout-client-js.test.ts` 10c sweeps this view).
 *
 * ZERO client JavaScript (ADR-0012): the "still checking" line is the shared,
 * script-free `PollRibbon`, never the bag's countdown.
 */
import PollRibbon from "../../components/PollRibbon.astro";
import type { OrderModel } from "../contract.js";
import { plinthArt } from "./art.js";
import Notice from "./Notice.astro";
import Receipt from "./Receipt.astro";
import StepTrack from "./StepTrack.astro";
import Totals from "./Totals.astro";

interface Props {
	model: OrderModel;
}

const {
	order,
	stamp,
	failureMessage,
	shouldPoll,
	pollHop,
	pollMax,
	nextPollUrl,
	hasActions,
	canCheckAgain,
	canResume,
	deadEnd,
	ledgerRows,
	sumRows,
	totalLabel,
} = Astro.props.model;
const emptyPlinth = plinthArt("nothing-here", "").svg;
---

<div class="pl-co pl-order">
	{
		order === null || stamp === null ? (
			<div class="pl-missing">
				{/* No step track: it would claim a journey (bag, details, payment)
				    the visitor never made for an order that does not exist. */}
				<div class="pl-missing-art" aria-hidden="true">
					<Fragment set:html={emptyPlinth} />
				</div>
				<div>
					<h1 class="pl-h">Order</h1>
					<div class="pl-co-notice-slot">
						<Notice tone="error">{failureMessage}</Notice>
					</div>
					<a class="pl-link" href="/products">
						Browse products
					</a>
				</div>
			</div>
		) : (
			<>
				<div class="pl-co-steps"><StepTrack current="order" /></div>

				<header class="pl-order-head" data-state={order.state}>
					<p class="pl-order-ref">
						Order <span class="pl-order-id">{order.id}</span>
					</p>
					<h1 class="pl-h pl-order-title">{stamp.headline}</h1>
					{stamp.body !== null && <p class="pl-order-body">{stamp.body}</p>}
					{shouldPoll && (
						<div class="pl-order-poll">
							<PollRibbon poll={pollHop} pollMax={pollMax} />
						</div>
					)}
					{hasActions && (
						<div class="pl-order-actions">
							{canResume && (
								<a class="u-btn" href="/checkout">
									Complete payment
								</a>
							)}
							{canCheckAgain && (
								<a class="u-btn u-btn-ghost" href={nextPollUrl}>
									Check again
								</a>
							)}
							{deadEnd && (
								<form method="POST" action="/checkout/new-cart">
									<button type="submit" class="u-btn u-btn-ghost">
										Start a new cart
									</button>
								</form>
							)}
						</div>
					)}
					<p class="pl-order-keep">Keep this link to check its status.</p>
				</header>

				<div class="pl-order-cols">
					<section class="pl-order-panel">
						<h2 class="u-label pl-co-head-label">Items</h2>
						<Receipt rows={ledgerRows} />
						{order.fulfillment !== null && (
							<p class="pl-order-ship">
								Shipped with {order.fulfillment.carrier}, tracking{" "}
								<span class="pl-order-id">{order.fulfillment.trackingNumber}</span>
							</p>
						)}
					</section>

					<section class="pl-order-panel">
						<h2 class="u-label pl-co-head-label">Totals</h2>
						<Totals
							rows={sumRows}
							total={order.totals.total}
							totalLabel={totalLabel}
							excludesUncalculated={order.totals.totalExcludesUncalculated}
						/>
					</section>
				</div>
			</>
		)
	}
</div>
