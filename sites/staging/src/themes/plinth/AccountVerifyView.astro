---
/**
 * Plinth's verify step — where the emailed magic link lands (issue #306), in
 * the sign-in page's composition: the bare plinth, and the one button beside it.
 *
 * THIS PAGE REDEEMS NOTHING: it renders one button that POSTs the challenge and
 * token to `/account/verify/confirm`, because mail scanners pre-fetch links and
 * a redeeming GET would spend the single-use token. The two values are printed
 * ONLY into the two hidden inputs that form needs. The referrer policy
 * (`same-origin`, deliberately not `no-referrer`) is the page's, in <head>.
 */
import type { AccountVerifyModel } from "../contract.js";
import { plinthArt } from "./art.js";
import Notice from "./Notice.astro";

interface Props {
	model: AccountVerifyModel;
}

const { usable, challenge, token, invalidMessage } = Astro.props.model;
const emptyPlinth = plinthArt("nothing-here", "").svg;
---

<div class="pl-missing pl-acct">
	<div class="pl-missing-art" aria-hidden="true">
		<Fragment set:html={emptyPlinth} />
	</div>
	<div class="pl-acct-words">
		<h1 class="pl-h">Sign in</h1>

		{
			usable ? (
				<form method="POST" action="/account/verify/confirm" class="pl-acct-form">
					<input type="hidden" name="challenge" value={challenge} />
					<input type="hidden" name="token" value={token} />
					<p class="pl-cv-lede">Continue to finish signing in. The link works once.</p>
					<button type="submit" class="u-btn pl-go">
						Continue signing in
					</button>
				</form>
			) : (
				<>
					<div class="pl-co-notice-slot">
						<Notice tone="error">{invalidMessage}</Notice>
					</div>
					<a class="u-btn u-btn-ghost pl-go" href="/account/login">
						Request a new sign-in link
					</a>
				</>
			)
		}
	</div>
</div>
