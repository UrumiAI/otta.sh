---
/**
 * Plinth's hold, on `/cart` (brief "Hold": plain text, no bar, no ring): a
 * filled 6px ink dot, then "Held for you until 4:52 pm UTC, 14 min left". The
 * minutes change once a minute and nothing moves; under a minute the words
 * count seconds and the dot and the count turn ochre, Plinth's one warning
 * colour. Released, the dot empties to a muted ring, the words read "Hold
 * released" and the next step appears beneath them.
 *
 * MARKUP ONLY — the contract in `themes/contract.ts` ("THE HOLD COUNTDOWN'S
 * MARKUP CONTRACT"). `components/HoldClock.astro`, which the `/cart` PAGE
 * renders, rewrites `data-state`, `data-minutes`, `[data-hold-minutes]`,
 * `[data-hold-seconds]`, `[data-hold-note]` and `[data-hold-announce]` once a
 * second; `commerce.css` picks the sentence on `data-state`. Rewriting "14"
 * with "14" changes nothing on screen, so the line reads as updating once a
 * minute — with no motion at all, which is the brief's countdown.
 *
 *  - THE WALL CLOCK IS FIXED TEXT, and stays true: the expiry floored to the
 *    minute, in UTC — the server cannot know the shopper's zone (`wallClock`,
 *    `lib/hold.ts`).
 *  - WITHOUT JavaScript nothing would keep "14 min left" true, so each count
 *    ships inside a marker element the script's first write replaces, and
 *    `commerce.css` hides the count while the marker is still there. What is
 *    left — "Held for you until 4:52 pm UTC" — is true for as long as it is on
 *    screen.
 *  - The countdown is information, so it runs under reduced motion too
 *    (`data-motion="essential"`); there is no decoration here to reduce.
 */
import {
	HOLD_RELEASED_NEXT_STEP,
	HOLD_WINDOW_SECONDS,
	holdView,
	wallClock,
} from "../../lib/hold.js";

interface Props {
	/** The line's own `expiresAt`; `null` (no reservation taken) renders nothing. */
	expiresAt: string | null;
}

const { expiresAt } = Astro.props;
const view = holdView(expiresAt, new Date(), HOLD_WINDOW_SECONDS);
const until = expiresAt === null ? null : wallClock(expiresAt);
const minutes = view === null ? 0 : Math.floor(view.secondsLeft / 60);
---

{
	view !== null && until !== null && (
		<div
			class="pl-held"
			data-hold
			data-state={view.state}
			data-expires={expiresAt}
			data-window={HOLD_WINDOW_SECONDS}
			data-minutes={minutes}
			data-motion="essential"
		>
			<p class="pl-held-line" role="timer">
				<span class="pl-dot" aria-hidden="true" />
				{/* One line per sentence, no whitespace between the spans: a newline
				    there would print "UTC , 14 min left". */}
				<span class="pl-held-words">
					<span class="pl-held-live"><span class="pl-held-until">Held for you until {until}</span><span class="pl-held-count">, <span class="u-mono" data-hold-minutes><span class="pl-nojs">{minutes}</span></span> min left</span></span>
					<span class="pl-held-soon"><span class="pl-held-until">Held for you until {until}</span><span class="pl-held-count">, <span class="u-mono" data-hold-seconds><span class="pl-nojs">{view.secondsLeft}</span></span> sec left</span></span>
					<span class="pl-held-gone">Hold released</span>
				</span>
			</p>
			<span class="u-sr-only" data-hold-announce aria-live="polite" />
			<p class="pl-held-note" data-hold-note hidden={view.state !== "released"}>
				{HOLD_RELEASED_NEXT_STEP}
			</p>
		</div>
	)
}
