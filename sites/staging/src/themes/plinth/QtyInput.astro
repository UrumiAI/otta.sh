---
/**
 * A quantity field in Plinth's grammar: a stone well, no border, the control
 * radius, the figure in ink. The label is a real `<label>` around the input,
 * visually hidden in a bag line — name the product in it ("Quantity, Lamp") so
 * the fields on a page are distinguishable. Posts as `qty`, which is what
 * `/cart/update` reads.
 */
interface Props {
	value: number;
	label: string;
}

const { value, label } = Astro.props;
---

<label class="pl-qtyin">
	<span class="u-sr-only">{label}</span>
	<input class="pl-well u-mono" type="number" name="qty" value={value} min="1" inputmode="numeric" required />
</label>
