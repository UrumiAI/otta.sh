---
/**
 * Jumble's hold, on `/cart` (brief "Hold"): a Sun pill that DRAINS — a fill of
 * Sun at full strength over a track of Sun at 35%, shrinking toward the left as
 * the hold runs down — with "Held for you" in casual 750 and the time left in
 * tabular 800. Under a minute the pill turns tangerine and wiggles once (±3°,
 * 400ms, never again). Released, it goes lavender, says so, and the next step
 * appears beneath it. By night-light the pill is NOT solid Sun (the Add button
 * is): an indigo track with a Sun ring, a sun-tinted fill, cream words and Sun
 * digits (the brief's review fix).
 *
 * MARKUP ONLY — the contract in `themes/contract.ts` ("THE HOLD COUNTDOWN'S
 * MARKUP CONTRACT"), and only its long-standing hooks. `components/HoldClock.astro`,
 * which the `/cart` PAGE renders, rewrites `data-state`, `--pct` on
 * `[data-hold-fill]`, `[data-hold-label]`, `[data-hold-clock]`,
 * `[data-hold-note]` and `[data-hold-announce]` once a second; `commerce.css`
 * colours the pill from `data-state`.
 *
 *  - WITHOUT JavaScript nothing would keep "14:32" true, so the clock ships the
 *    expiry as a wall clock — floored to the minute, in UTC, since the server
 *    cannot know the shopper's zone (`wallClock`, `lib/hold.ts`) — and the
 *    label carries a trailing " until": "Held for you until 4:52 pm UTC", which
 *    stays true for as long as the page is open. The script's first tick
 *    replaces the label's text (dropping " until") and the clock's.
 *  - The fill's server width is the first frame; with no script it stays there,
 *    and the words beside it are the truth.
 *  - The countdown is information, so it keeps running under reduced motion
 *    (`data-motion="essential"`); there the fill STEPS once a second instead of
 *    easing, and the tangerine turn happens without the wiggle.
 */
import {
	HOLD_RELEASED_NEXT_STEP,
	HOLD_WINDOW_SECONDS,
	holdView,
	wallClock,
} from "../../lib/hold.js";

interface Props {
	/** The line's own `expiresAt`; `null` (no reservation taken) renders nothing. */
	expiresAt: string | null;
}

const { expiresAt } = Astro.props;
const view = holdView(expiresAt, new Date(), HOLD_WINDOW_SECONDS);
const until = expiresAt === null ? null : wallClock(expiresAt);
/* "Held for you until 4:52 pm UTC", "Expiring at 4:52 pm UTC" — until the first tick. */
const joiner = view === null ? "" : view.state === "held" ? " until" : " at";
---

{
	view !== null && until !== null && (
		<div
			class="j-held"
			data-hold
			data-state={view.state}
			data-expires={expiresAt}
			data-window={HOLD_WINDOW_SECONDS}
			data-motion="essential"
		>
			<p class="j-held-pill" role="timer">
				<span class="j-held-fill" data-hold-fill style={`--pct: ${view.percent.toFixed(1)}%`} />
				<span class="j-held-label" data-hold-label>
					{view.label}{view.state !== "released" && <span class="j-held-join">{joiner}</span>}
				</span>
				<span class="j-held-clock j-figures" data-hold-clock>{until}</span>
			</p>
			<span class="u-sr-only" data-hold-announce aria-live="polite" />
			<p class="j-held-note" data-hold-note hidden={view.state !== "released"}>
				{HOLD_RELEASED_NEXT_STEP}
			</p>
		</div>
	)
}
