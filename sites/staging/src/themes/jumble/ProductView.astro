---
/**
 * Jumble's product page (brief "Layout (d)"): the product on its colour field
 * across the left half (radius 28, the photograph inset at radius 18, or the
 * block stack), and on the right the title in casual 850, the price in casual
 * 800 with tabular figures, the description in the LINEAR cut — casual is for
 * things you play with, linear for things you read — then the royal "Add to
 * bag" pill and the hold, in plain words.
 *
 * On a phone the field goes full-bleed and the column follows it. There is NO
 * sticky buy bar: title, price and the pill all land on the first screen at
 * 390px, so nothing ever needs to float over the description.
 *
 * "Add to bag" is the plain form POST every theme shares (`AddToCartFields`);
 * `/cart/add` answers it with a redirect to the bag. The press is acknowledged
 * by the pill squashing to 96% (theme.css, CSS only). The brief's signature —
 * the toy hopping into the header bag, and the draining Sun hold pill — lands
 * with the bag's own views (Phase 3); here the hold is the static sentence the
 * page computed.
 *
 * Not drawn: the brief's colour swatches, image thumbnails and "Age 3+" line
 * (the store has no variant surface, one image per product, and no age data —
 * controls or labels that describe nothing are worse than none).
 *
 * Presentation only: `src/pages/products/[slug].astro` owns the reads, the
 * 404/503 status, BUSY, the error token, the idempotency key and the return
 * path.
 */
import AddToCartFields from "../../forms/AddToCartFields.astro";
import type { ProductModel } from "../contract.js";
import Field from "./Field.astro";
import Notice from "./Notice.astro";

interface Props {
	model: ProductModel;
}

const { model } = Astro.props;
---

<div class="j-view">
	{
		model.state === "unavailable" ? (
			<div class="j-wrap j-shop">
				<div class="j-empty">
					<h1 class="j-h1">This product is unavailable.</h1>
					<p>The shop could not be read just now. Try again in a moment.</p>
					<a class="u-btn u-btn-ghost" href="/products">
						Back to the shop
					</a>
				</div>
			</div>
		) : model.state === "notFound" ? (
			<div class="j-wrap j-shop">
				<div class="j-empty">
					<h1 class="j-h1">Product not found.</h1>
					<p>Nothing in the shop lives at that address.</p>
					<a class="u-btn u-btn-ghost" href="/products">
						Back to the shop
					</a>
				</div>
			</div>
		) : (
			<>
				{model.degradedLead !== null && (
					<div class="j-wrap j-notice-slot j-notice-top">
						<Notice lead={model.degradedLead}>
							Check back in a moment. Everything else on this page is up to date.
						</Notice>
					</div>
				)}

				<div class="j-wrap j-pdp">
					<Field
						class="j-pdp-field"
						seed={model.art}
						image={model.image}
						alt={model.title}
						eager
						dimmed={model.dimmed}
					>
						{model.dimmed && <span class="j-sold">Sold out</span>}
					</Field>

					<div class="j-pdp-info">
						<h1 class="j-pdp-title">{model.title}</h1>

						{model.purchase !== null && (
							<p class="j-price j-figures">
								{model.purchase.priceStruck ? (
									<s>{model.purchase.priceFormatted}</s>
								) : (
									model.purchase.priceFormatted
								)}
							</p>
						)}

						{model.description && <p class="j-desc">{model.description}</p>}

						{model.errorMessage !== null && (
							<div class="j-notice-slot">
								<Notice tone="error">{model.errorMessage}</Notice>
							</div>
						)}

						{model.purchase !== null && model.purchase.addToCart !== null && (
							<form class="j-buy" method="POST" action="/cart/add">
								<AddToCartFields fields={model.purchase.addToCart} />
								<button class="u-btn j-add" type="submit">
									Add to bag
								</button>
								<p class="j-hold">{model.purchase.holdNote}</p>
							</form>
						)}

						{model.purchase !== null && model.purchase.soldOut && (
							<div class="j-buy">
								<button class="u-btn j-add" type="button" disabled>
									Sold out
								</button>
								<p class="j-hold">
									All gone for now.{" "}
									<a class="j-link" href="/products">
										See what else is in the shop
									</a>
								</p>
							</div>
						)}

						{model.showNotForSale && (
							<p class="j-hold">Not currently available for purchase</p>
						)}

						{model.purchase?.sku != null && (
							<p class="j-sku">
								SKU <span class="u-mono">{model.purchase.sku}</span>
							</p>
						)}
					</div>
				</div>
			</>
		)
	}
</div>
