---
/**
 * Jumble's sign-in (issue #306, ADR-0004): one lavender field on the white
 * ground, its head centred — one email field, magic link only, one royal pill.
 * Presentation only — `src/pages/account/login/index.astro` sets the no-store
 * header, reads `?sent` / `?error`, and hands over the copy. The `sent` notice
 * is the SAME sentence for every address, so the page is not an account
 * oracle; a theme may restyle it and must not vary it.
 */
import type { AccountLoginModel } from "../contract.js";
import Field from "./Field.astro";
import Notice from "./Notice.astro";

interface Props {
	model: AccountLoginModel;
}

const { sent, sentCopy, errorMessage } = Astro.props.model;
---

<div class="j-view">
	<div class="j-wrap j-page">
		<div class="j-panel j-acct">
			<div class="j-centre">
				<Field class="j-acct-toy" seed="sign-in" image={null} field={5} />
				<h1 class="j-title">Sign in</h1>
				<p class="j-lede">
					We'll email you a link that signs you in, no password. Orders you placed as a guest with
					the same address appear in your account once you sign in.
				</p>
			</div>

			{
				sent && (
					<div class="j-notice-slot">
						<Notice lead="Check your inbox.">{sentCopy}</Notice>
					</div>
				)
			}
			{
				errorMessage !== null && (
					<div class="j-notice-slot">
						<Notice tone="error">{errorMessage}</Notice>
					</div>
				)
			}

			<form method="POST" action="/account/login/request" class="j-acct-form">
				<div class="j-co-field">
					<label class="j-flabel" for="email">Email</label>
					<input type="email" id="email" name="email" required autocomplete="email" />
				</div>
				<button type="submit" class="u-btn j-co-go">Email me a sign-in link</button>
			</form>
		</div>
	</div>
</div>
