---
/**
 * Jumble's line list for a review or a receipt: the name in casual 800 with
 * "SKU, Qty 2" beneath it in small linear type, and the money in 800 with
 * tabular figures on the right. The money is the page's string (the line total,
 * or honest prose), passed through `moneyCellText` so no cell can print a bare
 * dash (§7); prose is set quieter and linear, decided by the value — never by a
 * flag.
 *
 * The name is the purchase-time title where the model carries one (a receipt);
 * the checkout review's lines carry none (its view model has no title and no
 * product id to look one up by), so they read by their SKU.
 */
import { isUnpricedText, moneyCellText } from "../../lib/totals.js";
import type { LedgerLine } from "../contract.js";

interface Props {
	rows: readonly LedgerLine[];
}

const { rows } = Astro.props;
const cells = rows.map((row) => {
	const money = moneyCellText(row.money);
	return {
		sku: row.sku,
		qty: row.qty,
		title: row.title !== undefined && row.title !== "" ? row.title : null,
		money,
		prose: isUnpricedText(money),
	};
});
---

<ul class="j-receipt" role="list">
	{
		cells.map((cell) => (
			<li class="j-receipt-line" role="listitem">
				<span class="j-receipt-id">
					<span class="j-receipt-name">{cell.title ?? cell.sku}</span>
					<span class="j-receipt-meta">
						{cell.title !== null && <>{cell.sku}, </>}Qty {cell.qty}
					</span>
				</span>
				<span class="j-receipt-money j-figures" data-prose={cell.prose ? "" : undefined}>
					{cell.money}
				</span>
			</li>
		))
	}
</ul>
