---
/**
 * A product on its colour field (theme-briefs.md §4 "Shape and surface"): a
 * square crayon field — Sky, Bubblegum, Grass, Tangerine or Sun, chosen by the
 * slug (art.ts) — with the product on it. A photograph sits INSET on the field
 * (12% padding, contain-fit, its own smaller radius); a product with no
 * photograph is drawn as a stack of toy blocks standing on the field.
 *
 * The one inner element (`.j-toy`) is what tilts when a tile is hovered
 * (theme.css, reduced-motion aware); the field never moves. `dimmed` takes the
 * field 40% toward grey — the brief's sold-out tile.
 *
 * The drawing is decorative (`aria-hidden`); a photograph takes the `alt` its
 * caller gives it — empty on a card, whose title is already the link's text.
 */
import { blockStack, fieldFor, type FieldIndex } from "./art.js";

interface Props {
	/** The product's slug or id — picks the field and seeds the blocks. */
	seed: string;
	image: string | null;
	alt?: string;
	/** Overrides the seeded field (the home hero keeps its tiles off Sun). */
	field?: FieldIndex;
	/** Eager for the page's lead picture, lazy everywhere else. */
	eager?: boolean;
	dimmed?: boolean;
	class?: string;
}

const {
	seed,
	image,
	alt = "",
	field = fieldFor(seed),
	eager = false,
	dimmed = false,
	class: className,
} = Astro.props;
const body = image === null ? blockStack(seed, field) : null;
---

<div class:list={["j-field", className]} data-field={field} data-dimmed={dimmed ? "" : undefined}>
	{
		image !== null ? (
			<img
				class="j-toy j-photo"
				src={image}
				alt={alt}
				loading={eager ? "eager" : "lazy"}
				decoding="async"
				fetchpriority={eager ? "high" : undefined}
			/>
		) : (
			<svg class="j-toy j-art" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
				<Fragment set:html={body} />
			</svg>
		)
	}
	<slot />
</div>
