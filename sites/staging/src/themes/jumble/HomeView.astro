---
/**
 * Jumble's home (brief "Layout (b)"): a Sun field, radius 28, with the store's
 * own thesis in casual 900 and the way into the shop on a royal pill — and,
 * beside it, up to three of the catalog's products on their own colour tiles,
 * each resting at its seeded tilt (art.ts `tiltFor`), so the arrangement is the
 * same on every visit. Then "In the shop" (the brief's "New in" — renamed, since the store
 * says nothing about what is new): every product the page fetched, 3-up.
 *
 * THE TILES are the first three cards the page fetched, drawn as pictures: the
 * same products are the links in the grid right below, so the tiles are
 * decoration (`aria-hidden`) rather than a second, overlapping set of tab
 * stops. They sit off Sun (`heroFields`), so no tile loses its edge.
 *
 * NOT DRAWN: the brief's "Shop by age" pills. They are a filter, and this store
 * has no age data to filter on — four pills that all lead to the same list
 * would be decoration pretending to be a feature.
 *
 * DEGRADED: no cards leaves the hero alone — no tiles, no grid, no error box,
 * the same rule as Tempered's tapeless hero. Presentation only:
 * `src/pages/index.astro` builds the model.
 */
import type { HomeModel } from "../contract.js";
import { heroFields, tiltFor } from "./art.js";
import Card from "./Card.astro";
import Field from "./Field.astro";

interface Props {
	model: HomeModel;
}

const { model } = Astro.props;
const featured = model.cards.slice(0, 3);
const fields = heroFields(featured.map((card) => card.slug));
---

<div class="j-view j-home">
	<section
		class="j-hero"
		data-tiles={featured.length > 0 ? featured.length : undefined}
		aria-labelledby="j-hero-title"
	>
		<div class="j-hero-copy">
			<h1 id="j-hero-title" class="j-display">{model.thesis}</h1>
			<p class="j-hero-lede">{model.lede}</p>
			<a class="u-btn j-royal" href={model.shopHref}>{model.shopLabel}</a>
		</div>
		{
			featured.length > 0 && (
				<div class="j-toys" aria-hidden="true">
					{featured.map((card, i) => (
						<div class="j-tile" style={`--j-tilt: ${tiltFor(card.slug)}deg`}>
							<Field seed={card.slug} image={card.image} field={fields[i]} eager={i === 0} />
						</div>
					))}
				</div>
			)
		}
	</section>

	{
		model.cards.length > 0 && (
			<section class="j-wrap j-shelf" aria-labelledby="j-shelf-title">
				<div class="j-sec">
					<h2 id="j-shelf-title" class="j-h2">
						In the shop
					</h2>
					<a class="j-link" href={model.shopHref}>
						{model.shopLabel}
					</a>
				</div>
				<div class="j-grid">
					{model.cards.map((card) => (
						<Card card={card} headingLevel={3} />
					))}
				</div>
			</section>
		)
	}
</div>
