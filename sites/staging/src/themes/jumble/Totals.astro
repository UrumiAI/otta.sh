---
/**
 * Jumble's totals block — the same honesty contract as the shared `Sum`
 * (docs/theme/TEMPERED.md §7): label left, figure right in 800 with tabular
 * figures, a row with no figure set as quieter linear prose so it can never be
 * read as an amount, and the total at the price size under a little space —
 * no rule, since Jumble draws no lines.
 *
 * Nothing money-shaped is built here: a row prints `sumRowText` (which never
 * lets a bare dash through), the total prints the view model's own label, and
 * the footnote is the page's or `uncalculatedFootnote`'s.
 */
import type { CheckoutAmountView } from "@otta-sh/plugin";
import { isUncalculated, sumRowText, uncalculatedFootnote, type SumRow } from "../../lib/totals.js";

interface Props {
	rows: SumRow[];
	total: CheckoutAmountView;
	totalLabel?: string;
	excludesUncalculated?: boolean;
	/** `null` suppresses the footnote; omitted derives it. */
	footnote?: string | null;
}

const { rows, total, totalLabel = "Total", excludesUncalculated = false, footnote } = Astro.props;
const note = footnote !== undefined ? footnote : uncalculatedFootnote(rows, excludesUncalculated);
---

<dl class="j-totals">
	{
		rows.map((row) => (
			<div class="j-totals-row" data-prose={isUncalculated(row.amount) ? "" : undefined}>
				<dt>{row.label}</dt>
				<dd class="j-figures">{sumRowText(row)}</dd>
			</div>
		))
	}
	<div class="j-totals-row j-totals-grand" data-prose={isUncalculated(total) ? "" : undefined}>
		<dt>{totalLabel}</dt>
		<dd class="j-figures">{total.label}</dd>
	</div>
</dl>
{note !== null && <p class="j-totals-note">{note}</p>}
