---
/**
 * Jumble's view of one of a signed-in customer's orders (issue #306): its
 * reference and state on the Sun field, then the lines as bought (the
 * purchase-time snapshot — title and price — which is what a receipt must
 * show) and the totals on lavender. Presentation only —
 * `src/pages/account/orders/[id].astro` reads through the session route
 * (NOT_FOUND for an order that is not theirs, the same answer as for one that
 * does not exist), sets the status and the no-store header, and formats every
 * figure.
 */
import { isUnpricedText } from "../../lib/totals.js";
import type { AccountOrderModel } from "../contract.js";
import Notice from "./Notice.astro";
import Receipt from "./Receipt.astro";

interface Props {
	model: AccountOrderModel;
}

const { order, errorMessage } = Astro.props.model;
---

<div class="j-view">
	<div class="j-wrap j-page j-order-page">
		<nav class="j-crumb" aria-label="Breadcrumb">
			<a href="/account/orders">Your orders</a>
			<span aria-hidden="true">/</span>
			<span aria-current="page">{order === null ? "Order" : order.id}</span>
		</nav>

		{
			order === null ? (
				<div class="j-empty">
					<h1 class="j-title">Order</h1>
					<div class="j-order-alert">
						<Notice tone="error">{errorMessage}</Notice>
					</div>
				</div>
			) : (
				<>
					<header class="j-sunfield j-order-head">
						<p class="j-order-ref">
							Order <span class="j-order-id">{order.id}</span>
						</p>
						<h1 class="j-title j-order-title">{order.state}</h1>
					</header>

					<div class="j-order-cols">
						<section class="j-panel j-order-panel">
							<h2 class="u-label j-panel-head-label">Items</h2>
							<Receipt rows={order.ledgerRows} />
						</section>

						<section class="j-panel j-order-panel">
							<h2 class="u-label j-panel-head-label">Totals</h2>
							<dl class="j-totals">
								{order.totals.map((row) => (
									<div class="j-totals-row" data-prose={isUnpricedText(row.value) ? "" : undefined}>
										<dt>{row.label}</dt>
										<dd class="j-figures">{row.value}</dd>
									</div>
								))}
								<div class="j-totals-row j-totals-grand">
									<dt>Total</dt>
									<dd class="j-figures">{order.total}</dd>
								</div>
							</dl>
						</section>
					</div>
				</>
			)
		}
	</div>
</div>
