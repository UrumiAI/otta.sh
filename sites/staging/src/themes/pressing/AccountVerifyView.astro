---
/**
 * Pressing's verify step — where the emailed magic link lands (issue #306), in
 * the sign-in page's layout: the same record on the left, one pink pill on the
 * right.
 *
 * THIS PAGE REDEEMS NOTHING: it renders one button that POSTs the challenge and
 * token to `/account/verify/confirm`, because mail scanners pre-fetch links and
 * a redeeming GET would spend the single-use token. The two values are printed
 * ONLY into the two hidden inputs that form needs. The referrer policy
 * (`same-origin`, deliberately not `no-referrer`) is the page's, in <head>.
 */
import type { AccountVerifyModel } from "../contract.js";
import Notice from "./Notice.astro";
import Record from "./Record.astro";

interface Props {
	model: AccountVerifyModel;
}

const { usable, challenge, token, invalidMessage } = Astro.props.model;
---

<div class="pr-page pr-acct">
	<div class="pr-acct-art">
		<Record seed="members" title="Sign in" instance="acct" size="hero" />
	</div>
	<div class="pr-acct-body">
		<h1 class="pr-display">Sign in</h1>

		{
			usable ? (
				<form method="POST" action="/account/verify/confirm" class="pr-acct-form">
					<input type="hidden" name="challenge" value={challenge} />
					<input type="hidden" name="token" value={token} />
					<p class="pr-desc">Continue to finish signing in. The link works once.</p>
					<button type="submit" class="u-btn pr-wide">
						Continue signing in
					</button>
				</form>
			) : (
				<>
					<div class="pr-slot">
						<Notice tone="error">{invalidMessage}</Notice>
					</div>
					<a class="u-btn u-btn-ghost" href="/account/login">
						Request a new sign-in link
					</a>
				</>
			)
		}
	</div>
</div>
