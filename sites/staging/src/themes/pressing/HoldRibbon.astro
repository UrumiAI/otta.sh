---
/**
 * Pressing's per-line hold, on `/cart`: a small pink-ringed pill on the bag
 * line — "Held for you" in 13/600 and the time left in tabular figures. The
 * bag strip (`BagStrip.astro`) states the hold that runs out first in big
 * expanded digits; this chip is each line's own, so a line held longer than
 * the strip's deadline still says so. Under a minute the ring and the digits
 * turn sodium; released, the chip goes muted and the next step appears under
 * it.
 *
 * MARKUP ONLY — the contract in `themes/contract.ts` ("THE HOLD COUNTDOWN'S
 * MARKUP CONTRACT"), and only its long-standing hooks. `components/HoldClock.astro`,
 * which the `/cart` PAGE renders, rewrites `data-state`, `[data-hold-label]`,
 * `[data-hold-clock]` and `[data-hold-note]` once a second; `commerce.css`
 * colours the chip from `data-state`. No announce region here: the strip
 * carries the page's one, so a state change is said once, not once per line.
 *
 * WITHOUT JavaScript nothing would keep "14:32" true, so the clock ships the
 * expiry as a wall clock — floored to the minute, in UTC (`wallClock`,
 * `lib/hold.ts`) — and the label a trailing " until" / " at": "Held for you
 * until 4:52 pm UTC", which stays true for as long as the page is open. The
 * script's first tick replaces both. The countdown is information, so it keeps
 * ticking under reduced motion (`data-motion="essential"`).
 */
import {
	HOLD_RELEASED_NEXT_STEP,
	HOLD_WINDOW_SECONDS,
	holdView,
	wallClock,
} from "../../lib/hold.js";

interface Props {
	/** The line's own `expiresAt`; `null` (no reservation taken) renders nothing. */
	expiresAt: string | null;
}

const { expiresAt } = Astro.props;
const view = holdView(expiresAt, new Date(), HOLD_WINDOW_SECONDS);
const until = expiresAt === null ? null : wallClock(expiresAt);
/* "Held for you until 4:52 pm UTC", "Expiring at 4:52 pm UTC" — until the first tick. */
const joiner = view === null ? "" : view.state === "held" ? " until" : " at";
---

{
	view !== null && until !== null && (
		<div
			class="pr-held"
			data-hold
			data-state={view.state}
			data-expires={expiresAt}
			data-window={HOLD_WINDOW_SECONDS}
			data-motion="essential"
		>
			<p class="pr-held-chip" role="timer">
				<span class="pr-held-label" data-hold-label>
					{view.label}{view.state !== "released" && <span class="pr-held-join">{joiner}</span>}
				</span>
				<span class="pr-held-clock u-mono" data-hold-clock>
					{view.state === "released" ? view.clock : until}
				</span>
			</p>
			<p class="pr-held-note" data-hold-note hidden={view.state !== "released"}>
				{HOLD_RELEASED_NEXT_STEP}
			</p>
		</div>
	)
}
