---
/**
 * THE BAG STRIP — Pressing's hold visual (theme-briefs.md §2): a full-width
 * strip fixed to the foot of the viewport on the sleeve-blue surface, "Held
 * for you" and then the time in big expanded tabular digits (56px; 32px on a
 * phone, where the strip is 56px tall), what is set aside, and the pink
 * "Check out" pill. Tabular figures, so the width never jitters as the digits
 * change.
 *
 * TWO RENDERINGS, ONE LOOK.
 *
 *  - `live` (the `/cart` view): the strip IS a hold root — `data-hold`,
 *    `data-expires`, `data-window`, `[data-hold-label]`, `[data-hold-clock]`,
 *    `[data-hold-note]`, `[data-hold-announce]` — and `components/HoldClock.astro`,
 *    which the `/cart` PAGE renders, ticks it once a second and rewrites
 *    `data-state`. The first frame and the no-script value are the expiry as
 *    a wall clock ("Held for you until 4:52 pm UTC"), which stays true.
 *  - static (every other page that draws the bag, off the checkout flow): the
 *    same strip with the same wall-clock words and no hooks. There is no
 *    script there to count (ADR-0012), so it states when the hold ends, never
 *    a frozen "14:32".
 *
 * UNDER A MINUTE (`data-state="expiring"`) the strip's ground crossfades to
 * sodium over 300ms with ultramarine text, and the pill turns ultramarine with
 * sodium words — no flashing. Under reduced motion it turns in one step.
 *
 * THE RISE: with `rise` (the `/cart` render an add lands on, when a hold was
 * just taken — `CartView.astro` asks `isFreshHold`) the strip rises 360ms on
 * the brief's curve; on any other render, and under reduced motion, it is
 * simply there. `commerce.css` owns all of it.
 *
 * `role="timer"` only where the strip COUNTS (`live`, with HoldClock's hooks):
 * a static wall clock is a time of day, not a timer. With no hold to state, the
 * big type is the count and the line under it says something else (the caller
 * passes neutral copy), so the count is never said twice.
 *
 * DIGITS DO NOT ROLL. The brief asks for a 140ms vertical roll per change;
 * the only thing that changes is a text node the one sanctioned script
 * rewrites, and CSS cannot animate a text node's replacement. HoldClock stays
 * as it is (no new client JS, no theme-specific hook), so the digits swap.
 *
 * It never covers the page: the body reserves the strip's height (and the
 * safe-area inset) while one is present (`commerce.css`).
 */
import { HOLD_RELEASED_NEXT_STEP, HOLD_WINDOW_SECONDS, holdView } from "../../lib/hold.js";
import { stripWallClock } from "./strip.js";

interface Props {
	/** The hold the strip states (`strip.ts`'s choice), or `null` for none. */
	expiresAt: string | null;
	/** Count down with HoldClock's hooks (`/cart` only). */
	live?: boolean;
	/** What is set aside — "Night Swim and 2 more, set aside". */
	what: string;
	/** What stands in the big type when there is no hold to state ("3 items"). */
	count: string;
	/** Rise into view on this render. */
	rise?: boolean;
}

const { expiresAt, live = false, what, count, rise = false } = Astro.props;
const view = holdView(expiresAt, new Date(), HOLD_WINDOW_SECONDS);
const clock = expiresAt === null ? null : stripWallClock(expiresAt);
const hold = view !== null && clock !== null ? { view, clock } : null;
const state = hold === null ? "none" : hold.view.state;
const hooks = live && hold !== null;
const label =
	hold === null
		? "In your bag"
		: hold.view.state === "released"
			? hold.view.label
			: live
				? hold.view.label
				: hold.view.state === "expiring"
					? "Held until"
					: "Held for you until";
/* The words the first tick drops ("until", "at") — only while the script may run. */
const joiner =
	!hooks || hold === null || hold.view.state === "released"
		? ""
		: hold.view.state === "held"
			? " until"
			: " at";
---

<aside
	class="pr-strip"
	aria-label="Your bag"
	data-state={state}
	data-rise={rise ? "" : undefined}
	data-motion="essential"
	data-hold={hooks ? "" : undefined}
	data-expires={hooks ? expiresAt : undefined}
	data-window={hooks ? HOLD_WINDOW_SECONDS : undefined}
>
	<div class="pr-strip-in">
		<p class="pr-strip-label" data-hold-label={hooks ? "" : undefined}>
			{label}{joiner !== "" && <span>{joiner}</span>}
		</p>
		{
			hold === null ? (
				<p class="pr-strip-clock pr-strip-count">{count}</p>
			) : (
				<p
					class="pr-strip-clock u-mono"
					role={hooks ? "timer" : undefined}
					data-hold-clock={hooks ? "" : undefined}
				>
					{hold.view.state === "released" ? (
						hold.view.clock
					) : (
						<Fragment>
							{hold.clock.time}
							<span class="pr-strip-unit"> {hold.clock.rest}</span>
						</Fragment>
					)}
				</p>
			)
		}
		<p class="pr-strip-what">{what}</p>
		{
			hooks && hold !== null && (
				<p class="pr-strip-what pr-strip-note" data-hold-note hidden={hold.view.state !== "released"}>
					{HOLD_RELEASED_NEXT_STEP}
				</p>
			)
		}
		<a class="u-btn pr-strip-go" href="/checkout">Check out</a>
	</div>
	{hooks && <span class="u-sr-only" data-hold-announce aria-live="polite" />}
</aside>
