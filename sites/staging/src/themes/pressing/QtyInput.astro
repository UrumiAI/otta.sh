---
/**
 * A quantity field in Pressing's hand: a small pill with the 1.5px ring, the
 * number in tabular figures. The label is a real `<label>` around the input,
 * visually hidden in a bag row — name the product in it ("Quantity, Night
 * Swim") so the fields on a page are distinguishable. Posts as `qty`, which is
 * what `/cart/update` reads.
 */
interface Props {
	value: number;
	label: string;
}

const { value, label } = Astro.props;
---

<label class="pr-qty">
	<span class="u-sr-only">{label}</span>
	<input class="u-mono" type="number" name="qty" value={value} min="1" inputmode="numeric" required />
</label>
