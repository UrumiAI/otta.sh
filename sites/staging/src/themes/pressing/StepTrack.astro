---
/**
 * Where the shopper is in checkout, as Pressing draws it: four pills in a row,
 * like the format chips on a product page. The step you are on is the pink
 * pill; the ones behind you wear the 1.5px vellum ring (the theme's one
 * outline mark) with a tick; the ones ahead are muted words with no ring. No
 * lines join them. The steps and their order are the shared `CHECKOUT_STEPS`,
 * so no theme can invent a step. A real ordered list, with
 * `aria-current="step"` on the one you are on; the ticks are decoration.
 */
import { CHECKOUT_STEPS, type CheckoutStep } from "../../components/StepTrack.astro";

interface Props {
	current: CheckoutStep;
}

const { current } = Astro.props;
const currentIndex = CHECKOUT_STEPS.findIndex((step) => step.id === current);
---

<ol class="pr-steps" role="list" aria-label="Checkout progress">
	{
		CHECKOUT_STEPS.map((step, index) => (
			<li
				class="pr-step"
				data-done={index < currentIndex ? "" : undefined}
				aria-current={index === currentIndex ? "step" : undefined}
			>
				{index < currentIndex && (
					<svg class="pr-step-tick" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
						<path d="M3.5 8.5l3 3 6-7" />
					</svg>
				)}
				{step.label}
			</li>
		))
	}
</ol>
