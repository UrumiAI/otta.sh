---
/**
 * A receipt line's record: the theme's generated disc alone, small — the same
 * vinyl, grooves, seeded label colour and resting angle as the disc behind a
 * card's sleeve (`art.ts`), minus the text round the label, which would be
 * noise at this size. A receipt line carries no picture and no product slug
 * (`LedgerLine`: the SKU, the purchase-time title, the money), so the disc is
 * seeded by the SKU — the catalogue number, which is what a label's receipt
 * lists anyway.
 *
 * Decorative (`aria-hidden`); the line's name is the text beside it. Still.
 */
import { pressingRecord } from "./art.js";

interface Props {
	seed: string;
}

const { seed } = Astro.props;
const art = pressingRecord(seed, seed, null, "disc");
/* Every third groove: at 40px the full set is a grey blur. */
const grooves = art.grooves.filter((_, index) => index % 3 === 0);
---

<svg
	class="pr-disc-sm"
	style={`--pr-rot: ${art.rotation}deg`}
	viewBox="0 0 100 100"
	aria-hidden="true"
	focusable="false"
>
	<circle class="pr-vinyl" cx="50" cy="50" r="49.5" />
	{grooves.map((groove) => <circle class="pr-groove" cx="50" cy="50" r={groove.r} stroke-opacity={Math.min(1, groove.o * 2)} />)}
	<path class="pr-sheen" d="M50 3 A47 47 0 0 1 90 28" />
	<circle class={`pr-t-${art.label}`} cx="50" cy="50" r="18" />
	<circle class="pr-t-ultra" cx="50" cy="50" r="3" />
</svg>
