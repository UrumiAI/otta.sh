---
/**
 * Pressing's totals block — the same honesty contract as the shared `Sum`
 * (docs/theme/TEMPERED.md §7): label left, figure right in tabular figures, a
 * row with no figure set as quieter prose so it can never be read as an
 * amount, and the total at the price size — 40px, expanded — under a little
 * space. No rule: Pressing draws no lines.
 *
 * Nothing money-shaped is built here: a row prints `sumRowText` (which never
 * lets a bare dash through), the total prints the view model's own label, and
 * the footnote is the page's or `uncalculatedFootnote`'s.
 */
import type { CheckoutAmountView } from "@otta-sh/plugin";
import { isUncalculated, sumRowText, uncalculatedFootnote, type SumRow } from "../../lib/totals.js";

interface Props {
	rows: SumRow[];
	total: CheckoutAmountView;
	totalLabel?: string;
	excludesUncalculated?: boolean;
	/** `null` suppresses the footnote; omitted derives it. */
	footnote?: string | null;
}

const { rows, total, totalLabel = "Total", excludesUncalculated = false, footnote } = Astro.props;
const note = footnote !== undefined ? footnote : uncalculatedFootnote(rows, excludesUncalculated);
---

<dl class="pr-totals">
	{
		rows.map((row) => (
			<div class="pr-totals-row" data-prose={isUncalculated(row.amount) ? "" : undefined}>
				<dt>{row.label}</dt>
				<dd class="u-mono">{sumRowText(row)}</dd>
			</div>
		))
	}
	<div class="pr-totals-row pr-totals-grand" data-prose={isUncalculated(total) ? "" : undefined}>
		<dt>{totalLabel}</dt>
		<dd class="u-mono">{total.label}</dd>
	</div>
</dl>
{note !== null && <p class="pr-totals-note">{note}</p>}
