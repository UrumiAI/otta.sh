---
/**
 * Pressing's notice: a block of the sleeve-blue surface — no border, no
 * radius, colour blocks are the theme's containers — with the lead in 15/700.
 * Information leads in sodium (Pressing's "low / expiring / degraded" hue,
 * 9:1 on the surface); `tone="error"` leads in the error coral and makes the
 * block an alert. The rest is muted body text.
 */
interface Props {
	lead?: string | null;
	tone?: "info" | "error";
}

const { lead = null, tone = "info" } = Astro.props;
---

<div
	class:list={["pr-notice pr-note", { "pr-notice-error": tone === "error" }]}
	role={tone === "error" ? "alert" : "status"}
>
	{lead !== null && <p class="pr-notice-lead">{lead}</p>}
	<p class="pr-note-body"><slot /></p>
</div>
