---
/**
 * Pressing's bag page (theme-briefs.md §2): "Your bag" set expanded and big on
 * the ultramarine ground, then the lines — each a block of the sleeve-blue
 * surface with the record on it (the product's picture as the sleeve, or the
 * generated sleeve, and its disc a third of the way out: the same record, seeded
 * by the same slug, as its card and product page), the title slightly
 * expanded, the catalogue number, the money in tabular figures, the line's own
 * hold chip and its controls. Beside them (below on a phone) the summary block:
 * the subtotal at the price size and the pink "Check out" pill.
 *
 * THE BAG STRIP. The live arm ends with `BagStrip` — the brief's hold visual:
 * the hold that runs out first, in big expanded digits, fixed to the foot of the
 * viewport, with "Check out". It rises (360ms, the brief's curve) only on the
 * render after an add or a hold-renewing quantity change (`/cart/add` answers
 * with a 303 to `/cart`), when a line's hold was taken moments ago
 * (`isFreshHold`, `lib/hold.ts`) — not on a reload, a revisit or a change to
 * another line.
 * Under reduced motion it is simply there. Under a minute its ground
 * crossfades to sodium.
 *
 * `/cart` is the one page that COUNTS DOWN: the strip and each line's chip carry
 * the contract's `data-hold*` hooks, and `components/HoldClock.astro`, which the
 * PAGE renders, keeps them current. No script lives in a view (ADR-0012).
 *
 * Presentation only: `src/pages/cart/index.astro` decides every arm (empty /
 * degraded / terminal / live), mints the per-form keys, and composes every
 * money string. The arms are written in the page's order — empty, terminal,
 * live — and a degraded read is never drawn as an empty bag.
 */
import {
	CART_CHECKED_OUT_BODY,
	CART_CHECKED_OUT_TITLE,
	CART_NEW_CART_CONSEQUENCE,
	CART_NO_ORDER_LINK,
	CART_RESUME_PURPOSE,
} from "../../lib/cart-view.js";
import { holdView, isFreshHold } from "../../lib/hold.js";
import { isUncalculated, isUnpricedText, sumRowText } from "../../lib/totals.js";
import type { CartModel } from "../contract.js";
import BagStrip from "./BagStrip.astro";
import Disc from "./Disc.astro";
import HoldRibbon from "./HoldRibbon.astro";
import Notice from "./Notice.astro";
import QtyInput from "./QtyInput.astro";
import Record from "./Record.astro";
import { stripLine } from "./strip.js";

interface Props {
	model: CartModel;
}

const {
	summary,
	errorMessage,
	degraded,
	degradedLead,
	pricingNotice,
	empty,
	terminal,
	placedOrderId,
	lineViews,
	sumRows,
	partialNote,
} = Astro.props.model;

/* The subtotal leads the summary. Any further row that carries a FIGURE is
   listed under it; a prose row ("Shipping: At checkout") is already said, in
   full, by the summary's shipping-and-tax line, so it is not said twice. */
const [lead, ...others] = sumRows;
const figureRows = others.filter((row) => !isUncalculated(row.amount));

/* The strip states ONE hold: the live one that runs out first (strip.ts). */
const now = new Date();
const stripView = stripLine(
	lineViews.map((view) => ({ ...view, expiresAt: view.line.expiresAt })),
	now,
);
const heldOthers = lineViews.filter(
	(view) =>
		view.line.lineId !== stripView?.line.lineId &&
		(holdView(view.line.expiresAt, now)?.state ?? "released") !== "released",
).length;
/* It rises on add only: some line's hold was just taken. */
const stripRises = lineViews.some((view) => isFreshHold(view.line.expiresAt, now));
const stripWhat =
	stripView === null
		? "Stock is confirmed when you check out."
		: heldOthers > 0
			? `${stripView.name} and ${heldOthers} more, set aside`
			: `${stripView.name}, set aside for you`;
---

<div class="pr-page">
	<header class="pr-page-head">
		<h1 class="pr-display">Your bag</h1>
		{summary !== null && <p class="pr-page-meta">{summary}</p>}
	</header>

	{
		errorMessage !== null && (
			<div class="pr-slot">
				<Notice tone="error">{errorMessage}</Notice>
			</div>
		)
	}
	{
		degraded && (
			<div class="pr-slot">
				<Notice lead={degradedLead}>We haven't changed anything. Try again in a moment.</Notice>
			</div>
		)
	}
	{
		pricingNotice && (
			<div class="pr-slot">
				<Notice lead="Totals are unavailable right now.">
					Your quantities and your holds are still exact.
				</Notice>
			</div>
		)
	}

	{
		empty ? (
			!degraded && (
				<div class="pr-missing pr-bag-empty">
					<Record seed="an-empty-sleeve" title="Your bag" instance="empty" size="hero" empty />
					<div>
						<h2 class="pr-h pr-h-page">Nothing in the bag yet.</h2>
						<p class="pr-desc">
							Anything you add is set aside for you while you check out, so it can't sell out
							from under you.
						</p>
						<a href="/products" class="u-btn">
							Browse the catalogue
						</a>
					</div>
				</div>
			)
		) : terminal ? (
			<div class="pr-cart-terminal">
				<div class="pr-block pr-terminal">
					<h2 class="pr-h">{CART_CHECKED_OUT_TITLE}</h2>
					<p class="pr-terminal-body">{CART_CHECKED_OUT_BODY}</p>

					<ul class="pr-receipt" role="list">
						{lineViews.map((view) => (
							<li class="pr-receipt-line" role="listitem">
								<Disc seed={view.line.sku} />
								<span class="pr-receipt-id">
									{view.title !== null && <span class="pr-receipt-name">{view.title}</span>}
									<span class="pr-receipt-meta">{view.line.sku}</span>
								</span>
								<span class="pr-receipt-meta">Qty {view.line.qty}</span>
							</li>
						))}
					</ul>

					<div class="pr-terminal-actions">
						{placedOrderId !== null && (
							<a href={`/orders/${encodeURIComponent(placedOrderId)}`} class="u-btn">View your order</a>
						)}

						{placedOrderId === null && (
							<div class="pr-terminal-resume">
								<a href="/checkout" class="u-btn">Return to this checkout</a>
								<p class="pr-terminal-note">{CART_RESUME_PURPOSE}</p>
								<p class="pr-terminal-note">{CART_NO_ORDER_LINK}</p>
							</div>
						)}

						<div class="pr-cart-terminal-restart">
							<form method="POST" action="/checkout/new-cart">
								<button type="submit" class="u-btn u-btn-ghost">Start a new cart</button>
							</form>
							<p class="pr-terminal-note">{CART_NEW_CART_CONSEQUENCE}</p>
						</div>
					</div>
				</div>
			</div>
		) : (
			<div class="pr-cart">
				<ul class="pr-baglines" role="list">
					{lineViews.map((view) => (
						<li class="pr-bagline" role="listitem">
							<div class="pr-bagline-art">
								<Record
									seed={view.artKey}
									title={view.name}
									image={view.image}
									instance={`bag-${view.index}`}
									size="line"
								/>
							</div>
							<div class="pr-bagline-body">
								<div class="pr-bagline-top">
									<div class="pr-bagline-id">
										<p class="pr-bagline-name">{view.title ?? view.line.sku}</p>
										{view.title !== null && (
											<p class="pr-bagline-cat">
												<span class="u-sr-only">Catalogue number </span>
												{view.line.sku}
											</p>
										)}
									</div>
									<div class="pr-bagline-money">
										{isUnpricedText(view.money) ? (
											<span class="pr-bagline-prose">{view.money}</span>
										) : (
											<span class="pr-bagline-price u-mono">{view.money}</span>
										)}
										{view.each !== null && <span class="pr-bagline-each u-mono">{view.each}</span>}
									</div>
								</div>
								<HoldRibbon expiresAt={view.line.expiresAt} />
								<div class="pr-bagline-ctl">
									<form method="POST" action="/cart/update" class="pr-bagline-update">
										<input type="hidden" name="lineId" value={view.line.lineId} />
										<input type="hidden" name="idempotencyKey" value={view.updateKey} />
										<QtyInput value={view.line.qty} label={`Quantity, ${view.name}`} />
										<button type="submit" class="pr-textctl">
											Update<span class="u-sr-only"> {view.name}</span>
										</button>
									</form>
									<form method="POST" action="/cart/remove">
										<input type="hidden" name="lineId" value={view.line.lineId} />
										<input type="hidden" name="idempotencyKey" value={view.removeKey} />
										<button type="submit" class="pr-textctl">
											Remove<span class="u-sr-only"> {view.name}</span>
										</button>
									</form>
								</div>
							</div>
						</li>
					))}
				</ul>

				<aside class="pr-block pr-cart-sum" aria-labelledby="pr-cart-sum-title">
					<h2 class="pr-block-title" id="pr-cart-sum-title">
						Summary
					</h2>
					{lead !== undefined && (
						<p class="pr-sub" data-prose={isUncalculated(lead.amount) ? "" : undefined}>
							<span class="pr-sub-label">{lead.label}</span>
							<span class="pr-sub-figure u-mono">{sumRowText(lead)}</span>
						</p>
					)}
					{figureRows.map((row) => (
						<p class="pr-sub pr-sub-minor">
							<span>{row.label}</span>
							<span class="u-mono">{sumRowText(row)}</span>
						</p>
					))}
					{partialNote !== null && <p class="pr-sub-note">{partialNote}</p>}
					<p class="pr-sub-note">Shipping and tax are worked out at checkout.</p>
					<a href="/checkout" class="u-btn pr-wide">
						Check out
					</a>
					<p class="pr-sub-fine">
						Prices are live and may change; your total is confirmed at checkout.
					</p>
				</aside>

				<BagStrip
					expiresAt={stripView?.line.expiresAt ?? null}
					live
					rise={stripRises}
					what={stripWhat}
					count={summary ?? "Your bag"}
				/>
			</div>
		)
	}
</div>
