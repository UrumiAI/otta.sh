---
/**
 * Tempered's sign-in page (issue #306, ADR-0004): one email field, magic link
 * only. Presentation only — `src/pages/account/login/index.astro` sets the
 * no-store header, reads `?sent` / `?error`, and hands over the copy. The
 * `sent` notice is the SAME sentence for every address, so the page is not an
 * account oracle; a theme may restyle it and must not vary it.
 *
 * Styles: `commerce.css` (`account-login-*`).
 */
import Notice from "../../components/Notice.astro";
import type { AccountLoginModel } from "../contract.js";

interface Props {
	model: AccountLoginModel;
}

const { sent, sentCopy, errorMessage } = Astro.props.model;
---

<h1 class="account-login-title">Sign in</h1>
<p class="account-login-lede">
	We'll email you a link that signs you in — no password. Orders you placed as a guest with the
	same address appear in your account once you sign in.
</p>

{
	sent && (
		<div class="account-login-notice-slot" role="status">
			<Notice lead="Check your inbox.">{sentCopy}</Notice>
		</div>
	)
}
{
	errorMessage !== null && (
		<div class="account-login-notice-slot" role="alert">
			<Notice>{errorMessage}</Notice>
		</div>
	)
}

<form method="POST" action="/account/login/request" class="account-login-form">
	<div class="account-login-field">
		<label class="u-label" for="email">Email</label>
		<input type="email" id="email" name="email" required autocomplete="email" />
	</div>
	<div>
		<button type="submit" class="u-btn">Email me a sign-in link</button>
	</div>
</form>

