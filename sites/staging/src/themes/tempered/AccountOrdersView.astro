---
/**
 * Tempered's order list for a signed-in customer (issue #306, ADR-0004).
 * Presentation only — `src/pages/account/orders/index.astro` resolves the
 * customer from the SESSION (never a customer id), redirects the signed-out,
 * sets `private, no-store`, maps BUSY, and hands over finished rows — newest
 * first, each with its status in words and the date it was placed.
 *
 * Styles: `commerce.css` (`account-orders-*`).
 */
import Notice from "../../components/Notice.astro";
import type { AccountOrdersModel } from "../contract.js";

interface Props {
	model: AccountOrdersModel;
}

const { errorMessage, rows, signedInAs } = Astro.props.model;
---

<div class="account-orders-head-row">
	<h1 class="account-orders-title">Your orders</h1>
	<div class="account-orders-session">
		{signedInAs !== null && <span class="account-orders-who">Signed in as {signedInAs}</span>}
		<form method="POST" action="/account/logout">
			<button type="submit" class="u-btn u-btn-ghost">Sign out</button>
		</form>
	</div>
</div>

{
	errorMessage !== null ? (
		<div class="account-orders-notice-slot" role="alert">
			<Notice>{errorMessage}</Notice>
		</div>
	) : rows.length === 0 ? (
		<p class="account-orders-empty">
			No orders yet. Orders you place with this email address — including as a guest — appear
			here. <a class="account-orders-empty-link" href="/products">Browse products</a>
		</p>
	) : (
		<ul class="account-orders-list">
			{rows.map((row) => (
				<li class="account-orders-row">
					{/* Named by its products, not the order id — a shopper is never
					    shown the UUID. The link is how they open it; the short
					    number under it is the one its emails carry (ADR-0033). */}
					<span class="account-orders-name-cell">
						<a class="account-orders-name" href={row.href}>
							{row.label}
						</a>
						<span class="account-orders-number u-mono">{row.number}</span>
					</span>
					<span class="account-orders-state">{row.state}</span>
					{/* A <time> even when the date is unreadable would claim one; the
					    cell stays, empty, so the columns still line up. */}
					<span class="account-orders-date">
						{row.placed !== null && <time datetime={row.placed.iso}>{row.placed.text}</time>}
					</span>
					<span class="account-orders-items">{row.items}</span>
					<span class="account-orders-total u-mono">{row.total}</span>
				</li>
			))}
		</ul>
	)
}

