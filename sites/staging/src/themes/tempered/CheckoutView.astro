---
/**
 * Tempered's checkout review (docs/theme/TEMPERED.md §8): the step track, then
 * two panels — the details form left (~1.15fr), the order ledger + totals
 * right. Every control is a form and works without JavaScript; the page's one
 * optional script (ADR-0034) only swaps the state/province list.
 *
 * Presentation only: `src/pages/checkout/index.astro` reads the cart cookie and
 * the URL's coupon/destination/method, dispatches the summary, takes every
 * non-renderable state back to /cart, and decides what this page may offer
 * (locked, ended, delivery, address, ready to place). The FORMS are the
 * contract `place.ts` reads — the same field names, the same actions, the same
 * hidden echoes of what the totals were priced with — and a theme may restyle
 * them, never rename them.
 *
 * The coupon's field and buttons belong to the place form (`form=` attribute),
 * so Apply and Remove post the typed details with them and the review comes
 * back with every value kept (QA U-1). The delivery block's fields and Update
 * button belong to it the same way.
 *
 * STATE / PROVINCE is a pick list of the country's subdivisions (names shown,
 * codes posted), rendered on the server for the country the page knows. The
 * page needs no JavaScript: a changed country takes a round trip ("Update
 * delivery", or the address block's Update beside its country) that re-renders
 * with that country's list and everything typed kept. The ONE client script on
 * this page (ADR-0034, optional) swaps the list as the country changes: each
 * country select names its list (`data-region-target`), the list's field is
 * `data-region-field` (hidden while the country has no subdivisions), and the
 * no-JS-only Update controls and hints are `data-region-update`. A country with
 * no subdivisions shows no region field. Values the buyer typed
 * before a refused place come back from the page's draft (`addressValues`,
 * `emailValue`), with `fieldErrors` printed beside the fields they name.
 *
 * Styles: `commerce.css` (`checkout-*`).
 */
import { BUYER_REF_MAX, ORDER_ADDRESS_MAX_LENGTHS } from "@otta-sh/plugin";
import Ledger from "../../components/Ledger.astro";
import Notice from "../../components/Notice.astro";
import StepTrack from "../../components/StepTrack.astro";
import Sum from "../../components/Sum.astro";
import type { CheckoutModel } from "../contract.js";

interface Props {
	model: CheckoutModel;
}

const {
	summary,
	errorMessage,
	checkedOut,
	locked,
	ended,
	couponValue,
	couponError,
	refusedCouponCode,
	destinationError,
	regionRefused,
	countryRefused,
	shippingError,
	noOptionsCopy,
	destination,
	destinationName,
	destinationRegionName,
	countryValue,
	countries,
	deliveryRegions,
	addressRegions,
	showDelivery,
	showAddress,
	chosenOption,
	notReadyCopy,
	paymentConfigured,
	notConfiguredLead,
	emailValue,
	emailNote,
	addressValues,
	fieldErrors,
	ledgerRows,
	sumRows,
	footnote,
} = Astro.props.model;
---

{/* The components are wrapped rather than handed a class: a page's scoped
    selector deliberately cannot reach a component's root (see
    src/lib/rest-props.ts), so spacing AROUND one belongs to an element the
    page owns. */}
<div class="checkout-steps"><StepTrack current="details" /></div>
<h1 class="checkout-title">Checkout</h1>

{errorMessage !== null && <div class="checkout-notice-slot" id="checkout-error"><Notice>{errorMessage}</Notice></div>}

{
	locked?.otherEmailNotice != null && (
		<div class="checkout-notice-slot">
			<Notice lead="This order was already placed.">{locked.otherEmailNotice}</Notice>
		</div>
	)
}

{
	locked !== null && (
		<div class="checkout-notice-slot">
			{ended ? (
				/* The `ended` phase — expired / failed — means NO LONGER PAYABLE,
				   not "never charged": a declined attempt fails the order while its
				   PaymentIntent stays confirmable, and a payment can land just after
				   the TTL sweep. The public order carries no reconciliation flag, so
				   this copy makes no claim about money either way — and promises no
				   particular outcome: reconciliation may refund OR fulfil the order.
				   It asks for the EMAIL, not an order number: a shopper is never
				   shown the order id, and the store finds an order by its buyer. */
				<Notice lead="This checkout has ended.">
					Its order can no longer be paid. If a payment did go through, contact the store with
					the email address you ordered with — its status is on
					<a href={`/orders/${encodeURIComponent(locked.id)}`}>your order page</a> — and they
					will refund it or complete your order. Start a new cart to order again.
				</Notice>
			) : (
				<Notice lead="Your order has already been created.">
					Its email, coupon and delivery address can no longer be changed. To change them, start a
					new cart — that cancels this order, and any payment for it that arrives
					afterwards will be refunded.
				</Notice>
			)}
		</div>
	)
}

{
	(checkedOut || locked !== null) && (
		<form method="POST" action="/checkout/new-cart" class="checkout-restart">
			<button type="submit" class="u-btn u-btn-ghost">
				Start a new cart
			</button>
		</form>
	)
}

<div class="checkout-cols">
	<section class="checkout-panel">
		<div class="checkout-panel-head">
			<h2 class="u-label checkout-head-label">Your details</h2>
		</div>

		{/* ENTER. The place form's FIRST submit button in tree order, and so its
		    default button: Enter in any details field submits `intent=enter`,
		    never Apply. place.ts applies a code typed into the box (unless it is
		    the one just refused), re-prices a changed delivery, else places.
		    Visually hidden, out of the tab order and hidden from assistive tech:
		    keyboard and screen-reader users submit with the visible buttons, and
		    Enter needs no focusable target. */}
		{
			locked === null && !ended && (
				<button
					type="submit"
					class="u-sr-only"
					form="checkout-place"
					name="intent"
					value="enter"
					tabindex="-1"
					aria-hidden="true"
				>
					Continue
				</button>
			)
		}

		{/* The coupon comes first. Its field and buttons belong to the PLACE form
		    (`form="checkout-place"`) although they sit up here: Apply and Remove
		    post everything typed below with them, so changing the coupon keeps the
		    details (QA U-1) — place.ts re-prices and comes straight back, placing
		    nothing. `formnovalidate`: applying a code must not demand an email. */}
		{
			!summary.orderCreated && (
				<div class="checkout-coupon">
					<div class="checkout-field">
						<label class="u-label" for="coupon">
							Coupon code
						</label>
						<div class="checkout-coupon-row">
							<input
								type="text"
								id="coupon"
								name="coupon"
								form="checkout-place"
								maxlength="200"
								autocomplete="off"
								value={couponValue}
								aria-invalid={couponError !== null}
								aria-describedby={couponError !== null ? "coupon-error coupon-note" : "coupon-note"}
							/>
							{/* The code just refused, put back in the box for correcting: Enter
							    with it unchanged is not an apply again (place.ts). */}
							{refusedCouponCode !== null && (
								<input
									type="hidden"
									name="refusedCoupon"
									form="checkout-place"
									value={refusedCouponCode}
								/>
							)}
							{/* An explicit Apply. It never places (the applied code again is
							    "already applied"); Enter goes through the hidden button above. */}
							<button
								type="submit"
								class="u-btn u-btn-ghost"
								form="checkout-place"
								name="intent"
								value="apply-coupon"
								formnovalidate
							>
								Apply
							</button>
						</div>
						{couponError !== null && (
							<div id="coupon-error">
								<Notice>{couponError}</Notice>
							</div>
						)}
						<span class="checkout-note" id="coupon-note">
							Codes aren't case-sensitive.
							{summary.selection.couponCode !== null && (
								<>
									{" "}
									<button
										type="submit"
										class="checkout-link-button"
										form="checkout-place"
										name="intent"
										value="remove-coupon"
										formnovalidate
									>
										Remove coupon
									</button>
								</>
							)}
						</span>
					</div>
				</div>
			)
		}

		{/* DELIVERY (ADR-0021). Choosing where the order goes re-prices the
		    review. Like the coupon's, its fields and Update button belong to the
		    PLACE form (`form="checkout-place"`), so updating it posts everything
		    typed below and keeps it (QA U-1). Its own names (`deliveryCountry`,
		    `deliveryRegion`, `deliveryMethod`) never collide with the place
		    form's priced echo. */}
		{
			showDelivery && (
				<div class="checkout-delivery" id="delivery">
					<fieldset class="checkout-group">
						<legend class="u-label checkout-head-label">Delivery</legend>
						{destinationError !== null && (
							<div id="delivery-error">
								<Notice>{destinationError}</Notice>
							</div>
						)}
						{shippingError !== null && <Notice>{shippingError}</Notice>}
						{summary.shipping.noOptions && (
							<Notice>{noOptionsCopy}</Notice>
						)}
						<div class="checkout-fields">
							<label class="checkout-field">
								<span class="u-label">Country</span>
								<select
									name="deliveryCountry"
									form="checkout-place"
									data-region-target="delivery-region"
									autocomplete="country"
									required
									aria-invalid={countryRefused}
									aria-describedby={countryRefused ? "delivery-error" : undefined}
								>
									<option value="">Choose a country…</option>
									{countries.map((option) => (
										<option value={option.code} selected={option.code === countryValue}>
											{option.label}
										</option>
									))}
								</select>
							</label>
							<div class="checkout-field" data-region-field hidden={deliveryRegions.options.length === 0}>
								<label class="u-label" for="delivery-region">
									State / province
								</label>
								<select
									id="delivery-region"
									name="deliveryRegion"
									form="checkout-place"
									autocomplete="address-level1"
									aria-invalid={regionRefused}
									aria-describedby={
										regionRefused && destinationError !== null
											? "delivery-error region-note"
											: regionRefused && errorMessage !== null
												? "checkout-error region-note"
												: "region-note"
									}
								>
									<option value="">Choose a state / province…</option>
									{deliveryRegions.options.map((option) => (
										<option value={option.code} selected={option.code === deliveryRegions.selected}>
											{option.label}
										</option>
									))}
								</select>
								<span class="checkout-note" id="region-note">
									Leave blank if your address doesn't use one.
									<span data-region-update>
										Changed the country? Select Update delivery to see its list.
									</span>
								</span>
							</div>
							{deliveryRegions.options.length === 0 && countryValue === "" && (
								<p class="checkout-note" data-region-update>
									Choose your country, then select Update delivery to pick your state or province.
								</p>
							)}
						</div>
						{/* The destination these options were priced for: a changed country or
						    region drops a method chosen for the old one. */}
						<input
							type="hidden"
							name="fromCountry"
							form="checkout-place"
							value={destination?.country ?? ""}
						/>
						<input
							type="hidden"
							name="fromRegion"
							form="checkout-place"
							value={destination?.region ?? ""}
						/>
						{summary.shipping.status === "matched" && summary.shipping.options.length > 0 && (
							<div class="checkout-methods" role="radiogroup" aria-label="Delivery options">
								{summary.shipping.options.map((option) => (
									<label class="checkout-method">
										<input
											type="radio"
											name="deliveryMethod"
											form="checkout-place"
											value={option.id}
											disabled={option.disabled}
											checked={option.selected}
										/>
										<span>{option.label}</span>
										<span class="checkout-method-price u-mono">{option.price}</span>
									</label>
								))}
							</div>
						)}
						<div>
							<button
								type="submit"
								class="u-btn u-btn-ghost"
								form="checkout-place"
								name="intent"
								value="update-delivery"
								formnovalidate
							>
								Update delivery
							</button>
						</div>
					</fieldset>
				</div>
			)
		}

		{/* LOCKED and still payable: the order exists, so there is nothing left
		    to fill in — no email field (the order keeps the one it was placed
		    with, and a typed one would be silently ignored), no address. The way
		    on is the page's resume path, which re-stashes the order's own intent
		    and shows its email on the pay step. */}
		{
			locked !== null && !ended && (
				<div class="checkout-details">
					{paymentConfigured ? (
						summary.readyToPlace && (
							<div>
								<a class="u-btn" href={locked.resumeHref}>
									Continue to payment
								</a>
							</div>
						)
					) : (
						/* LOCKED: an order exists and the cart is checked out, so the
						   unlocked copy's "nothing has been charged" and "your cart is
						   unchanged" would both be wrong here. */
						<Notice>
							Card payment isn't set up on this store, so this order can't be paid right now.
						</Notice>
					)}
				</div>
			)
		}

		{
			locked === null && !ended && (
				<form method="POST" action="/checkout/place" class="checkout-details" id="checkout-place">
					{/* STABLE per cart (checkout:<cartId>), so a reload or a double-submit
					    replays into the SAME order and the same PaymentIntent instead of
					    minting a second order the CART_CHECKED_OUT fence would reject. */}
					<input type="hidden" name="idempotencyKey" value={summary.idempotencyKey} />
					{/* Exactly the coupon the totals beside this form were priced with;
					    the place re-checks it. Absent when none applied. */}
					{summary.selection.couponCode !== null && (
						<input type="hidden" name="couponCode" value={summary.selection.couponCode} />
					)}
					{/* The method the totals were priced with. */}
					{summary.selection.shippingMethodId !== null && (
						<input
							type="hidden"
							name="shippingMethodId"
							value={summary.selection.shippingMethodId}
						/>
					)}

					{/* The note is a SIBLING of the label, not inside it. Nested, its
					    ~25 words join the field's ACCESSIBLE NAME and get read out in
					    full every time the input takes focus; `aria-describedby` is how
					    a hint attaches — announced after the name, and as a hint. */}
					<div class="checkout-field">
						<label class="u-label" for="email">
							Email <span class="checkout-req">required</span>
						</label>
						<input
							type="email"
							id="email"
							name="email"
							required
							autocomplete="email"
							maxlength={BUYER_REF_MAX}
							aria-invalid={fieldErrors.email !== undefined}
							aria-describedby={fieldErrors.email !== undefined ? "email-error email-note" : "email-note"}
							value={emailValue}
						/>
						{fieldErrors.email !== undefined && (
							<span class="checkout-field-error" id="email-error">
								{fieldErrors.email}
							</span>
						)}
						<span class="checkout-note" id="email-note">{emailNote}</span>
					</div>

					{/* A digital-only cart ships nothing — unless the store's Stripe
					    account is in India, which needs every buyer's name and address
					    (issue #382). (A LOCKED order's ship-to is fixed, and a locked
					    review renders no place form at all.) */}
					{
						showAddress && (
							<fieldset class="checkout-group">
								<legend class="u-label checkout-head-label">
									{summary.requiresShipping ? "Delivery address" : "Billing address"}
								</legend>
								{showDelivery ? (
									<>
										{/* The destination the review priced, as hidden fields: place.ts
										    counts only the typed fields toward all-or-nothing here. */}
										<input type="hidden" name="addressMode" value="zoned" />
										{destination !== null && (
											<>
												<input type="hidden" name="country" value={destination.country} />
												{destination.region !== null && (
													<input type="hidden" name="region" value={destination.region} />
												)}
												<p class="checkout-note checkout-group-note">
													Delivering to {destinationName}
													{destination.region !== null && <>, {destinationRegionName ?? destination.region}</>} —{" "}
													<a href="#delivery">change</a>
												</p>
											</>
										)}
									</>
								) : summary.paymentAccountNeedsAddress ? (
									<p class="checkout-note checkout-group-note">
										Required — Stripe accounts in India need the buyer's name and address.
									</p>
								) : (
									<p class="checkout-note checkout-group-note">
										Optional — fill it in completely, or leave it entirely blank.
									</p>
								)}
								<div class="checkout-fields">
									<div class="checkout-field checkout-span2">
										<label class="u-label" for="address-name">
											Full name{summary.addressRequired && <span class="checkout-req">required</span>}
										</label>
										<input
											type="text"
											id="address-name"
											name="name"
											aria-required={summary.addressRequired ? "true" : undefined}
											autocomplete="name"
											maxlength={ORDER_ADDRESS_MAX_LENGTHS.name}
											value={addressValues.name}
											aria-invalid={fieldErrors.name !== undefined}
											aria-describedby={fieldErrors.name !== undefined ? "name-error" : undefined}
										/>
										{fieldErrors.name !== undefined && (
											<span class="checkout-field-error" id="name-error">
												{fieldErrors.name}
											</span>
										)}
									</div>
									<div class="checkout-field checkout-span2">
										<label class="u-label" for="address-line1">
											Address line 1{summary.addressRequired && <span class="checkout-req">required</span>}
										</label>
										<input
											type="text"
											id="address-line1"
											name="line1"
											aria-required={summary.addressRequired ? "true" : undefined}
											autocomplete="address-line1"
											maxlength={ORDER_ADDRESS_MAX_LENGTHS.line1}
											value={addressValues.line1}
											aria-invalid={fieldErrors.line1 !== undefined}
											aria-describedby={fieldErrors.line1 !== undefined ? "line1-error" : undefined}
										/>
										{fieldErrors.line1 !== undefined && (
											<span class="checkout-field-error" id="line1-error">
												{fieldErrors.line1}
											</span>
										)}
									</div>
									<div class="checkout-field checkout-span2">
										<label class="u-label" for="address-line2">
											Address line 2
										</label>
										<input
											type="text"
											id="address-line2"
											name="line2"
											autocomplete="address-line2"
											maxlength={ORDER_ADDRESS_MAX_LENGTHS.line2}
											value={addressValues.line2}
											aria-invalid={fieldErrors.line2 !== undefined}
											aria-describedby={fieldErrors.line2 !== undefined ? "line2-error" : undefined}
										/>
										{fieldErrors.line2 !== undefined && (
											<span class="checkout-field-error" id="line2-error">
												{fieldErrors.line2}
											</span>
										)}
									</div>
									<div class="checkout-field">
										<label class="u-label" for="address-city">
											City{summary.addressRequired && <span class="checkout-req">required</span>}
										</label>
										<input
											type="text"
											id="address-city"
											name="city"
											aria-required={summary.addressRequired ? "true" : undefined}
											autocomplete="address-level2"
											maxlength={ORDER_ADDRESS_MAX_LENGTHS.city}
											value={addressValues.city}
											aria-invalid={fieldErrors.city !== undefined}
											aria-describedby={fieldErrors.city !== undefined ? "city-error" : undefined}
										/>
										{fieldErrors.city !== undefined && (
											<span class="checkout-field-error" id="city-error">
												{fieldErrors.city}
											</span>
										)}
									</div>
									<div class="checkout-field">
										<label class="u-label" for="address-postalCode">
											Postal code{summary.addressRequired && <span class="checkout-req">required</span>}
										</label>
										<input
											type="text"
											id="address-postalCode"
											name="postalCode"
											aria-required={summary.addressRequired ? "true" : undefined}
											autocomplete="postal-code"
											maxlength={ORDER_ADDRESS_MAX_LENGTHS.postalCode}
											value={addressValues.postalCode}
											aria-invalid={fieldErrors.postalCode !== undefined}
											aria-describedby={fieldErrors.postalCode !== undefined ? "postalCode-error" : undefined}
										/>
										{fieldErrors.postalCode !== undefined && (
											<span class="checkout-field-error" id="postalCode-error">
												{fieldErrors.postalCode}
											</span>
										)}
									</div>
									{!showDelivery && (
										<>
											<div class="checkout-field">
												<label class="u-label" for="address-country">
													Country{summary.addressRequired && <span class="checkout-req">required</span>}
												</label>
												<div class="checkout-country-row">
													<select
														id="address-country"
														name="country"
														data-region-target="address-region"
														aria-required={summary.addressRequired ? "true" : undefined}
														autocomplete="country"
														aria-invalid={fieldErrors.country !== undefined}
														aria-describedby={fieldErrors.country !== undefined ? "country-error country-note" : "country-note"}
													>
														<option value="">Choose a country…</option>
														{countries.map((option) => (
															<option value={option.code} selected={option.code === addressValues.country}>
																{option.label}
															</option>
														))}
													</select>
													{/* Re-renders the review with the chosen country's state/province
															list, keeping everything typed. Never places; `formnovalidate`,
															like Apply. */}
													<button
														type="submit"
														class="u-btn u-btn-ghost"
														name="intent"
														value="update-address"
														formnovalidate
														data-region-update
													>
														Update<span class="u-sr-only"> state / province list</span>
													</button>
												</div>
												{fieldErrors.country !== undefined && (
													<span class="checkout-field-error" id="country-error">
														{fieldErrors.country}
													</span>
												)}
												<span class="checkout-note" id="country-note" data-region-update>
													Changed the country? Select Update to see its states or provinces.
												</span>
											</div>
											<div class="checkout-field" data-region-field hidden={addressRegions.options.length === 0}>
												<label class="u-label" for="address-region">
													State / province
												</label>
												<select
													id="address-region"
													name="region"
													autocomplete="address-level1"
													aria-invalid={fieldErrors.region !== undefined}
													aria-describedby={fieldErrors.region !== undefined ? "region-error" : undefined}
												>
													<option value="">Choose a state / province…</option>
													{addressRegions.options.map((option) => (
														<option value={option.code} selected={option.code === addressRegions.selected}>
															{option.label}
														</option>
													))}
												</select>
												{fieldErrors.region !== undefined && (
													<span class="checkout-field-error" id="region-error">
														{fieldErrors.region}
													</span>
												)}
											</div>
										</>
									)}
									<div class="checkout-field checkout-span2">
										<label class="u-label" for="address-phone">
											Phone
										</label>
										<input
											type="tel"
											id="address-phone"
											name="phone"
											autocomplete="tel"
											maxlength={ORDER_ADDRESS_MAX_LENGTHS.phone}
											value={addressValues.phone}
											aria-invalid={fieldErrors.phone !== undefined}
											aria-describedby={fieldErrors.phone !== undefined ? "phone-error" : undefined}
										/>
										{fieldErrors.phone !== undefined && (
											<span class="checkout-field-error" id="phone-error">
												{fieldErrors.phone}
											</span>
										)}
									</div>
								</div>
							</fieldset>
						)
					}

					{
						chosenOption !== null && (
							<p class="checkout-note checkout-delivery-line">
								Delivery: {chosenOption.label} ({chosenOption.price})
							</p>
						)
					}

					{
						paymentConfigured ? (
							summary.readyToPlace ? (
								<div>
									<button type="submit" class="u-btn">
										Continue to payment
									</button>
								</div>
							) : (
								<Notice>{notReadyCopy}</Notice>
							)
						) : (
							/* Lead QUOTED from error-messages.ts's STRIPE_NOT_CONFIGURED
							   rather than restated here (§10). */
							<Notice lead={notConfiguredLead}>
								This order can't be placed. Nothing has been charged and your cart is unchanged.
							</Notice>
						)
					}
				</form>
			)
		}
	</section>

	<section class="checkout-panel">
		<div class="checkout-panel-head">
			<h2 class="u-label checkout-head-label">Your order</h2>
		</div>

		{
			summary.hasUnpricedLines && (
				<Notice>
					Live prices for some items are temporarily unavailable — the totals below come from
					the store and are what you will be charged.
				</Notice>
			)
		}

		<Ledger rows={ledgerRows} />
		<Sum
			rows={sumRows}
			total={summary.totals.total}
			excludesUncalculated={summary.totals.totalExcludesUncalculated}
			footnote={footnote}
			taxNote={summary.totals.taxIncludedNote}
		/>
	</section>
</div>

<p class="checkout-back"><a href="/cart">Back to cart</a></p>

