---
/**
 * Batch's checkout review: the printed tick-box track, then two labels on the
 * kraft — "Your details" (coupon, delivery, then the details and the one green
 * action, in the order a shopper answers them) and "Your order", printed like
 * the back of the bag, which stays in view on a wide screen. On a phone the
 * order follows the form. Inputs carry the brief's 1.5px ink stroke; every
 * error is printed on a label, never on the kraft.
 *
 * THE FORMS ARE THE PAGE'S CONTRACT, not this theme's: the same three sibling
 * forms, field names, autocomplete tokens, hidden fields and gates as every
 * theme's review (`checkout-theme.test.ts` sweeps each theme's view with the
 * same assertions). The coupon and delivery forms are GET navigations and are
 * never nested in the place form.
 *
 * Presentation only: `src/pages/checkout/index.astro` reads the cart, the
 * coupon and the destination, dispatches the summary, maps BUSY and every
 * refusal to copy, and decides the locked / ended arms.
 */
import type { CheckoutModel } from "../contract.js";
import Notice from "./Notice.astro";
import Receipt from "./Receipt.astro";
import StepTrack from "./StepTrack.astro";
import Totals from "./Totals.astro";

interface Props {
	model: CheckoutModel;
}

const {
	summary,
	errorMessage,
	checkedOut,
	locked,
	ended,
	couponValue,
	couponError,
	destinationError,
	shippingError,
	noOptionsCopy,
	destination,
	destinationName,
	countryValue,
	regionValue,
	countries,
	showDelivery,
	showAddress,
	chosenOption,
	notReadyCopy,
	paymentConfigured,
	notConfiguredLead,
	ledgerRows,
	sumRows,
	footnote,
} = Astro.props.model;
---

<div class="b-view">
	<div class="b-wrap b-page b-co">
		<div class="b-co-steps"><StepTrack current="details" /></div>
		<h1 class="b-h1 b-co-title">Checkout</h1>

		{errorMessage !== null && <div class="b-co-notice-slot"><Notice tone="error">{errorMessage}</Notice></div>}

		{
			locked !== null && (
				<div class="b-co-notice-slot">
					{ended ? (
						/* The `ended` phase — expired / failed — means NO LONGER PAYABLE,
						   not "never charged": a declined attempt fails the order while its
						   PaymentIntent stays confirmable, and a payment can land just after
						   the TTL sweep. The public order carries no reconciliation flag, so
						   this copy makes no claim about money either way — and promises no
						   particular outcome: reconciliation may refund OR fulfil the order. */
						<Notice lead="This checkout has ended.">
							Its order can no longer be paid. If a payment did go through, contact the store with
							your order number — shown on
							<a href={`/orders/${encodeURIComponent(locked.id)}`}>your order page</a> — and they
							will refund it or complete your order. Start a new cart to order again.
						</Notice>
					) : (
						<Notice lead="Your order has already been created.">
							Its coupon and delivery address can no longer be changed. To change them, start a new cart.
						</Notice>
					)}
				</div>
			)
		}

		{
			(checkedOut || locked !== null) && (
				<form method="POST" action="/checkout/new-cart" class="b-co-restart">
					<button type="submit" class="u-btn u-btn-ghost">
						Start a new cart
					</button>
				</form>
			)
		}

		<div class="b-co-cols">
			<section class="b-label b-co-panel">
				<div class="b-co-panel-head">
					<h2 class="u-label b-co-head-label">Your details</h2>
				</div>

				{/* The coupon comes FIRST, and is a SIBLING of the place form, never
				    nested in it: applying it is a GET navigation, which loses anything
				    typed below — so the natural order is "coupon, then details". */}
				{
					!summary.orderCreated && (
						<form method="GET" action="/checkout" class="b-co-coupon">
							{/* The delivery choice rides along, so applying a coupon keeps it. */}
							{destination !== null && (
								<input type="hidden" name="country" value={destination.country} />
							)}
							{destination?.region != null && (
								<input type="hidden" name="region" value={destination.region} />
							)}
							{summary.selection.shippingMethodId !== null && (
								<input type="hidden" name="method" value={summary.selection.shippingMethodId} />
							)}
							<div class="b-co-field">
								<label class="b-flabel" for="coupon">
									Coupon code
								</label>
								<div class="b-co-coupon-row">
									<input
										type="text"
										id="coupon"
										name="coupon"
										maxlength="200"
										autocomplete="off"
										value={couponValue}
										aria-describedby={couponError !== null ? "coupon-error coupon-note" : "coupon-note"}
									/>
									<button type="submit" class="u-btn u-btn-ghost">
										Apply
									</button>
								</div>
								{couponError !== null && (
									<div id="coupon-error">
										<Notice tone="error">{couponError}</Notice>
									</div>
								)}
								<span class="b-co-note" id="coupon-note">
									Codes are case-sensitive. Apply a code before filling in your details — applying it
									reloads this page.
									{summary.selection.couponCode !== null && (
										<>
											{" "}
											<a href="/checkout">Remove coupon</a>
										</>
									)}
								</span>
							</div>
						</form>
					)
				}

				{/* DELIVERY (ADR-0021) — a SIBLING GET form like the coupon's, never
				    nested: choosing where the order goes re-prices the review. */}
				{
					showDelivery && (
						<form method="GET" action="/checkout" class="b-co-delivery" id="delivery">
							<fieldset class="b-co-group">
								<legend class="u-label b-co-head-label">Delivery</legend>
								{destinationError !== null && (
									<Notice tone="error">{destinationError}</Notice>
								)}
								{shippingError !== null && <Notice tone="error">{shippingError}</Notice>}
								{summary.shipping.noOptions && (
									<Notice>{noOptionsCopy}</Notice>
								)}
								<div class="b-co-fields">
									<label class="b-co-field">
										<span class="b-flabel">Country</span>
										<select name="country" autocomplete="country" required>
											<option value="">Choose a country…</option>
											{countries.map((option) => (
												<option value={option.code} selected={option.code === countryValue}>
													{option.label}
												</option>
											))}
										</select>
									</label>
									<div class="b-co-field">
										<label class="b-flabel" for="delivery-region">
											State / province
										</label>
										<input
											type="text"
											id="delivery-region"
											name="region"
											autocomplete="address-level1"
											maxlength="6"
											pattern="([A-Za-z]{2}-)?[A-Za-z0-9]{1,3}"
											value={regionValue}
											aria-describedby="region-note"
										/>
										<span class="b-co-note" id="region-note">
											State/province code, e.g. CA — leave blank if your country doesn't use one.
										</span>
									</div>
								</div>
								{/* The destination these options were priced for: a changed country or
								    region drops a method chosen for the old one. */}
								<input type="hidden" name="fromCountry" value={destination?.country ?? ""} />
								<input type="hidden" name="fromRegion" value={destination?.region ?? ""} />
								{summary.selection.couponCode !== null && (
									<input type="hidden" name="coupon" value={summary.selection.couponCode} />
								)}
								{summary.shipping.status === "matched" && summary.shipping.options.length > 0 && (
									<div class="b-co-methods" role="radiogroup" aria-label="Delivery options">
										{summary.shipping.options.map((option) => (
											<label class="b-co-method">
												<input
													type="radio"
													name="method"
													value={option.id}
													disabled={option.disabled}
													checked={option.selected}
												/>
												<span>{option.label}</span>
												<span class="b-co-method-price">{option.price}</span>
											</label>
										))}
									</div>
								)}
								<div>
									<button type="submit" class="u-btn u-btn-ghost">
										Update delivery
									</button>
								</div>
							</fieldset>
						</form>
					)
				}

				{
					!ended && (
						<form method="POST" action="/checkout/place" class="b-co-details">
							{/* STABLE per cart (checkout:<cartId>), so a reload or a double-submit
							    replays into the SAME order and the same PaymentIntent instead of
							    minting a second order the CART_CHECKED_OUT fence would reject. */}
							<input type="hidden" name="idempotencyKey" value={summary.idempotencyKey} />
							{/* Exactly the coupon the totals beside this form were priced with;
							    the place re-checks it. Absent when none applied. */}
							{summary.selection.couponCode !== null && (
								<input type="hidden" name="couponCode" value={summary.selection.couponCode} />
							)}
							{/* The method the totals were priced with. NOT on the locked page: the
							    same-key place replays the order before it would look at one, and
							    the locked form sends key, email and coupon only. */}
							{locked === null && summary.selection.shippingMethodId !== null && (
								<input
									type="hidden"
									name="shippingMethodId"
									value={summary.selection.shippingMethodId}
								/>
							)}

							{/* The note is a SIBLING of the label, not inside it. Nested, its
							    ~25 words join the field's ACCESSIBLE NAME and get read out in
							    full every time the input takes focus; `aria-describedby` is how
							    a hint attaches — announced after the name, and as a hint. */}
							<div class="b-co-field">
								<label class="b-flabel" for="email">
									Email <span class="b-co-req">required</span>
								</label>
								<input
									type="email"
									id="email"
									name="email"
									required
									autocomplete="email"
									aria-describedby="email-note"
								/>
								<span class="b-co-note" id="email-note">
									We use this to send your order confirmation and to link the order to your account if
									you sign in later.
								</span>
							</div>

							{/* LOCKED: the order's ship-to is fixed — a same-key place replays the
							    order and would silently drop an address typed here. The email above
							    stays: place.ts requires it. A digital-only cart ships nothing. */}
							{
								showAddress && (
									<fieldset class="b-co-group">
										<legend class="u-label b-co-head-label">Delivery address</legend>
										{showDelivery ? (
											<>
												{/* The destination the review priced, as hidden fields: place.ts
												    counts only the typed fields toward all-or-nothing here. */}
												<input type="hidden" name="addressMode" value="zoned" />
												{destination !== null && (
													<>
														<input type="hidden" name="country" value={destination.country} />
														{destination.region !== null && (
															<input type="hidden" name="region" value={destination.region} />
														)}
														<p class="b-co-note b-co-group-note">
															Delivering to {destinationName}
															{destination.region !== null && <>, {destination.region}</>} —{" "}
															<a href="#delivery">change</a>
														</p>
													</>
												)}
											</>
										) : (
											<p class="b-co-note b-co-group-note">
												Optional — fill it in completely, or leave it entirely blank.
											</p>
										)}
										<div class="b-co-fields">
											<label class="b-co-field b-co-span2">
												<span class="b-flabel">
													Full name{summary.addressRequired && <span class="b-co-req">required</span>}
												</span>
												<input type="text" name="name" autocomplete="name" />
											</label>
											<label class="b-co-field b-co-span2">
												<span class="b-flabel">
													Address line 1
													{summary.addressRequired && <span class="b-co-req">required</span>}
												</span>
												<input type="text" name="line1" autocomplete="address-line1" />
											</label>
											<label class="b-co-field b-co-span2">
												<span class="b-flabel">Address line 2</span>
												<input type="text" name="line2" autocomplete="address-line2" />
											</label>
											<label class="b-co-field">
												<span class="b-flabel">
													City{summary.addressRequired && <span class="b-co-req">required</span>}
												</span>
												<input type="text" name="city" autocomplete="address-level2" />
											</label>
											<label class="b-co-field">
												<span class="b-flabel">
													Postal code{summary.addressRequired && <span class="b-co-req">required</span>}
												</span>
												<input type="text" name="postalCode" autocomplete="postal-code" />
											</label>
											{!showDelivery && (
												<>
													<label class="b-co-field">
														<span class="b-flabel">Country</span>
														<select name="country" autocomplete="country">
															<option value="">Choose a country…</option>
															{countries.map((option) => (
																<option value={option.code}>{option.label}</option>
															))}
														</select>
													</label>
													<label class="b-co-field">
														<span class="b-flabel">State / province code</span>
														<input
															type="text"
															name="region"
															autocomplete="address-level1"
															maxlength="6"
															pattern="([A-Za-z]{2}-)?[A-Za-z0-9]{1,3}"
														/>
													</label>
												</>
											)}
											<label class="b-co-field b-co-span2">
												<span class="b-flabel">Phone</span>
												<input type="tel" name="phone" autocomplete="tel" />
											</label>
										</div>
									</fieldset>
								)
							}

							{
								chosenOption !== null && locked === null && (
									<p class="b-co-note b-co-delivery-line">
										Delivery: {chosenOption.label} ({chosenOption.price})
									</p>
								)
							}

							{
								paymentConfigured ? (
									summary.readyToPlace ? (
										<div>
											<button type="submit" class="u-btn b-co-go">
												Continue to payment
											</button>
										</div>
									) : (
										<Notice>{notReadyCopy}</Notice>
									)
								) : locked !== null ? (
									/* LOCKED: an order exists and the cart is checked out, so the
									   unlocked copy's "nothing has been charged" and "your cart is
									   unchanged" would both be wrong here. */
									<Notice>
										Card payment isn't set up on this store, so this order can't be paid right now.
									</Notice>
								) : (
									/* Lead QUOTED from error-messages.ts's STRIPE_NOT_CONFIGURED
									   rather than restated here (§10). */
									<Notice lead={notConfiguredLead}>
										This order can't be placed. Nothing has been charged and your cart is unchanged.
									</Notice>
								)
							}
						</form>
					)
				}
			</section>

			<section class="b-label b-co-panel b-co-summary">
				<div class="b-co-panel-head">
					<h2 class="u-label b-co-head-label">Your order</h2>
				</div>

				{
					summary.hasUnpricedLines && (
						<Notice>
							Live prices for some items are temporarily unavailable — the totals below come from
							the store and are what you will be charged.
						</Notice>
					)
				}

				<Receipt rows={ledgerRows} />
				<Totals
					rows={sumRows}
					total={summary.totals.total}
					excludesUncalculated={summary.totals.totalExcludesUncalculated}
					footnote={footnote}
				/>
			</section>
		</div>

		<p class="b-co-back"><a class="b-link" href="/cart">Back to your bag</a></p>
	</div>
</div>

