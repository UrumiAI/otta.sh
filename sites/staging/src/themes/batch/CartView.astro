---
/**
 * Batch's bag page (theme-briefs.md §3): each line is its product, drawn as it
 * is on the shelf — the bag at 3:4, square-cornered on the kraft — with its
 * printed label laid over the picture's edge, carrying the name in slab, the
 * money, the quantity and the hold. Beside the lines (below them on a phone)
 * one more label: the summary, with the one green action, "Check out".
 *
 * THE STAMP. The newest live hold is stamped — "Set aside for you until
 * 4:52 pm UTC" in roaster-green rubber-stamp ink. It LANDS on the label on
 * the render after the add (`isFreshHold`; CSS only, see `HoldRibbon.astro`);
 * otherwise it is simply there. Only that one line is
 * stamped (brief "Never: stamp more than one thing per view"); the others print
 * their hold in plain green words. `stamp.ts` picks the line.
 *
 * `/cart` is the one page that COUNTS DOWN: each line's hold carries the
 * contract's `data-hold*` hooks, and `components/HoldClock.astro`, which the
 * PAGE renders, keeps them current. No script lives in a view (ADR-0012).
 *
 * Presentation only: `src/pages/cart/index.astro` decides every arm (empty /
 * degraded / terminal / live), mints the per-form keys, and composes every
 * money string. The arms are written in the page's order — empty, terminal,
 * live — and a degraded read is never drawn as an empty bag. Rust (an error)
 * is only ever printed on a label, never on the kraft (brief "Never").
 */
import {
	CART_CHECKED_OUT_BODY,
	CART_CHECKED_OUT_TITLE,
	CART_NEW_CART_CONSEQUENCE,
	CART_NO_ORDER_LINK,
	CART_RESUME_PURPOSE,
} from "../../lib/cart-view.js";
import { isUncalculated, isUnpricedText, sumRowText } from "../../lib/totals.js";
import type { CartModel } from "../contract.js";
import Art from "./Art.astro";
import HoldRibbon from "./HoldRibbon.astro";
import Notice from "./Notice.astro";
import QtyInput from "./QtyInput.astro";
import { stampedLineId } from "./stamp.js";

interface Props {
	model: CartModel;
}

const {
	summary,
	errorMessage,
	degraded,
	degradedLead,
	pricingNotice,
	empty,
	terminal,
	placedOrderId,
	lineViews,
	sumRows,
	partialNote,
} = Astro.props.model;

/* The one line this view stamps: the newest live hold. */
const stampedId = stampedLineId(lineViews.map((view) => view.line));

/* The subtotal leads the summary. Any further row that carries a FIGURE is
   printed under it; a prose row ("Shipping: At checkout") is already said, in
   full, by the summary's shipping-and-tax line, so it is not said twice. */
const [lead, ...others] = sumRows;
const figureRows = others.filter((row) => !isUncalculated(row.amount));
---

<div class="b-view">
	<div class="b-wrap b-page">
		<header class="b-bar">
			<h1 class="b-h1">Your bag</h1>
			{summary !== null && <p class="b-bar-meta">{summary}</p>}
		</header>

		{
			errorMessage !== null && (
				<div class="b-notice-slot b-narrow">
					<Notice tone="error">{errorMessage}</Notice>
				</div>
			)
		}
		{
			degraded && (
				<div class="b-notice-slot b-narrow">
					<Notice lead={degradedLead}>We haven't changed anything. Try again in a moment.</Notice>
				</div>
			)
		}
		{
			pricingNotice && (
				<div class="b-notice-slot b-narrow">
					<Notice lead="Totals are unavailable right now.">
						Your quantities and your holds are still exact.
					</Notice>
				</div>
			)
		}

		{
			empty ? (
				!degraded && (
					<div class="b-label b-empty b-bag-empty">
						<h2 class="b-title">Nothing set aside yet.</h2>
						<p class="b-lede">
							Anything you put in your bag is set aside for you while you check out.
						</p>
						<a href="/products" class="u-btn">
							See what's on the shelf
						</a>
					</div>
				)
			) : terminal ? (
				<div class="b-cart-terminal">
					<div class="b-label b-terminal-label">
						<h2 class="b-title">{CART_CHECKED_OUT_TITLE}</h2>
						<p class="b-terminal-body">{CART_CHECKED_OUT_BODY}</p>

						<ul class="b-receipt b-terminal-lines" role="list">
							{lineViews.map((view) => (
								<li class="b-receipt-line" role="listitem">
									<span class="b-receipt-id">
										{view.title !== null && <span class="b-receipt-name">{view.title}</span>}
										<span class="b-receipt-meta">{view.line.sku}</span>
									</span>
									<span class="b-receipt-meta">Qty {view.line.qty}</span>
								</li>
							))}
						</ul>

						<div class="b-terminal-actions">
							{placedOrderId !== null && (
								<a href={`/orders/${encodeURIComponent(placedOrderId)}`} class="u-btn">View your order</a>
							)}

							{placedOrderId === null && (
								<div class="b-terminal-resume">
									<a href="/checkout" class="u-btn">Return to this checkout</a>
									<p class="b-terminal-note">{CART_RESUME_PURPOSE}</p>
									<p class="b-terminal-note">{CART_NO_ORDER_LINK}</p>
								</div>
							)}

							<div class="b-cart-terminal-restart">
								<form method="POST" action="/checkout/new-cart">
									<button type="submit" class="u-btn u-btn-ghost">Start a new cart</button>
								</form>
								<p class="b-terminal-note">{CART_NEW_CART_CONSEQUENCE}</p>
							</div>
						</div>
					</div>
				</div>
			) : (
				<div class="b-cart">
					<ul class="b-cart-lines" role="list">
						{lineViews.map((view) => (
							<li class="b-cart-line" role="listitem">
								<div class="b-cart-pic">
									<Art seed={view.artKey} title={view.title ?? ""} image={view.image} id={`line${view.index}`} />
								</div>
								<div class="b-label b-cart-label">
									<div class="b-cart-top">
										<div class="b-cart-id">
											<p class="b-cart-name">{view.title ?? view.line.sku}</p>
											{view.title !== null && <p class="b-cart-sku">{view.line.sku}</p>}
										</div>
										<div class="b-cart-money">
											{isUnpricedText(view.money) ? (
												<span class="b-cart-prose">{view.money}</span>
											) : (
												<span class="b-cart-price b-figures">{view.money}</span>
											)}
											{view.each !== null && <span class="b-cart-each b-figures">{view.each}</span>}
										</div>
									</div>
									<HoldRibbon
										expiresAt={view.line.expiresAt}
										seed={view.line.lineId}
										stamped={view.line.lineId === stampedId}
									/>
									<div class="b-cart-ctl">
										<form method="POST" action="/cart/update" class="b-cart-update">
											<input type="hidden" name="lineId" value={view.line.lineId} />
											<input type="hidden" name="idempotencyKey" value={view.updateKey} />
											<QtyInput value={view.line.qty} label={`Quantity, ${view.name}`} />
											<button type="submit" class="b-textcontrol">
												Update<span class="u-sr-only"> {view.name}</span>
											</button>
										</form>
										<form method="POST" action="/cart/remove">
											<input type="hidden" name="lineId" value={view.line.lineId} />
											<input type="hidden" name="idempotencyKey" value={view.removeKey} />
											<button type="submit" class="b-textcontrol">
												Remove<span class="u-sr-only"> {view.name}</span>
											</button>
										</form>
									</div>
								</div>
							</li>
						))}
					</ul>

					<aside class="b-label b-cart-sum" aria-labelledby="b-cart-sum-title">
						<h2 class="b-cart-sum-title" id="b-cart-sum-title">
							Summary
						</h2>
						{lead !== undefined && (
							<p class="b-sub" data-prose={isUncalculated(lead.amount) ? "" : undefined}>
								<span>{lead.label}</span>
								<span class="b-sub-figure b-figures">{sumRowText(lead)}</span>
							</p>
						)}
						{figureRows.map((row) => (
							<p class="b-sub b-sub-minor">
								<span>{row.label}</span>
								<span class="b-figures">{sumRowText(row)}</span>
							</p>
						))}
						{partialNote !== null && <p class="b-sub-note">{partialNote}</p>}
						<p class="b-sub-note">Shipping and tax are worked out at checkout.</p>
						<a href="/checkout" class="u-btn b-cart-go">
							Check out
						</a>
						<p class="b-sub-fine">
							Prices are live and may change; your total is confirmed at checkout.
						</p>
					</aside>
				</div>
			)
		}
	</div>
</div>
