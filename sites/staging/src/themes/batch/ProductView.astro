---
/**
 * Batch's product page (brief "Layout (d)"): the picture at 3:4 on the left
 * half, and on the right a printed label laid over the picture's edge by 48px
 * — the whole buying decision on one piece of paper. The label's head is
 * centred (title in slab, the description beneath); the facts beneath it read
 * left-aligned, as a spec printed on a bag does; then, centred again, the price
 * in slab, the green "Add to bag" and the hold, in plain words.
 *
 * On a phone the picture goes full-bleed and the label rides up over it by
 * 40px as a sheet. There is NO sticky buy bar: the label is short enough that
 * the button is on the first screen, and nothing ever covers the text.
 *
 * "Add to bag" is the plain form POST every theme shares (`AddToCartFields`);
 * `/cart/add` answers it with a redirect to the bag. The press is acknowledged
 * by the button sinking 1px (theme.css, CSS only). The brief's green stamp —
 * "Set aside for you until 4:52 pm" — lands on the bag page (`HoldRibbon.astro`,
 * `commerce.css`), so here the hold is the static sentence the page computed.
 *
 * Not drawn: the brief's Size/Grind tick-boxes (the store has no variant
 * surface yet — controls that change nothing are worse than none) and the
 * "for 250 g" beside the price (the store carries no weight; the price is
 * shown alone rather than beside an invented one).
 *
 * Presentation only: `src/pages/products/[slug].astro` owns the reads, the
 * 404/503 status, BUSY, the error token, the idempotency key and the return
 * path.
 */
import AddToCartFields from "../../forms/AddToCartFields.astro";
import type { ProductModel } from "../contract.js";
import Art from "./Art.astro";
import { stampTilt } from "./art.js";
import Notice from "./Notice.astro";

interface Props {
	model: ProductModel;
}

const { model } = Astro.props;
---

<div class="b-view">
	{
		model.state === "unavailable" ? (
			<div class="b-wrap b-shop">
				<div class="b-label b-empty">
					<h1 class="b-title">This product is unavailable.</h1>
					<p class="b-lede">The shop could not be read just now. Try again in a moment.</p>
					<a class="u-btn u-btn-ghost" href="/products">
						Back to the shop
					</a>
				</div>
			</div>
		) : model.state === "notFound" ? (
			<div class="b-wrap b-shop">
				<div class="b-label b-empty">
					<h1 class="b-title">Product not found.</h1>
					<p class="b-lede">Nothing is on the shelf under that address.</p>
					<a class="u-btn u-btn-ghost" href="/products">
						Back to the shop
					</a>
				</div>
			</div>
		) : (
			<>
				{model.degradedLead !== null && (
					<div class="b-wrap b-notice-slot b-notice-top">
						<Notice lead={model.degradedLead}>
							Check back in a moment. Everything else on this page is up to date.
						</Notice>
					</div>
				)}

				<div class="b-wrap b-pdp">
					<div class="b-pdp-media" data-sold-out={model.dimmed ? "" : undefined}>
						<Art
							seed={model.art}
							title={model.title}
							image={model.image}
							alt={model.title}
							eager
							id="pdp"
						/>
						{model.dimmed && (
							<span class="b-stamp" data-tone="muted" style={`--b-tilt: ${stampTilt(model.art)}deg`}>
								<span class="b-stamp-ink">Sold out</span>
							</span>
						)}
					</div>

					<div class="b-label b-pdp-label">
						<div class="b-centre">
							<h1 class="b-title">{model.title}</h1>
							{model.description && <p class="b-notes">{model.description}</p>}
						</div>

						{model.purchase !== null && (model.purchase.availability !== null || model.purchase.sku !== null) && (
							<table class="b-spec">
								<tbody>
									{model.purchase.availability !== null && (
										<tr>
											<th scope="row">Stock</th>
											<td>{model.purchase.availability === "in_stock" ? "In stock" : "Sold out"}</td>
										</tr>
									)}
									{model.purchase.sku !== null && (
										<tr>
											<th scope="row">SKU</th>
											<td class="b-figures">{model.purchase.sku}</td>
										</tr>
									)}
								</tbody>
							</table>
						)}

						{model.errorMessage !== null && (
							<div class="b-notice-slot">
								<Notice tone="error">{model.errorMessage}</Notice>
							</div>
						)}

						{model.purchase !== null && (
							<div class="b-centre b-buy">
								<p class="b-price b-figures">
									{model.purchase.priceStruck ? (
										<s>{model.purchase.priceFormatted}</s>
									) : (
										model.purchase.priceFormatted
									)}
								</p>

								{model.purchase.addToCart !== null && (
									<form class="b-buyform" method="POST" action="/cart/add">
										<AddToCartFields fields={model.purchase.addToCart} />
										<div class="b-buyrow">
											<label class="b-qty">
												<span class="b-qty-name">Quantity</span>
												<input
													class="b-field"
													type="number"
													name="qty"
													value="1"
													min="1"
													inputmode="numeric"
												/>
											</label>
											<button class="u-btn b-add" type="submit">
												Add to bag
											</button>
										</div>
										<p class="b-hold">{model.purchase.holdNote}</p>
									</form>
								)}

								{model.purchase.soldOut && (
									<>
										<button class="u-btn b-add" type="button" disabled>
											Sold out
										</button>
										<p class="b-hold">
											This batch has gone.{" "}
											<a class="b-link" href="/products">
												See what's on the shelf
											</a>
										</p>
									</>
								)}
							</div>
						)}

						{model.showNotForSale && (
							<p class="b-centre b-hold">Not currently available for purchase</p>
						)}
					</div>
				</div>
			</>
		)
	}
</div>
