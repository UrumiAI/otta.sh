---
/**
 * Batch's notice: a label, never kraft (brief: an error appears on a label
 * surface only — rust fails AA on kraft). The lead is set in slab; the rest is
 * body text. `tone="error"` prints the lead in rust with a rust rule above it
 * and makes it an alert; the default is plain information in ink.
 */
interface Props {
	lead?: string | null;
	tone?: "info" | "error";
}

const { lead = null, tone = "info" } = Astro.props;
---

<div class="b-label b-notice" data-tone={tone} role={tone === "error" ? "alert" : "status"}>
	{lead !== null && <p class="b-notice-lead">{lead}</p>}
	<p class="b-notice-body"><slot /></p>
</div>
