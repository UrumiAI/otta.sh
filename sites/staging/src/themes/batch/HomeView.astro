---
/**
 * Batch's home (brief "Layout (b)"): one bag, big, at 3:4 — and its label
 * riding over the picture's edge by 48px, carrying the store's own thesis,
 * the lede and the way into the shop. Then the shelf: every product the page
 * fetched, 3-up, each bag with its label overlapping.
 *
 * THE BAG is the catalog's first product — its photograph when it has one,
 * otherwise its generated kraft bag — and the label says so ("Pictured: …"),
 * linked, so the picture is never an unexplained decoration. With no products
 * at all (the content read failed) the bag is blank and nothing is pictured.
 *
 * The brief's hero "Add to bag" is not drawn: adding needs the product page's
 * sku, id and idempotency key, which the home model does not (and should not)
 * carry. The hero's action is the way into the shop.
 *
 * DEGRADED: no cards leaves the hero alone — no shelf, and no error box, the
 * same rule as Tempered's tapeless hero. Presentation only:
 * `src/pages/index.astro` builds the model.
 */
import type { HomeModel } from "../contract.js";
import Art from "./Art.astro";
import Card from "./Card.astro";

interface Props {
	model: HomeModel;
}

const { model } = Astro.props;
const lead = model.cards[0] ?? null;
---

<div class="b-view b-home">
	<section class="b-wrap b-hero" aria-labelledby="b-hero-title">
		<div class="b-hero-media">
			{
				lead !== null ? (
					<Art seed={lead.slug} title={lead.title} image={lead.image} eager id="hero" />
				) : (
					<Art seed={model.thesis} title="" image={null} eager id="hero" />
				)
			}
		</div>
		<div class="b-label b-hero-label">
			<h1 id="b-hero-title" class="b-title">{model.thesis}</h1>
			<p class="b-lede">{model.lede}</p>
			<a class="u-btn b-add" href={model.shopHref}>{model.shopLabel}</a>
			{
				lead !== null && (
					<p class="b-pictured">
						Pictured:{" "}
						<a class="b-link" href={lead.href}>
							{lead.title}
						</a>
						{lead.price !== null && <span class="b-figures">, {lead.price}</span>}
					</p>
				)
			}
		</div>
	</section>

	{
		model.cards.length > 0 && (
			<section class="b-wrap b-shelf" aria-labelledby="b-shelf-title">
				<div class="b-sec">
					<h2 id="b-shelf-title" class="b-h2">
						On the shelf
					</h2>
					<a class="b-link" href={model.shopHref}>
						{model.shopLabel}
					</a>
				</div>
				<div class="b-grid">
					{model.cards.map((card) => (
						<Card card={card} headingLevel={3} />
					))}
				</div>
			</section>
		)
	}
</div>
