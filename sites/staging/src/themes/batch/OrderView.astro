---
/**
 * Batch's order confirmation: one printed label, like the back of the bag it
 * will arrive in. Its head is centred (the one centred block the theme allows):
 * the order's reference in small Karla, then the order's OWN state as the
 * largest slab on the page, the body, and what you can do next. Beneath it,
 * two more labels — the items and the totals.
 *
 * No stamp here: the bag page's green stamp is the theme's one authored moment,
 * and a stamp that claimed a state ("Paid") would be the theme deciding
 * something only the page may say. The headline is the page's answer.
 *
 * Presentation only: `src/pages/orders/[orderId].astro` reads the order,
 * deletes the checkout stash, sets 404/503, picks the copy for the order's
 * state, and runs the bounded meta-refresh poll (the `<meta>` tags are the
 * page's, and so is `no-referrer`). Stripe's redirect parameters never reach
 * this file: the page reads them to choose between two copy variants and hands
 * over only the words (`checkout-client-js.test.ts` 10c sweeps this view).
 *
 * ZERO client JavaScript (ADR-0012): the "still checking" line is the shared,
 * script-free `PollRibbon`, never the bag's countdown.
 */
import PollRibbon from "../../components/PollRibbon.astro";
import type { OrderModel } from "../contract.js";
import Notice from "./Notice.astro";
import Receipt from "./Receipt.astro";
import StepTrack from "./StepTrack.astro";
import Totals from "./Totals.astro";

interface Props {
	model: OrderModel;
}

const {
	order,
	stamp,
	failureMessage,
	shouldPoll,
	pollHop,
	pollMax,
	nextPollUrl,
	hasActions,
	canCheckAgain,
	canResume,
	deadEnd,
	ledgerRows,
	sumRows,
	totalLabel,
} = Astro.props.model;
---

<div class="b-view">
	<div class="b-wrap b-page b-order-page">
		{
			order === null || stamp === null ? (
				<div class="b-label b-empty">
					{/* No step track: it would claim a journey (bag, details, payment)
					    the visitor never made for an order that does not exist. */}
					<h1 class="b-title">Order</h1>
					<div class="b-order-alert">
						<Notice tone="error">{failureMessage}</Notice>
					</div>
					<a class="u-btn u-btn-ghost" href="/products">
						Browse products
					</a>
				</div>
			) : (
				<>
					<div class="b-co-steps"><StepTrack current="order" /></div>

					<header class="b-label b-order-head" data-state={order.state}>
						<p class="b-order-ref">
							Order <span class="b-order-id">{order.id}</span>
						</p>
						<h1 class="b-title b-order-title">{stamp.headline}</h1>
						{stamp.body !== null && <p class="b-order-body">{stamp.body}</p>}
						{shouldPoll && (
							<div class="b-order-poll">
								<PollRibbon poll={pollHop} pollMax={pollMax} />
							</div>
						)}
						{hasActions && (
							<div class="b-order-actions">
								{canResume && (
									<a class="u-btn" href="/checkout">
										Complete payment
									</a>
								)}
								{canCheckAgain && (
									<a class="u-btn u-btn-ghost" href={nextPollUrl}>
										Check again
									</a>
								)}
								{deadEnd && (
									<a class="u-btn u-btn-ghost" href="/cart">
										Go to your cart
									</a>
								)}
							</div>
						)}
						<p class="b-order-keep">Keep this link to check its status.</p>
					</header>

					<div class="b-order-cols">
						<section class="b-label b-order-panel">
							<h2 class="u-label b-order-head-label">Items</h2>
							<Receipt rows={ledgerRows} />
							{order.fulfillment !== null && (
								<p class="b-order-ship">
									Shipped with {order.fulfillment.carrier}, tracking{" "}
									<span class="b-order-id">{order.fulfillment.trackingNumber}</span>
								</p>
							)}
						</section>

						<section class="b-label b-order-panel">
							<h2 class="u-label b-order-head-label">Totals</h2>
							<Totals
								rows={sumRows}
								total={order.totals.total}
								totalLabel={totalLabel}
								excludesUncalculated={order.totals.totalExcludesUncalculated}
							/>
						</section>
					</div>
				</>
			)
		}
	</div>
</div>
