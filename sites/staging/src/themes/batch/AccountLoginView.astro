---
/**
 * Batch's sign-in (issue #306, ADR-0004): one printed label on the kraft, its
 * head centred — one email field, magic link only. Presentation only —
 * `src/pages/account/login/index.astro` sets the no-store header, reads `?sent`
 * / `?error`, and hands over the copy. The `sent` notice is the SAME sentence
 * for every address, so the page is not an account oracle; a theme may restyle
 * it and must not vary it.
 */
import type { AccountLoginModel } from "../contract.js";
import Notice from "./Notice.astro";

interface Props {
	model: AccountLoginModel;
}

const { sent, sentCopy, errorMessage } = Astro.props.model;
---

<div class="b-view">
	<div class="b-wrap b-page">
		<div class="b-label b-acct">
			<div class="b-centre">
				<h1 class="b-title">Sign in</h1>
				<p class="b-lede">
					We'll email you a link that signs you in, no password. Orders you placed as a guest with
					the same address appear in your account once you sign in.
				</p>
			</div>

			{
				sent && (
					<div class="b-notice-slot">
						<Notice lead="Check your inbox.">{sentCopy}</Notice>
					</div>
				)
			}
			{
				errorMessage !== null && (
					<div class="b-notice-slot">
						<Notice tone="error">{errorMessage}</Notice>
					</div>
				)
			}

			<form method="POST" action="/account/login/request" class="b-acct-form">
				<div class="b-co-field">
					<label class="b-flabel" for="email">Email</label>
					<input type="email" id="email" name="email" required autocomplete="email" />
				</div>
				<button type="submit" class="u-btn b-co-go">Email me a sign-in link</button>
			</form>
		</div>
	</div>
</div>
