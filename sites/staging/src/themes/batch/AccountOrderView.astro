---
/**
 * Batch's view of one of a signed-in customer's orders (issue #306): the order
 * as a printed label — its reference and state at the head, then the lines as
 * bought (the purchase-time snapshot — title and price — which is what a
 * receipt must show) and the totals. Presentation only —
 * `src/pages/account/orders/[id].astro` reads through the session route
 * (NOT_FOUND for an order that is not theirs, the same answer as for one that
 * does not exist), sets the status and the no-store header, and formats every
 * figure.
 */
import { isUnpricedText } from "../../lib/totals.js";
import type { AccountOrderModel } from "../contract.js";
import Notice from "./Notice.astro";
import Receipt from "./Receipt.astro";

interface Props {
	model: AccountOrderModel;
}

const { order, errorMessage } = Astro.props.model;
---

<div class="b-view">
	<div class="b-wrap b-page b-order-page">
		<nav class="b-crumb" aria-label="Breadcrumb">
			<a href="/account/orders">Your orders</a>
			<span aria-hidden="true">/</span>
			<span aria-current="page">{order === null ? "Order" : order.id}</span>
		</nav>

		{
			order === null ? (
				<div class="b-label b-empty">
					<h1 class="b-title">Order</h1>
					<div class="b-order-alert">
						<Notice tone="error">{errorMessage}</Notice>
					</div>
				</div>
			) : (
				<>
					<header class="b-label b-order-head">
						<p class="b-order-ref">
							Order <span class="b-order-id">{order.id}</span>
						</p>
						<h1 class="b-title b-order-title">{order.state}</h1>
					</header>

					<div class="b-order-cols">
						<section class="b-label b-order-panel">
							<h2 class="u-label b-order-head-label">Items</h2>
							<Receipt rows={order.ledgerRows} />
						</section>

						<section class="b-label b-order-panel">
							<h2 class="u-label b-order-head-label">Totals</h2>
							<dl class="b-totals">
								{order.totals.map((row) => (
									<div class="b-totals-row" data-prose={isUnpricedText(row.value) ? "" : undefined}>
										<dt>{row.label}</dt>
										<dd class="b-figures">{row.value}</dd>
									</div>
								))}
								<div class="b-totals-row b-totals-grand">
									<dt>Total</dt>
									<dd class="b-figures">{order.total}</dd>
								</div>
							</dl>
						</section>
					</div>
				</>
			)
		}
	</div>
</div>
