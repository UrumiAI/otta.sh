---
/**
 * Where the shopper is in checkout, as Batch prints it: four printed tick-boxes
 * (brief "Shape and surface": 3px corners, the 1.5px ink stroke) — ticked for
 * the steps behind you, ringed in green for the one you are on, blank ahead.
 * The steps and their order are the shared `CHECKOUT_STEPS` (the list every
 * theme's track draws), so no theme can invent a step. A real ordered list,
 * with `aria-current="step"` on the one you are on; the boxes are decoration.
 */
import { CHECKOUT_STEPS, type CheckoutStep } from "../../components/StepTrack.astro";

interface Props {
	current: CheckoutStep;
}

const { current } = Astro.props;
const currentIndex = CHECKOUT_STEPS.findIndex((step) => step.id === current);
---

<ol class="b-steps" aria-label="Checkout progress">
	{
		CHECKOUT_STEPS.map((step, index) => (
			<li
				class="b-step"
				data-done={index < currentIndex ? "" : undefined}
				aria-current={index === currentIndex ? "step" : undefined}
			>
				<span class="b-tick" aria-hidden="true">
					{index < currentIndex && (
						<svg viewBox="0 0 16 16" focusable="false">
							<path d="M3.5 8.5l3 3 6-7" />
						</svg>
					)}
				</span>
				{step.label}
			</li>
		))
	}
</ol>
