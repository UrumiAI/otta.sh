---
/**
 * Base layout — the "Tempered" chrome (docs/theme/TEMPERED.md §2–§3, §11).
 *
 * ADR-0003 is unchanged: the plugin serves JSON view models, this theme owns
 * every byte of markup. Nothing here calls commerce — the cart count arrives
 * as a PROP from the page that already read the cart, so the layout never puts
 * the service on the critical path of a page that would otherwise make no
 * commerce call at all.
 *
 * All colour and type comes from src/styles/tokens.css. The three faces are
 * self-hosted through Astro's font API (see `fonts` in astro.config.ts) —
 * downloaded at build time, served from this origin, no CDN at runtime.
 */
import { Font } from "astro:assets";
import { getMenu, getSiteSettings } from "emdash";
import { cartCountLabel, isCartLink } from "../lib/nav.js";
import "../styles/tokens.css";
// TRANSITIONAL — goes away with the last page migration. See the file.
import "../styles/legacy-bridge.css";

interface Props {
	title: string;
	description?: string | null;
	/**
	 * Units in the cart, for the nav badge. `null`/omitted renders the nav
	 * item bare — "no cart read on this page" and "an empty cart" are
	 * different facts and must not both render as `(0)`.
	 */
	cartCount?: number | null;
	/**
	 * The store's currency CODE, from a view model that already knows it
	 * (§7: the layout never invents anything money-shaped, and it cannot know
	 * the currency on its own). `null`/omitted renders no currency at all.
	 *
	 * Absence is meaningful and is why this is not defaulted: the pages that
	 * pass nothing — home, the catalog index, 404 — are the ones that read no
	 * money. A page that shows a price shows the currency; a page that shows
	 * none says nothing. /checkout/pay passes whatever its cookie stash holds:
	 * the code beside the place-time total when the stash carries one, and
	 * nothing when it does not, because then the button names no amount either.
	 */
	currency?: string | null;
}

const { title, description, cartCount = null, currency = null } = Astro.props;
const settings = (await getSiteSettings()) as { title?: string; tagline?: string };
const siteTitle = settings.title ?? "Urumi";
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;
const menu = await getMenu("primary");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		{/* Both palettes are real (tokens.css), so tell the UA — otherwise
		    scrollbars and native form controls stay light on a dark page. */}
		<meta name="color-scheme" content="light dark" />
		<title>{fullTitle}</title>
		{description && <meta name="description" content={description} />}
		{/* Only the two faces that set real text above the fold are preloaded.
		    The data face currently renders two short chrome strings, so
		    preloading it competes with them for bandwidth for no gain; the
		    preload comes back in increment 4, when money and the cart's hold
		    countdown make it a first-paint face. */}
		<Font cssVariable="--u-face-display" preload />
		<Font cssVariable="--u-face-body" preload />
		<Font cssVariable="--u-face-data" />
		{/* Per-page <head> additions. Used by the confirmation page for its
		    `referrer: no-referrer` policy and its bounded meta-refresh poll:
		    both MUST be in <head> to take effect, and both belong to that page
		    rather than to every page, so they arrive through this slot. */}
		<slot name="head" />
		{/* The coil (§5): an Archimedean spiral swept as a ribbon, the same
		    shape language the product art uses. Inline so there is no second
		    request and no public/ asset to rot. */}
		<link
			rel="icon"
			type="image/svg+xml"
			href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23131A20'/%3E%3Cpath d='M 17.4 15.6 L 18.0 16.2 L 18.2 17.1 L 18.0 18.1 L 17.2 19.1 L 15.9 19.7 L 14.3 19.7 L 12.8 18.9 L 11.6 17.5 L 11.2 15.6 L 11.6 13.5 L 13.1 11.7 L 15.3 10.6 L 18.0 10.5 L 20.7 11.6 L 22.7 13.7 L 23.7 16.7 L 23.3 19.9 L 21.3 22.8 L 18.2 24.8 L 14.3 25.3 L 10.3 24.1 L 7.1 21.4 L 5.3 17.4 L 5.4 12.9 L 7.6 8.7 L 11.5 5.6 L 16.6 4.4 L 22.0 5.3 L 26.6 8.4 L 29.6 13.3 L 25.0 14.3 L 23.1 11.0 L 20.0 8.9 L 16.4 8.2 L 12.9 8.9 L 10.1 11.0 L 8.5 13.9 L 8.4 17.1 L 9.6 20.0 L 11.9 22.0 L 14.7 22.9 L 17.6 22.6 L 20.0 21.2 L 21.5 19.0 L 21.9 16.6 L 21.2 14.3 L 19.6 12.7 L 17.6 11.8 L 15.5 11.9 L 13.7 12.7 L 12.6 14.1 L 12.2 15.8 L 12.6 17.3 L 13.5 18.4 L 14.7 18.9 L 15.9 18.9 L 16.9 18.4 L 17.4 17.7 L 17.6 16.9 L 17.3 16.3 L 16.8 15.9 Z' fill='%23E0AC3A'/%3E%3C/svg%3E"
		/>
	</head>
	<body>
		{/* The shell wrapper is what aligns the skip link with the header
		    content once it drops into flow on focus. */}
		<div class="shell skip-shell">
			<a href="#main" class="skip-link">Skip to the main content</a>
		</div>
		<header class="head">
			<div class="shell head-row">
				<a href="/" class="wordmark">{siteTitle}</a>
				<nav class="nav" aria-label="Primary">
					{
						menu?.items.map((item) => (
							<a href={item.url}>
								{item.label}
								{isCartLink(item.url) && cartCount !== null && (
									<Fragment>
										<span class="count mono" aria-hidden="true"> ({cartCount})</span>
										<span class="u-sr-only">, {cartCountLabel(cartCount)}</span>
									</Fragment>
								)}
							</a>
						))
					}
				</nav>
			</div>
		</header>
		<main id="main" class="shell">
			<slot />
		</main>
		<footer class="foot">
			<div class="shell foot-row">
				<span>Urumi — content by EmDash, commerce by Urumi.</span>
				{currency !== null && <span class="mono">{currency}</span>}
			</div>
		</footer>
	</body>
</html>

<style>
	/* One measure for the header content, the page content and the footer
	   content, so all three share a left edge. The header and footer HAIRLINES
	   are deliberately outside it and run full-bleed — the rule is the width of
	   the window, the text is the width of the measure. */
	.shell {
		width: 100%;
		max-width: 72rem;
		margin: 0 auto;
		padding-inline: clamp(1rem, 4vw, 2rem);
	}
	.skip-shell {
		/* Collapses to nothing while the link is out of flow. */
		height: 0;
	}

	/* Hidden until focused, then dropped INTO FLOW rather than floated over the
	   header: overlaying it would cover the wordmark, which is exactly where a
	   left-aligned skip link lands. Sitting in the shell also gives it the same
	   left edge as everything else for free. */
	.skip-link {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		padding: 0.5rem 0.875rem;
		background: var(--u-surface);
		color: var(--u-ink);
		border: var(--u-hair);
		border-radius: var(--u-r);
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
	}
	.skip-link:focus {
		position: static;
		width: auto;
		height: auto;
		margin: 0.75rem 0;
		overflow: visible;
		clip-path: none;
		display: inline-block;
	}
	.skip-shell:focus-within {
		height: auto;
	}

	.head {
		border-bottom: var(--u-hair);
	}
	.head-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		padding-block: 1.25rem;
	}

	/* §3: the display face set narrow — the object the project is named
	   after is a long thin ribbon. Straw is the fitting under it.
	   `wdth` 75 is Bricolage's axis minimum (and the low end of the range
	   requested in astro.config.ts); anything lower is silently clamped. */
	.wordmark {
		font-family: var(--u-display);
		font-variation-settings: "wdth" 75, "opsz" 24;
		font-weight: 800;
		font-size: 1.25rem;
		letter-spacing: 0.02em;
		line-height: 1.1;
		text-transform: uppercase;
		color: var(--u-ink);
		text-decoration: none;
		padding-bottom: 2px;
		border-bottom: 2px solid var(--u-straw);
		/* The site title is CMS-owned and can be any length. Bound it so a
		   long one wraps inside the header instead of widening the page. */
		display: inline-block;
		max-width: 100%;
		overflow-wrap: anywhere;
	}

	.nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		align-items: baseline;
	}
	.nav a {
		color: var(--u-ink);
		text-decoration: none;
		font-size: 0.875rem;
		font-weight: 500;
		padding-bottom: 2px;
		border-bottom: 2px solid transparent;
	}
	.nav a:hover {
		border-bottom-color: var(--u-straw);
	}

	/* §3: money, quantities and counts are the only things set in mono. */
	.mono {
		font-family: var(--u-data);
		font-variation-settings: "wdth" 90;
		letter-spacing: -0.045em;
		font-variant-numeric: tabular-nums;
	}
	.count {
		font-size: 0.6875rem;
		letter-spacing: -0.03em;
		color: var(--u-mute);
	}

	main {
		display: block;
		padding-block: 2.5rem 4rem;
	}

	.foot {
		border-top: var(--u-hair);
	}
	.foot-row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		padding-block: 1.5rem;
		color: var(--u-mute);
		font-size: 0.75rem;
	}

	@media (max-width: 30rem) {
		.head-row {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.875rem;
		}
		.nav {
			gap: 1.125rem;
		}
	}
</style>
