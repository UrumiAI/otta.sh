---
/**
 * Thin base layout (ADR-0003: themes own the HTML; the plugin serves JSON
 * view models). Deliberately minimal — this is the staging storefront, not
 * a design system.
 */
import { getMenu, getSiteSettings } from "emdash";

interface Props {
	title: string;
	description?: string | null;
}

const { title, description } = Astro.props;
const settings = (await getSiteSettings()) as { title?: string; tagline?: string };
const siteTitle = settings.title ?? "Urumi Store (staging)";
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;
const menu = await getMenu("primary");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		{description && <meta name="description" content={description} />}
		<link
			rel="icon"
			type="image/svg+xml"
			href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23111'/%3E%3Ccircle cx='16' cy='16' r='9' fill='%23fff'/%3E%3C/svg%3E"
		/>
	</head>
	<body>
		<header>
			<nav>
				<a href="/" class="site-title">{siteTitle}</a>
				{menu?.items.map((item) => <a href={item.url}>{item.label}</a>)}
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer>
			<p>Urumi staging — content by EmDash, commerce by @urumi/service.</p>
		</footer>
	</body>
</html>

<style>
	body {
		font-family: system-ui, sans-serif;
		max-width: 60rem;
		margin: 0 auto;
		padding: 0 1rem;
		line-height: 1.5;
	}
	header nav {
		display: flex;
		gap: 1rem;
		align-items: baseline;
		padding: 1rem 0;
		border-bottom: 1px solid #ddd;
	}
	.site-title {
		font-weight: 700;
		font-size: 1.25rem;
	}
	footer {
		margin-top: 3rem;
		padding: 1rem 0;
		border-top: 1px solid #ddd;
		color: #666;
		font-size: 0.875rem;
	}
</style>
