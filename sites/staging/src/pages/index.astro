---
/**
 * Home — pure CMS chrome, no commerce call by construction: this page
 * renders 200 whether or not the commerce service is reachable.
 */
import { getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";

const settings = (await getSiteSettings()) as { title?: string; tagline?: string };
---

<Base title={settings.title ?? "Urumi Store (staging)"} description={settings.tagline}>
	<h1>{settings.title ?? "Urumi Store (staging)"}</h1>
	{settings.tagline && <p>{settings.tagline}</p>}
	<p><a href="/products">Browse products</a></p>
</Base>
