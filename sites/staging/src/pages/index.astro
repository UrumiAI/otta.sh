---
/**
 * Home — the asymmetric hero of docs/theme/TEMPERED.md §8: thesis copy and the
 * shop link on the left, the INVENTORY TAPE on the right. The hero is the
 * inventory rather than a slogan over a stock photo — a small shop has nothing
 * to hide behind, so it leads with the shelf.
 *
 * That tape is the one thing that changed here: this page used to make no
 * commerce call by construction, and now it makes the same one the catalog
 * page makes (content read here, plugin `storefront/list` route in-process).
 * The DEGRADED RULE keeps the old guarantee intact — when EITHER read fails
 * the tape is omitted entirely and the thesis column renders alone. No error
 * box: a shopper who has not asked for a price does not need to be told the
 * shop is having a moment, and the catalog page says so properly the instant
 * they click through.
 *
 * The rows, the counts and the headline fallbacks are `src/lib/tape.ts`, which
 * is where their honesty rules are unit-tested. This page is the reads and the
 * model; the MARKUP is the active theme's home view (`src/themes/<id>/
 * HomeView.astro`, via the Storefront shell), which renders only what the model
 * below hands it.
 */
import { STOREFRONT_LIST_ROUTE, type PlpRouteResult, type ProductViewModel } from "@otta-sh/plugin";
import { getEmDashCollection, getSiteSettings } from "emdash";
import { getPublicPluginApiRouteHandler } from "emdash/plugin-utils";
import Storefront from "../layouts/Storefront.astro";
import { toCmsProductContent, type ProductEntryData } from "../lib/products.js";
import {
	exactCount,
	shopLinkLabel,
	storeDescription,
	storeThesis,
	storeTitle,
	tapeRows,
	TAPE_FETCH_LIMIT,
	type StoreSettings,
} from "../lib/tape.js";
import { dispatchOttaRoute, isBusyResult, markBusy } from "../lib/otta-api.js";
import type { HomeModel } from "../themes/contract.js";

/**
 * BOTH reads on this page are guarded, and the settings read needs it as much
 * as the catalog one: `getSiteSettings` has no error channel — it awaits
 * `getDb()` and the query behind it, and either can reject — so an unguarded
 * `await` here is a 500 on the store's front door.
 *
 * The fallback is deliberately `{}` rather than a placeholder name:
 * `storeThesis({})` already resolves to the theme's own, and duplicating that
 * decision here is how the two drift apart.
 */
let settings: StoreSettings = {};
try {
	settings = (await getSiteSettings()) as StoreSettings;
} catch (error) {
	console.error("[site-staging] home settings read threw:", error);
}

/**
 * The catalog read is GUARDED too, by both of its arms.
 *
 * The front page used to make no data call at all and could not fail; the tape
 * gave it one. `getEmDashCollection` reports a query failure in `error` rather
 * than throwing, but a missing binding throws outright — so both arms land in
 * the same place, and that place is the degraded branch, not a 500.
 *
 * The claim this scopes to: THIS PAGE's frontmatter has no unguarded read, so a
 * dead content store costs it the tape and the store's own name, not the
 * response. The shell around it reads settings on its own account (see
 * `layouts/Storefront.astro`) and is not this page's to guarantee.
 */
let entries: readonly { data: unknown }[] | null = null;
let hasMore: boolean | undefined;
try {
	const collection = await getEmDashCollection("products", { limit: TAPE_FETCH_LIMIT });
	if (collection.error === undefined) {
		entries = collection.entries;
		hasMore = collection.hasMore;
	} else {
		console.error("[site-staging] home catalog read failed:", collection.error);
	}
} catch (error) {
	console.error("[site-staging] home catalog read threw:", error);
}

const items = (entries ?? []).map((entry) =>
	toCmsProductContent(entry.data as unknown as ProductEntryData),
);

const result =
	entries === null
		? null
		: await dispatchOttaRoute<PlpRouteResult>(
				getPublicPluginApiRouteHandler(Astro.locals),
				STOREFRONT_LIST_ROUTE,
				{ items, query: { kind: "all" } },
				Astro.url,
			);
const view: ProductViewModel[] | null = result !== null && result.ok ? result.items : null;
/* BUSY (storage contention, already retried once): the DEGRADED RULE still holds
   — the tape is omitted and no error box is shown — but the response is a 503 +
   short Retry-After, so a crawler or cache comes back for the priced front page
   instead of keeping the tapeless one as a healthy 200. */
if (isBusyResult(result)) markBusy(Astro.response);

const rows = tapeRows(view);

/* §7: the currency the page quoted, from the view model that knows it. */
const currency = view?.find((product) => product.price !== null)?.price?.currency ?? null;

/* The page fetches a small window (see TAPE_FETCH_LIMIT), so it usually cannot
   state the size of the catalog — and then it states none. A count that only
   holds for small stores is a count that lies to exactly the stores that grow. */
const count = entries === null ? null : exactCount(entries.length, TAPE_FETCH_LIMIT, hasMore);

const thesis = storeThesis(settings);
const lede =
	rows.length > 0
		? "Everything in the shop, with what it costs and what's on the shelf right now."
		: "Everything in the shop, on one page.";
const shopLabel = shopLinkLabel(count);

/* The degraded rule rides the model: no rows ⇒ the view renders no tape, and
   no error box either — that is the catalog page's job. */
const model: HomeModel = {
	thesis,
	lede,
	shopHref: "/products",
	shopLabel,
	rows,
	count,
};
---

<Storefront
	view="home"
	model={model}
	title={storeTitle(settings)}
	description={storeDescription(settings)}
	currency={currency}
/>
