---
/**
 * Home — the asymmetric hero of docs/theme/TEMPERED.md §8: thesis copy and the
 * shop link on the left, the INVENTORY TAPE on the right. The hero is the
 * inventory rather than a slogan over a stock photo — a small shop has nothing
 * to hide behind, so it leads with the shelf.
 *
 * That tape is the one thing that changed here: this page used to make no
 * commerce call by construction, and now it makes the same one the catalog
 * page makes (CMS read here, plugin `storefront/list` route in-process). The
 * DEGRADED RULE keeps the old guarantee intact — with the commerce service
 * unreachable the tape is omitted entirely and the thesis column renders
 * alone. No error box: a shopper who has not asked for a price does not need
 * to be told the shop is having a moment, and the catalog page says so
 * properly the instant they click through.
 */
import {
	PLP_PAGE_SIZE_CAP,
	STOREFRONT_LIST_ROUTE,
	type PlpRouteResult,
	type ProductViewModel,
} from "@urumi/plugin";
import { getEmDashCollection, getSiteSettings } from "emdash";
import { getPublicPluginApiRouteHandler } from "emdash/plugin-utils";
import Base from "../layouts/Base.astro";
import { toCmsProductContent, type ProductEntryData } from "../lib/products.js";
import { dispatchUrumiRoute } from "../lib/urumi-api.js";

/**
 * How many rows the hero shows. The tape is a HERO, not the catalog: three
 * products fill it exactly as the mockup draws it, and a store with forty
 * would otherwise push its own shop link off the screen. The link carries the
 * full count, so nothing is hidden — it is a shelf you can see the end of.
 */
const TAPE_ROWS = 6;

const settings = (await getSiteSettings()) as { title?: string; tagline?: string };

const { entries } = await getEmDashCollection("products", { limit: PLP_PAGE_SIZE_CAP });
const items = entries
	.slice(0, PLP_PAGE_SIZE_CAP)
	.map((entry) => toCmsProductContent(entry.data as unknown as ProductEntryData));

const result = await dispatchUrumiRoute<PlpRouteResult>(
	getPublicPluginApiRouteHandler(Astro.locals),
	STOREFRONT_LIST_ROUTE,
	{ items, query: { kind: "all" } },
	Astro.url,
);
const view: ProductViewModel[] | null = result !== null && result.ok ? result.items : null;

interface TapeRow {
	/** The sku — the store's own name for the thing. A product with no
	 *  commerce row never reaches this list, so the title fallback is a
	 *  belt-and-braces for a priced product whose sku is somehow absent. */
	item: string;
	/** Pre-formatted, straight off the view model (§7). */
	price: string;
	stock: string;
}

/**
 * Only a product the store can actually sell has a row: it is an INVENTORY
 * tape, and an unpriced product has no price cell to fill. §7 forbids
 * inventing one, and a dash in a money column is indistinguishable from free.
 *
 * `flatMap` rather than `filter` + `map` because a filter does not narrow
 * `price` for the mapping step that follows it.
 */
const tape: TapeRow[] = (view ?? []).flatMap((product) =>
	product.purchasable && product.price !== null
		? [
				{
					item: product.sku ?? product.title,
					price: product.price.formatted,
					// Availability is a coarse TOKEN — the view model carries no
					// count, so the tape states the fact it actually has (§7's
					// spirit: never render a figure the store did not quote).
					stock: product.availability === "in_stock" ? "In stock" : "Sold out",
				},
			]
		: [],
);
const rows = tape.slice(0, TAPE_ROWS);

/* §7: the currency the page quoted, from the view model that knows it. */
const currency = view?.find((product) => product.price !== null)?.price?.currency ?? null;

/* The thesis is the store's own line where it has one — the wordmark above
   already carries the name, so repeating it here would waste the page's
   loudest type on a word the shopper just read. */
const thesis = settings.tagline ?? settings.title ?? "Urumi";
const lede =
	rows.length > 0
		? "Everything in the shop, with what it costs and what's on the shelf right now."
		: "Everything in the shop, on one page.";
const shopLabel = items.length > 1 ? `Shop all ${items.length} items` : "Shop";
---

<Base title={settings.title ?? "Urumi"} description={settings.tagline} currency={currency}>
	<div class="hero">
		<div class="thesis">
			<h1 class="title">{thesis}</h1>
			<p class="lede">{lede}</p>
			<div>
				<a class="btn" href="/products">{shopLabel}</a>
			</div>
		</div>

		{
			rows.length > 0 && (
				<div class="tape">
					<div class="row row-head">
						<span class="u-label">Item</span>
						<span class="u-label">Price</span>
						{/* `stock-head`, not `stock`: the column heading is an
						    eyebrow label and keeps `.u-label`'s size — it only
						    borrows the data column's alignment. */}
						<span class="u-label stock-head">In stock</span>
					</div>
					{rows.map((row) => (
						<div class="row">
							<span class="u-mono item">{row.item}</span>
							<span class="u-mono price">{row.price}</span>
							<span class="u-mono stock">{row.stock}</span>
						</div>
					))}
					<p class="tape-foot">Stock updates as people buy.</p>
				</div>
			)
		}
	</div>
</Base>

<style>
	/* §8: asymmetric, ~1.15fr / 1fr — the copy leads and the tape answers. */
	.hero {
		display: grid;
		grid-template-columns: 1.15fr 1fr;
		gap: 3.5rem;
		align-items: start;
		padding-block: 1.5rem 1rem;
	}

	.thesis {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		/* Lets the column shrink inside the grid instead of setting the page's
		   minimum width from a long CMS-authored line. */
		min-width: 0;
	}

	/* §3: the display face set narrow, and the biggest type in the theme. */
	.title {
		font-family: var(--u-display);
		font-variation-settings: "wdth" 78, "opsz" 48;
		font-weight: 700;
		font-size: clamp(2.25rem, 6.5vw, 4.25rem);
		letter-spacing: -0.025em;
		line-height: 1;
		margin: 0;
		text-wrap: balance;
		overflow-wrap: break-word;
	}

	.lede {
		margin: 0;
		max-width: 32ch;
		color: var(--u-mute);
		font-size: 1rem;
	}

	/* The tape: hairline rows, three mono columns, no box (§2). */
	.tape {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.row {
		display: grid;
		/* `minmax(0, …)` so a long sku wraps inside its cell rather than
		   widening the row — §11's no-horizontal-scroll rule. */
		grid-template-columns: minmax(0, 1fr) auto 5.5rem;
		gap: 1.25rem;
		align-items: baseline;
		padding-block: 0.95rem;
		border-bottom: var(--u-hair);
	}
	.row:first-child {
		border-top: var(--u-hair);
	}

	.row-head {
		padding-bottom: 0.5rem;
		border-bottom: none;
	}

	.item {
		font-size: 0.75rem;
		overflow-wrap: anywhere;
	}

	.price {
		font-size: 0.8125rem;
		font-weight: 500;
	}

	/* Right-aligned and tabular, so the column reads as a column. */
	.stock,
	.stock-head {
		text-align: right;
	}
	.stock {
		font-size: 0.8125rem;
	}

	.tape-foot {
		margin: 0;
		padding-top: 0.75rem;
		color: var(--u-mute);
		font-size: 0.75rem;
	}

	/* The theme's one button shape (mockup `.s-btn`): ink-filled, straw only as
	   a fitting on hover — never a fill, so the label keeps full contrast (§2).
	   Focus is the global ring in tokens.css and is deliberately not restyled. */
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		background: var(--u-ink);
		color: var(--u-surface);
		border: none;
		border-radius: var(--u-r);
		padding: 0.75rem 1.25rem;
		font-family: var(--u-body);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
		box-shadow: inset 0 -2px 0 transparent;
		transition: box-shadow 120ms ease;
	}
	.btn:hover {
		box-shadow: inset 0 -3px 0 var(--u-straw);
	}

	@media (max-width: 52rem) {
		.hero {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}

	@media (max-width: 26rem) {
		.row {
			grid-template-columns: minmax(0, 1fr) auto 4.75rem;
			gap: 0.75rem;
		}
	}
</style>
