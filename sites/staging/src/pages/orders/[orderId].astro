---
/**
 * GET /orders/<orderId> — the confirmation page, and Stripe's `return_url`.
 *
 * ── What this page may claim ─────────────────────────────────────────────
 * Stripe appends `redirect_status=succeeded` to this URL. That is the BUYER'S
 * BROWSER reporting what Stripe told it — not a settlement. An order becomes
 * `paid` only through `settleOrder`'s guarded `pending → paid` flip, driven by
 * the `payment_intent.succeeded` webhook after an amount+currency equality
 * check. So this page re-reads the order from the service and renders THE
 * ORDER'S OWN STATE, always (ADR-0012 decision 5). That is also why the state
 * stamp is the FIRST thing on the page (docs/theme/TEMPERED.md §8): the state
 * is the most important thing on it.
 *
 * The redirect parameters are read for exactly ONE purpose — choosing how a
 * `pending` order is presented (the "confirming" copy, even past the hold, since a
 * just-paid pending order may still settle) — and are otherwise inert: never echoed into the
 * markup, never forwarded, never used to decide that anything is paid. That
 * "never echoed" rule is asserted structurally (checkout-client-js.test.ts):
 * their names may appear in this frontmatter and NOWHERE in the template below.
 *
 * ── What the page does about the secret in its own URL ───────────────────
 * Stripe also appends the intent's client secret, so it is already in history
 * and access logs by the time this renders (ADR-0012 decision 6 — accepted, and
 * not ours to change). The mitigations that ARE ours: the `no-referrer` policy
 * below, so it does not leak onward through subresource Referers; and deleting
 * the `otta_checkout` stash on arrival, so a spent secret does not linger in
 * the browser for the rest of the hold. That deletion is the entire
 * justification for the cookie's `path=/`.
 *
 * ── Zero client JavaScript, and that is a rule (ADR-0012 decision 2) ─────
 * Polling is `<meta http-equiv="refresh">`, bounded to 8 hops (~30 s), then a
 * manual link: no JS, no busy loop. The sweeping ribbon beside the count is a
 * CSS animation on a page that reloads itself, which is why it comes from
 * `PollRibbon` and NOT from the cart's countdown — whose script
 * (`HoldClock.astro`) Astro emits wherever it renders, so it would have put
 * ~1 kB of client JS on a page specified to carry none. The markup is the
 * theme's `OrderView` since Phase 3, and `checkout-client-js.test.ts` walks
 * page → shell → registry → every view for exactly that.
 */
import { orderLabel, STOREFRONT_ORDER_ROUTE, type OrderRouteResult } from "@otta-sh/plugin";
import { getPublicPluginApiRouteHandler } from "emdash/plugin-utils";
import Storefront from "../../layouts/Storefront.astro";
import {
	ACCOUNT_HOME_PATH,
	ACCOUNT_LOGIN_PATH,
	currentSessionToken,
	sessionOwnsOrder,
} from "../../lib/account.js";
import { forgetSpentCart } from "../../lib/cart-rotation.js";
import { clearCheckoutCookie } from "../../lib/checkout-cookie.js";
import { ORDER_PAGE_RESUME_ERRORS, resumeHref } from "../../lib/checkout-resume.js";
import { cartErrorMessage } from "../../lib/error-messages.js";
import { keepPrivate } from "../../lib/no-store.js";
import { orderStamp } from "../../lib/order-stamp.js";
import { BUSY, dispatchOttaRoute, isBusyResult, markBusy } from "../../lib/otta-api.js";
import { isOrderPayable } from "../../lib/pay-guard.js";
import type { OrderModel } from "../../themes/contract.js";

const { orderId } = Astro.params;

/* This page renders one buyer's order, and may delete the checkout stash and a
   spent cart's cookie: never stored by a shared cache, and kept out of Astro's
   route cache, which ignores Cache-Control (middleware.ts, "TWO CACHES") — QA
   U-7. Called FIRST, before any cookie is touched; a stored copy of a response
   that deletes a cookie would delete the next shopper's. */
keepPrivate(Astro);

// The stash has done its job the moment the buyer lands here — whether payment
// succeeded, failed or was abandoned. Drop it either way.
clearCheckoutCookie(Astro.cookies);

const result =
	orderId === undefined
		? null
		: await dispatchOttaRoute<OrderRouteResult>(
				getPublicPluginApiRouteHandler(Astro.locals),
				STOREFRONT_ORDER_ROUTE,
				{ orderId },
				Astro.url,
			);

const order = result !== null && result.ok ? result.order : null;
if (order === null) Astro.response.status = result !== null && !result.ok ? 404 : 503;

/* A FINISHED order (no longer pending — paid, expired, failed…) leaves its cart
   spent: it can never produce another order. If the cart cookie still names it,
   forget it here, so the shopper's next "Add to cart" starts a new cart instead
   of failing CART_CHECKED_OUT. A PENDING order's cart is kept: the cart page's
   way back to its checkout is built from that cookie (cart-rotation.ts).
   The response is already private (keepPrivate, above). */
if (order !== null) {
	await forgetSpentCart(
		{ cookies: Astro.cookies, handler: getPublicPluginApiRouteHandler(Astro.locals), url: Astro.url },
		order,
	);
}
/* BUSY is not "no such order": the read was refused under load (already retried
   once). 503 + short Retry-After, and the busy copy below — never a 404. */
const busy = isBusyResult(result);
if (busy) markBusy(Astro.response);

/** Did the buyer arrive via Stripe's redirect? Read ONLY to pick the pending
 *  copy — the value is never rendered, forwarded, or trusted. */
const returnedFromStripe = Astro.url.searchParams.has("payment_intent");

const state = order?.state ?? null;
const isPending = state === "pending";

/**
 * A pending order PAST its hold, reached other than from Stripe's redirect. The
 * sweep will expire it on its next tick, and `/checkout/pay` already refuses it
 * (`lib/pay-guard.ts`) — so offering "resume" would walk the buyer round a loop.
 * It keeps the bounded poll (a payment made a moment ago may still settle it) and
 * gets the door out. A buyer just back from Stripe is not "lapsed" here at all:
 * they get the confirming copy.
 */
const holdLapsed =
	order !== null && isPending && !returnedFromStripe && !isOrderPayable(order, new Date());

/** Bounded meta-refresh poll: at most 8 hops (~30 s), then a manual link. */
const MAX_POLLS = 8;
const poll = Number.parseInt(Astro.url.searchParams.get("p") ?? "0", 10);
const pollAttempt = Number.isFinite(poll) && poll > 0 ? poll : 0;
const shouldPoll = isPending && pollAttempt < MAX_POLLS;
const nextPollUrl = `/orders/${encodeURIComponent(orderId ?? "")}?p=${pollAttempt + 1}`;

/**
 * The order's own state → what we are willing to say: `lib/order-stamp.ts`, where
 * the honesty rules are unit-tested. The one sentence that depends on more than
 * the state — whether anything was charged on an expired or cancelled order — is
 * decided by `order.latePayment`, which the plugin derives from the payments and
 * refunds ledgers: "Nothing was charged" only when nothing was captured, and "we've
 * refunded it" only once the refund is on the ledger.
 */
const stamp = orderStamp({
	state,
	latePayment: order?.latePayment ?? "none",
	returnedFromStripe,
	holdLapsed,
});

/** "Total" while it is still a quote; "Paid" once the order settled (§7). A map
 *  rather than a comparison so no other state can ever pick up the word. */
const TOTAL_LABEL: Record<string, string> = { paid: "Paid" };

/**
 * The states with nowhere left to go, and therefore the states that get the
 * door out — plus a pending order past its hold (`holdLapsed` above), which is
 * one sweep away from `expired` and which the pay page already refuses.
 *
 * `failed` is in this set, which it was not before. The cart that produced the
 * order is `checked_out` and never returns to `active`, so /checkout answers
 * CART_CHECKED_OUT and 303s to /cart for ALL THREE of these — a "Back to
 * checkout" link on a failed order walks the buyer into an error page and
 * stops. `POST /checkout/new-cart` is the one control that actually moves them,
 * and it is already built. The stamp still leads with "No charge was made", so
 * the offer reads as "try again", not "pay again".
 *
 * The door is a GET LINK TO /cart, NOT that POST, and it must stay one. This
 * page is `no-referrer` (ADR-0012 decision 6: its URL can hold the client
 * secret), and under `no-referrer` browsers send `Origin: null` on the page's
 * own form POSTs (Fetch, "append a request `Origin` header") — the guard 403s
 * that, so a new-cart form here could never work. /cart is not `no-referrer`,
 * and for the one cart that needs the door — `checked_out`, which is exactly
 * this order's — it renders the same `POST /checkout/new-cart` button with its
 * consequence stated. A buyer whose cookie holds some other cart, or none, lands
 * on a cart they can already use. The link itself carries no Referer from here.
 */
const deadEnd = state === "expired" || state === "cancelled" || state === "failed" || holdLapsed;

/* Signed in as this order's owner? Then it is already in their list (a signed-in
   checkout under the account's own email is owned from birth), and the keep-this-
   link line can point straight there instead of at sign-in. Asked of the plugin
   through the session's own order read — the public order carries no email — and
   only once the poll has stopped: a polling page reloads every few seconds, and
   the answer changes nothing it shows. A render that may carry it is private. */
if (currentSessionToken(Astro.cookies) !== undefined) keepPrivate(Astro);
const ownsOrder =
	order !== null &&
	!shouldPoll &&
	(await sessionOwnsOrder(
		getPublicPluginApiRouteHandler(Astro.locals),
		Astro.cookies,
		order.id,
		Astro.url,
	));

/* Resuming a PENDING order goes through the page-owned resume path
   (`/checkout/resume?order=…`, QA U-2), not through /checkout: the review
   rebuilds from the CART cookie, which another device — or this one after the
   cart rotated — does not have. The resume needs only this order's id, the
   same capability this page reads with; the plugin replays the order's own
   checkout on its own key, so the pay page gets the same PaymentIntent and the
   same client secret, re-stashed. The stash was just deleted above; the resume
   writes it again. */
const canResume = state === "pending" && !returnedFromStripe && !holdLapsed;
const canCheckAgain = isPending && !shouldPoll;
const hasActions = deadEnd || canResume || canCheckAgain;

/** A resume that could not reach the pay page says why here — only for the
 *  tokens the resume endpoint sends (`ORDER_PAGE_RESUME_ERRORS`), and only while
 *  the order can still be resumed: for any other state the stamp is the answer. */
const resumeErrorToken = Astro.url.searchParams.get("error");
const resumeError =
	canResume && resumeErrorToken !== null && ORDER_PAGE_RESUME_ERRORS.has(resumeErrorToken)
		? cartErrorMessage(resumeErrorToken)
		: null;

/** The order's lines are a RECEIPT, so they carry the purchase-time title
 *  snapshot as well as the SKU — unlike /checkout, where the cart wire has no
 *  title to show. */
const ledgerRows =
	order?.lines.map((line) => ({
		title: line.title,
		sku: line.sku,
		qty: line.qty,
		money: line.lineTotal.formatted,
	})) ?? [];

const sumRows =
	order === null
		? []
		: [
				{ label: "Subtotal", amount: order.totals.subtotal },
				{
					label:
						order.totals.appliedCouponCode !== null
							? `Discount · ${order.totals.appliedCouponCode}`
							: "Discount",
					amount: order.totals.discount,
					fallback: "No coupon applied",
				},
				{ label: "Shipping", amount: order.totals.shipping },
				{ label: "Tax", amount: order.totals.tax },
			];
/** The order's name for the shopper: what was bought, never the order id (a
 *  UUID that names nothing to them). The SAME function names the order in its
 *  emails, so the page and the inbox agree. `PublicOrderView` lines say `qty`;
 *  `orderLabel` takes `quantity` — mapped here rather than widened there. The id
 *  keeps every machine job it has on this page: the URL, the poll URL. */
const label =
	order === null
		? null
		: orderLabel(order.lines.map((line) => ({ title: line.title, quantity: line.qty })));

/**
 * The model. Everything the view prints is decided above — including the
 * failure sentence, so BUSY / not-found / unavailable stay the page's call.
 * `returnedFromStripe` is NOT in it: only the copy it chose is.
 */
const model: OrderModel = {
	order,
	stamp,
	orderLabel: label,
	failureMessage: busy
		? cartErrorMessage(BUSY)
		: result !== null && !result.ok && "reason" in result
			? cartErrorMessage(result.reason)
			: cartErrorMessage("SERVICE_UNAVAILABLE"),
	shouldPoll,
	pollHop: pollAttempt + 1,
	pollMax: MAX_POLLS,
	nextPollUrl,
	hasActions,
	canCheckAgain,
	resumeHref: canResume && order !== null ? resumeHref(order.id) : null,
	resumeError,
	deadEnd,
	ledgerRows,
	sumRows,
	totalLabel: order === null ? "Total" : (TOTAL_LABEL[order.state] ?? "Total"),
	accountSignInHref: ACCOUNT_LOGIN_PATH,
	accountOrdersHref: ownsOrder ? ACCOUNT_HOME_PATH : null,
};
---

{/* The order names its own currency; a failed read names none (§7). */}
<Storefront
	view="order"
	model={model}
	title={label ?? "Order"}
	currency={order?.currency ?? null}
>
	<meta name="referrer" content="no-referrer" slot="head" />
	{shouldPoll && <meta http-equiv="refresh" content={`4;url=${nextPollUrl}`} slot="head" />}
</Storefront>
