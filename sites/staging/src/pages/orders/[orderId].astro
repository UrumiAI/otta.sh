---
/**
 * GET /orders/<orderId> — the confirmation page, and Stripe's `return_url`.
 *
 * ── What this page may claim ─────────────────────────────────────────────
 * Stripe appends `redirect_status=succeeded` to this URL. That is the BUYER'S
 * BROWSER reporting what Stripe told it — not a settlement. An order becomes
 * `paid` only through `settleOrder`'s guarded `pending → paid` flip, driven by
 * the `payment_intent.succeeded` webhook after an amount+currency equality
 * check. So this page re-reads the order from the service and renders THE
 * ORDER'S OWN STATE, always (ADR-0012 decision 5). That is also why the state
 * stamp is the FIRST thing on the page (docs/theme/TEMPERED.md §8): the state
 * is the most important thing on it.
 *
 * The redirect parameters are read for exactly ONE purpose — choosing between
 * two `pending` copy variants — and are otherwise inert: never echoed into the
 * markup, never forwarded, never used to decide that anything is paid. That
 * "never echoed" rule is asserted structurally (checkout-client-js.test.ts):
 * their names may appear in this frontmatter and NOWHERE in the template below.
 *
 * ── What the page does about the secret in its own URL ───────────────────
 * Stripe also appends the intent's client secret, so it is already in history
 * and access logs by the time this renders (ADR-0012 decision 6 — accepted, and
 * not ours to change). The mitigations that ARE ours: the `no-referrer` policy
 * below, so it does not leak onward through subresource Referers; and deleting
 * the `otta_checkout` stash on arrival, so a spent secret does not linger in
 * the browser for the rest of the hold. That deletion is the entire
 * justification for the cookie's `path=/`.
 *
 * ── Zero client JavaScript, and that is a rule (ADR-0012 decision 2) ─────
 * Polling is `<meta http-equiv="refresh">`, bounded to 8 hops (~30 s), then a
 * manual link: no JS, no busy loop. The sweeping ribbon beside the count is a
 * CSS animation on a page that reloads itself, which is why it comes from
 * `PollRibbon` and NOT from `HoldRibbon` — the latter ships a bundled script
 * for its countdown, and Astro emits a component's script whenever that
 * component renders, so importing it here would have put ~1 kB of client JS on
 * a page specified to carry none. `checkout-client-js.test.ts` now scans
 * component imports for exactly that.
 */
import { STOREFRONT_ORDER_ROUTE, type OrderRouteResult } from "@otta-sh/plugin";
import { getPublicPluginApiRouteHandler } from "emdash/plugin-utils";
import Ledger from "../../components/Ledger.astro";
import Notice from "../../components/Notice.astro";
import PollRibbon from "../../components/PollRibbon.astro";
import StateStamp from "../../components/StateStamp.astro";
import StepTrack from "../../components/StepTrack.astro";
import Sum from "../../components/Sum.astro";
import Base from "../../layouts/Base.astro";
import { clearCheckoutCookie } from "../../lib/checkout-cookie.js";
import { cartErrorMessage } from "../../lib/error-messages.js";
import { dispatchOttaRoute } from "../../lib/otta-api.js";

const { orderId } = Astro.params;

// The stash has done its job the moment the buyer lands here — whether payment
// succeeded, failed or was abandoned. Drop it either way.
clearCheckoutCookie(Astro.cookies);

const result =
	orderId === undefined
		? null
		: await dispatchOttaRoute<OrderRouteResult>(
				getPublicPluginApiRouteHandler(Astro.locals),
				STOREFRONT_ORDER_ROUTE,
				{ orderId },
				Astro.url,
			);

const order = result !== null && result.ok ? result.order : null;
if (order === null) Astro.response.status = result !== null && !result.ok ? 404 : 503;

/** Did the buyer arrive via Stripe's redirect? Read ONLY to pick the pending
 *  copy — the value is never rendered, forwarded, or trusted. */
const returnedFromStripe = Astro.url.searchParams.has("payment_intent");

const state = order?.state ?? null;
const isPending = state === "pending";

/** Bounded meta-refresh poll: at most 8 hops (~30 s), then a manual link. */
const MAX_POLLS = 8;
const poll = Number.parseInt(Astro.url.searchParams.get("p") ?? "0", 10);
const pollAttempt = Number.isFinite(poll) && poll > 0 ? poll : 0;
const shouldPoll = isPending && pollAttempt < MAX_POLLS;
const nextPollUrl = `/orders/${encodeURIComponent(orderId ?? "")}?p=${pollAttempt + 1}`;

interface StateCopy {
	/** The stamp's headline — the largest type on the page. */
	headline: string;
	/** What it means and what happens next. */
	body: string | null;
}

/**
 * The order's own state → what we are willing to say. Copy lives here so the
 * template stays a mapping and the honesty rules are readable in one place.
 *
 * These are the page's OWN sentences, split at the boundary that was already in
 * them — §10 says quote the copy that exists rather than rewriting it, and the
 * stamp simply wants the first sentence larger than the second. The expired
 * body is the one line taken from the mockup: it says the same thing the old
 * sentence did and adds the fact a buyer looking at a lapsed order needs most.
 */
const COPY: Record<string, StateCopy> = {
	paid: { headline: "Order confirmed.", body: "Thank you — we've received your payment." },
	failed: { headline: "The payment did not go through.", body: "No charge was made." },
	expired: {
		headline: "This order expired.",
		body: "Payment didn't complete in time, so the items went back on sale. Nothing was charged.",
	},
	cancelled: { headline: "This order was cancelled.", body: null },
	refunded: { headline: "This order has been refunded.", body: null },
};

const pendingCopy: StateCopy = returnedFromStripe
	? {
			headline: "Payment submitted.",
			body: "We're confirming it with our payment provider — this usually takes a few seconds. This page refreshes automatically.",
		}
	: { headline: "This order is awaiting payment.", body: null };

const stamp: StateCopy | null =
	state === null
		? null
		: isPending
			? pendingCopy
			: (COPY[state] ?? { headline: `Order status: ${state}.`, body: null });

/** "Total" while it is still a quote; "Paid" once the order settled (§7). A map
 *  rather than a comparison so no other state can ever pick up the word. */
const TOTAL_LABEL: Record<string, string> = { paid: "Paid" };

/**
 * The states with nowhere left to go, and therefore the states that get the
 * door out.
 *
 * `failed` is in this set, which it was not before. The cart that produced the
 * order is `checked_out` and never returns to `active`, so /checkout answers
 * CART_CHECKED_OUT and 303s to /cart for ALL THREE of these — a "Back to
 * checkout" link on a failed order walks the buyer into an error page and
 * stops. `POST /checkout/new-cart` is the one control that actually moves them,
 * and it is already built. The stamp still leads with "No charge was made", so
 * the offer reads as "try again", not "pay again".
 */
const deadEnd = state === "expired" || state === "cancelled" || state === "failed";

/* Resuming a PENDING order is different, and still goes through /checkout
   rather than straight to /checkout/pay: the stash was just deleted above, so
   the pay page has no client secret to mount. Re-submitting the review form
   replays `checkout:<cartId>` — the same order, and through Stripe's own
   idempotency the same PaymentIntent and the same client secret — which
   re-stashes it. The stable key is what makes resuming possible at all. */
const canResume = state === "pending" && !returnedFromStripe;
const canCheckAgain = isPending && !shouldPoll;
const hasActions = deadEnd || canResume || canCheckAgain;

/** The order's lines are a RECEIPT, so they carry the purchase-time title
 *  snapshot as well as the SKU — unlike /checkout, where the cart wire has no
 *  title to show. */
const ledgerRows =
	order?.lines.map((line) => ({
		title: line.title,
		sku: line.sku,
		qty: line.qty,
		money: line.lineTotal.formatted,
	})) ?? [];

const sumRows =
	order === null
		? []
		: [
				{ label: "Subtotal", amount: order.totals.subtotal },
				{
					label:
						order.totals.appliedCouponCode !== null
							? `Discount · ${order.totals.appliedCouponCode}`
							: "Discount",
					amount: order.totals.discount,
					fallback: "No coupon applied",
				},
				{ label: "Shipping", amount: order.totals.shipping },
				{ label: "Tax", amount: order.totals.tax },
			];
---

{/* The order names its own currency; a failed read names none (§7). */}
<Base
	title={order === null ? "Order" : `Order ${order.id}`}
	currency={order?.currency ?? null}
>
	<meta name="referrer" content="no-referrer" slot="head" />
	{shouldPoll && <meta http-equiv="refresh" content={`4;url=${nextPollUrl}`} slot="head" />}

	{
		order === null || stamp === null ? (
			<>
				{/* NO step track here. It says Cart and Details and Payment are
				    behind you, and for an order that does not exist — a mistyped
				    link, someone else's reference, a service that is down — that
				    is a journey the visitor never made. */}
				<h1 class="title">Order</h1>
				<div class="alert">
					<Notice>
						{result !== null && !result.ok && "reason" in result
							? cartErrorMessage(result.reason)
							: cartErrorMessage("SERVICE_UNAVAILABLE")}
					</Notice>
				</div>
				<p class="back">
					<a href="/products">Browse products</a>
				</p>
			</>
		) : (
			<>
				{/* Wrapped rather than given a class: a page's scoped selector
				    cannot reach a component's root (src/lib/rest-props.ts), so the
				    spacing around one lives on an element the page owns. */}
				<div class="steps"><StepTrack current="order" /></div>

				<StateStamp
					state={order.state}
					headline={stamp.headline}
					body={stamp.body}
					reference={order.id}
				>
					{/* The hold ribbon's grammar, running indeterminate and
					    SCRIPT-FREE: there is no duration to drain against, so the
					    count carries the information and the sweep says only
					    "still working". */}
					{shouldPoll && (
						<div class="poll">
							<PollRibbon poll={pollAttempt + 1} pollMax={MAX_POLLS} />
						</div>
					)}
				</StateStamp>

				<p class="keep">Keep this link to check its status.</p>

				{hasActions && (
					<div class="actions">
						{canCheckAgain && (
							<a class="u-btn u-btn-ghost" href={nextPollUrl}>
								Check again
							</a>
						)}
						{canResume && (
							<a class="u-btn u-btn-ghost" href="/checkout">
								Complete payment
							</a>
						)}
						{deadEnd && (
							<form method="POST" action="/checkout/new-cart">
								<button type="submit" class="u-btn u-btn-ghost">
									Start a new cart
								</button>
							</form>
						)}
					</div>
				)}

				<div class="cols">
					<section class="panel">
						<div class="panel-head">
							<h2 class="u-label head-label">Items</h2>
						</div>
						<Ledger rows={ledgerRows} />
						{order.fulfillment !== null && (
							<p class="ship">
								Shipped with {order.fulfillment.carrier} — tracking{" "}
								<span class="u-mono">{order.fulfillment.trackingNumber}</span>
							</p>
						)}
					</section>

					<section class="panel">
						<div class="panel-head">
							<h2 class="u-label head-label">Totals</h2>
						</div>
						<Sum
							rows={sumRows}
							total={order.totals.total}
							totalLabel={TOTAL_LABEL[order.state] ?? "Total"}
							excludesUncalculated={order.totals.totalExcludesUncalculated}
						/>
					</section>
				</div>
			</>
		)
	}
</Base>

<style>
	.steps {
		margin-bottom: 2rem;
	}

	.title {
		font-family: var(--u-display);
		font-variation-settings: "wdth" 78, "opsz" 48;
		font-weight: 700;
		font-size: clamp(1.75rem, 4vw, 2.25rem);
		letter-spacing: -0.025em;
		line-height: 1;
		margin: 0 0 1.5rem;
	}

	.alert {
		margin-bottom: 1.5rem;
	}

	/* The stamp is a flex column with `align-items: flex-start`, so a wrapper
	   shrinks to its content — which would leave the sweeping track only as wide
	   as "CHECKING 1 OF 8". §6 gives the ribbon a 22rem measure; this is what
	   lets it have one. */
	.poll {
		width: 100%;
		max-width: 22rem;
		margin-top: 0.375rem;
	}

	.keep {
		margin: 0.75rem 0 0;
		font-size: 0.75rem;
		color: var(--u-mute);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}
	.actions form {
		margin: 0;
	}

	/* §8: items and totals, side by side under the stamp. */
	.cols {
		display: grid;
		grid-template-columns: 1.15fr 1fr;
		gap: 3rem;
		align-items: start;
		margin-top: 2.5rem;
	}

	.panel {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		min-width: 0;
	}

	.panel-head {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding-bottom: 0.75rem;
		border-bottom: var(--u-hair);
	}
	/* A real <h2> wearing the eyebrow treatment — styling, not a demotion, so
	   screen-reader heading navigation still works. `.u-label` (tokens.css)
	   already beats the UA sheet on size and weight; the margin is all that is
	   left to undo. */
	.head-label {
		margin: 0;
		color: var(--u-ink);
	}

	.ship {
		margin: 0;
		font-size: 0.8125rem;
		color: var(--u-mute);
	}
	.ship .u-mono {
		font-size: 0.75rem;
		color: var(--u-ink);
		overflow-wrap: anywhere;
	}

	/* GHOST ONLY, and that is this page's decision rather than the shape's:
	   nothing here is a primary action — the order is already placed, and every
	   control is a way out rather than a way on (§2). This page used to say so
	   by redefining `.btn` as a ghost, which meant `class="btn"` here and
	   `class="btn"` on the PDP drew two different buttons. It now says it by
	   writing `.u-btn .u-btn-ghost` on all three controls (tokens.css). */

	.back {
		margin: 2rem 0 0;
		font-size: 0.8125rem;
	}
	.back a {
		color: var(--u-mute);
	}
	.back a:hover {
		color: var(--u-ink);
	}

	@media (max-width: 54rem) {
		.cols {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}
</style>
