---
/**
 * PLP — thin theme page (ADR-0003): the tier-① CMS query runs HERE, the
 * page of content goes to the plugin's public `storefront/list` route
 * in-process, and the returned view models are rendered to cards.
 *
 * This page is the reads and the MODEL; the markup is the active theme's shop
 * view (`src/themes/<id>/ShopView.astro`, via the Storefront shell). Every
 * decision below — which state, which notice lead, what each card says where
 * its price would be — is made here, so no theme can make it differently.
 *
 * Two degraded states, and they are NOT the same state.
 *
 * When COMMERCE is unreachable the route returns RENDER_FAILED (or dispatch
 * yields null) and this page still renders the whole CONTENT catalog with a
 * designed notice — content visibility never depends on commerce availability.
 *
 * When the CONTENT store is unreachable there is no catalog to render, and the
 * page has to say so. `getEmDashCollection` reports that in `error` rather than
 * throwing, so an outage arrives here looking exactly like an empty
 * collection — and rendering the empty state would tell a shopper the shop is
 * empty and hand them the admin link. That is the wrong fact and the wrong
 * audience.
 */
import {
	PLP_PAGE_SIZE_CAP,
	STOREFRONT_LIST_ROUTE,
	type PlpRouteResult,
	type ProductViewModel,
} from "@otta-sh/plugin";
import { getEmDashCollection } from "emdash";
import { getPublicPluginApiRouteHandler } from "emdash/plugin-utils";
import Storefront from "../../layouts/Storefront.astro";
import { productKey, toCmsProductContent, type ProductEntryData } from "../../lib/products.js";
import { exactCount, itemCountLabel } from "../../lib/tape.js";
import { cartErrorMessage } from "../../lib/error-messages.js";
import { BUSY, dispatchOttaRoute, isBusyResult, markBusy } from "../../lib/otta-api.js";
import type { ShopModel } from "../../themes/contract.js";

const {
	entries,
	hasMore,
	error: catalogError,
} = await getEmDashCollection("products", { limit: PLP_PAGE_SIZE_CAP });

/* An outage and an empty shop both arrive as zero entries, and only `error`
   tells them apart. Read it, or the shop tells a shopper it sells nothing. */
const catalogUnavailable = catalogError !== undefined;
if (catalogUnavailable) {
	console.error("[site-staging] shop catalog read failed:", catalogError);
}

// Defensive second bound: the route rejects pages over the cap outright.
const items = entries
	.slice(0, PLP_PAGE_SIZE_CAP)
	.map((entry) => toCmsProductContent(entry.data as unknown as ProductEntryData));

const result = await dispatchOttaRoute<PlpRouteResult>(
	getPublicPluginApiRouteHandler(Astro.locals),
	STOREFRONT_LIST_ROUTE,
	{ items, query: { kind: "all" } },
	Astro.url,
);
const view: ProductViewModel[] | null = result !== null && result.ok ? result.items : null;
/* BUSY (storage contention, already retried once): same degraded cards, but a
   503 + short Retry-After so a crawler comes back for the priced page. */
const busy = isBusyResult(result);
if (busy) markBusy(Astro.response);

/** With commerce unreachable the cards still render — content only, and every
 *  commercial field explicitly absent so no card can show a figure. */
const cards =
	view ??
	items.map((content) => ({
		...content,
		purchasable: false,
		price: null,
		compareAtPrice: null,
		availability: null,
	}));

/**
 * What a card says where its price would be.
 *
 * Left to its default a priceless card reads "Not currently available for
 * purchase", which is TRUE of an unpriced product and FALSE here: under a
 * banner promising the catalog is complete, every card would be quietly
 * retiring the whole shop. Degraded means the page does not know the price, so
 * that is what it says — the PDP already draws the same distinction.
 */
const priceNote = view === null ? "Price unavailable right now" : undefined;

/* §7: the footer names the currency the page actually quoted, never a
   literal — and names none at all when nothing on the page carries a price. */
const currency = view?.find((product) => product.price !== null)?.price?.currency ?? null;

/* The grid renders the window that came back; the EYEBROW may only state a
   figure when that window is the whole catalog (see `exactCount`). A full
   window means "at least 48", and "48 items" over a 900-product shop is a lie
   the shopper has no way to catch. */
const count = exactCount(entries.length, PLP_PAGE_SIZE_CAP, hasMore);
const countLabel = itemCountLabel(count);

/* Order is the whole fix: an outage and an empty shop both see zero entries,
   so the outage branch is decided FIRST and wins. */
const state: ShopModel["state"] = catalogUnavailable
	? "unavailable"
	: items.length === 0
		? "empty"
		: "list";

const model: ShopModel = {
	state,
	/* Commerce down while content rendered: the catalog is complete, the
	   figures are not. BUSY gets its own lead; themes never see the token. */
	degradedNotice:
		view === null && items.length > 0
			? { lead: busy ? cartErrorMessage(BUSY) : "Prices and stock are unavailable right now." }
			: null,
	countLabel,
	cards: cards.map((product) => ({
		href: product.url ?? `/products/${productKey(product)}`,
		slug: productKey(product),
		title: product.title,
		description: product.description ?? null,
		image: product.images?.[0] ?? null,
		/* A card with no live price gets `null` — not a figure, not a zero. */
		price: product.purchasable && product.price !== null ? product.price.formatted : null,
		priceNote,
		/* The plugin decided whether this is a sale (`compareAtPrice` is null
		   unless it is above the price); the page only refuses a was-price for
		   a card with no live price to strike it beside. */
		was:
			product.purchasable && product.price !== null
				? (product.compareAtPrice?.formatted ?? null)
				: null,
		availability: product.availability,
	})),
	adminHref: "/_emdash/admin",
};
---

<Storefront view="shop" model={model} title="Shop" currency={currency} />
