---
/**
 * PLP — thin theme page (ADR-0003): the tier-① CMS query runs HERE, the
 * page of content goes to the plugin's public `storefront/list` route
 * in-process, and the returned view models are rendered to cards.
 *
 * The "Tempered" shape (docs/theme/TEMPERED.md §8): a mono count, the title
 * in the display face, then a 3-up grid of borderless cards. `ProductCard`
 * owns everything inside a cell — the coil, the price, the stock rule and the
 * sold-out treatment — so this page is a data mapping and a grid, and nothing
 * else. Card position is passed as `index` so the coil tints cycle and every
 * three cards show all three (§5).
 *
 * Degraded state is a feature, not a crash: when the commerce service is
 * unreachable the route returns RENDER_FAILED (or dispatch yields null) and
 * this page still renders the CONTENT catalog with a designed notice —
 * content visibility never depends on commerce availability.
 */
import {
	PLP_PAGE_SIZE_CAP,
	STOREFRONT_LIST_ROUTE,
	type PlpRouteResult,
	type ProductViewModel,
} from "@urumi/plugin";
import { getEmDashCollection } from "emdash";
import { getPublicPluginApiRouteHandler } from "emdash/plugin-utils";
import Notice from "../../components/Notice.astro";
import ProductCard from "../../components/ProductCard.astro";
import Base from "../../layouts/Base.astro";
import { toCmsProductContent, type ProductEntryData } from "../../lib/products.js";
import { dispatchUrumiRoute } from "../../lib/urumi-api.js";

const { entries } = await getEmDashCollection("products", { limit: PLP_PAGE_SIZE_CAP });
// Defensive second bound: the route rejects pages over the cap outright.
const items = entries
	.slice(0, PLP_PAGE_SIZE_CAP)
	.map((entry) => toCmsProductContent(entry.data as unknown as ProductEntryData));

const result = await dispatchUrumiRoute<PlpRouteResult>(
	getPublicPluginApiRouteHandler(Astro.locals),
	STOREFRONT_LIST_ROUTE,
	{ items, query: { kind: "all" } },
	Astro.url,
);
const view: ProductViewModel[] | null = result !== null && result.ok ? result.items : null;

/** With commerce unreachable the cards still render — content only, and every
 *  commercial field explicitly absent so no card can show a figure. */
const cards =
	view ??
	items.map((content) => ({ ...content, purchasable: false, price: null, availability: null }));

/* §7: the footer names the currency the page actually quoted, never a
   literal — and names none at all when nothing on the page carries a price. */
const currency = view?.find((product) => product.price !== null)?.price?.currency ?? null;

const count = items.length;
---

<Base title="Shop" currency={currency}>
	{
		/* The WRAPPER carries the spacing, not a class on the component: a page
		   cannot style a component's root element (Astro scopes each
		   component's CSS to its own hash — see src/lib/rest-props.ts), so a
		   `class` handed to <Notice> lands on an element this page's selectors
		   can never match. */
		view === null && count > 0 && (
			<div class="notice-slot">
				<Notice lead="Prices and stock are unavailable right now.">
					The catalog below is complete — check back in a moment for live figures.
				</Notice>
			</div>
		)
	}

	{
		count === 0 ? (
			<div class="empty">
				<h1 class="title empty-title">No products yet.</h1>
				<p class="empty-copy">
					Create a product in the admin, price it in the Product data panel, and it appears
					here with live stock.
				</p>
				<a class="btn btn-ghost" href="/_emdash/admin">
					Open the admin
				</a>
			</div>
		) : (
			<>
				<div class="head">
					<p class="u-label">{count === 1 ? "1 item" : `${count} items`}</p>
					<h1 class="title">Shop</h1>
				</div>
				<div class="grid">
					{cards.map((product, index) => (
						<ProductCard
							index={index}
							href={product.url ?? `/products/${product.slug ?? product.id}`}
							slug={product.slug ?? product.id}
							title={product.title}
							description={product.description ?? null}
							image={product.images?.[0] ?? null}
							price={
								product.purchasable && product.price !== null
									? product.price.formatted
									: null
							}
							availability={product.availability}
						/>
					))}
				</div>
			</>
		)
	}
</Base>

<style>
	/* §3: the display face, narrow — the title carries this page. */
	.title {
		font-family: var(--u-display);
		font-variation-settings: "wdth" 78, "opsz" 48;
		font-weight: 700;
		font-size: clamp(2rem, 5vw, 2.25rem);
		letter-spacing: -0.025em;
		line-height: 1;
		margin: 0;
		text-wrap: balance;
	}

	.head {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-bottom: 2rem;
	}
	.head p {
		margin: 0;
	}

	/* Generous air, no card borders: the grid's gaps do the separating and the
	   only rule on a card is the one above its foot (§2). */
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem 1.75rem;
	}

	.notice-slot {
		margin-bottom: 2rem;
	}

	/* §8: an empty screen is an invitation to act, not an apology. */
	.empty {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
		padding-block: 2rem;
	}
	.empty-title {
		font-size: 1.75rem;
	}
	.empty-copy {
		margin: 0;
		max-width: 44ch;
		color: var(--u-mute);
	}

	/* The theme's one button shape (mockup `.s-btn`): ink-filled, straw only as
	   a fitting on hover — never a fill, so the label keeps full contrast (§2).
	   Focus is the global ring in tokens.css and is deliberately not restyled. */
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		background: var(--u-ink);
		color: var(--u-surface);
		border: none;
		border-radius: var(--u-r);
		padding: 0.75rem 1.25rem;
		font-family: var(--u-body);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
		box-shadow: inset 0 -2px 0 transparent;
		transition: box-shadow 120ms ease;
	}
	.btn:hover {
		box-shadow: inset 0 -3px 0 var(--u-straw);
	}
	.btn-ghost {
		background: transparent;
		color: var(--u-ink);
		border: var(--u-hair);
	}

	@media (max-width: 60rem) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 34rem) {
		.grid {
			grid-template-columns: 1fr;
			gap: 2.25rem;
		}
	}
</style>
