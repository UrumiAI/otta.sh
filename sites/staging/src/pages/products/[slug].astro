---
/**
 * PDP — thin theme page (ADR-0003): CMS read HERE, then the plugin's
 * public `storefront/product` route in-process; builds the product MODEL, and
 * the Storefront shell renders it through the active theme's product view
 * (`src/themes/<id>/ProductView.astro`) plus the Product/Offer JSON-LD, which
 * the shell emits itself (`components/SafeJsonLd.astro`) so no theme can drop
 * or re-serialize it.
 *
 * Everything with a consequence stays HERE: the 404/503 split, BUSY, the error
 * token, the sold-out/in-stock decisions, the idempotency key and the return
 * path. The view receives answers, never inputs.
 *
 * Idempotency: the form forwards the view model's `slots.addToCart`
 * idempotencyKey — minted FRESH by the plugin per rendered PDP (see
 * product-view-model.ts) — so a double-submit of the same rendered form
 * replays in the service instead of duplicating, while a fresh page load
 * mints a new key. The /cart/add endpoint never invents a key.
 *
 * TWO degraded states, and they are not the same state — the shop page's own
 * distinction, drawn here per product:
 *
 *  - COMMERCE unreachable: the route returns RENDER_FAILED and this page still
 *    renders the content (no price, no add-to-cart) with a designed notice —
 *    200, never a crash. Content visibility never depends on commerce.
 *  - CONTENT unreachable: there is nothing to render, and the page must not
 *    say "Product not found." about it. See the read below.
 */
import {
	STOREFRONT_PRODUCT_ROUTE,
	type PdpRouteResult,
	type ProductViewModel,
} from "@otta-sh/plugin";
import { getEmDashEntry } from "emdash";
import { getPublicPluginApiRouteHandler } from "emdash/plugin-utils";
import Storefront from "../../layouts/Storefront.astro";
import { cartErrorAction, cartErrorMessage } from "../../lib/error-messages.js";
import { holdNote } from "../../lib/hold.js";
import { productKey, toCmsProductContent, type ProductEntryData } from "../../lib/products.js";
import { BUSY, dispatchOttaRoute, isBusyResult, markBusy } from "../../lib/otta-api.js";
import type { ProductModel, ProductPurchase } from "../../themes/contract.js";

const { slug } = Astro.params;
if (slug === undefined) return Astro.redirect("/products");

/**
 * "This product does not exist" and "the store cannot be read right now" are
 * NOT the same page, and the read hands them over looking identical: a `null`
 * entry either way. Only `error` tells them apart, and this page used to
 * discard it — so a content-store outage answered every product URL with
 * "Product not found." at 404, which tells a shopper following a live link that
 * the thing they came for is gone, and tells a crawler to drop the catalog.
 *
 * The same distinction the shop page already draws (see the head of
 * `products/index.astro`); this is the PDP's half of it.
 *
 * `LiveEntryNotFoundError` is excluded because it IS the not-found case: astro
 * wraps a missing row in one and the loader surfaces it through `error`, which
 * is why `EntryResult.error`'s own JSDoc ("not set for not found") cannot be
 * taken at its word.
 *
 * The `try` is the third arm, and NOT for the reason it would be natural to
 * assume: a missing DB binding does not reach here as a throw. `getDb()` is
 * called INSIDE the loader's own `try`, so "EmDash database not configured"
 * comes back as a reported `{ error }` and is caught by the branch above. What
 * the `try` covers is everything OUTSIDE that catch — `getEmDashEntry` does a
 * dynamic `import("astro:content")` before the loader runs, wraps the read in
 * `cachedQuery`, and hydrates the row afterwards. A fault in any of those
 * throws, and an uncaught throw in page frontmatter is a 500 on a product URL.
 *
 * ── WHAT THIS DOES NOT CATCH, measured rather than assumed ─────────────────
 * A MISSING TABLE OR COLUMN. em-dash's loader catches those and returns a bare
 * `{ entry: null }` — no `error` key, no throw, no log (`isMissingTableError`
 * → bare `return`) — so a store whose `ec_products` table is gone still
 * renders "Product not found." at 404. Verified under a workerd preview
 * against a database with the table renamed away: 404, and nothing in the log.
 * The collection API has the same hole (see the shape-keyed warn in
 * `cart/index.astro`, which is the workaround there), but a SINGLE-entry read
 * has no equivalent signal to key on — "no row came back" is precisely what a
 * genuine 404 looks like. Filed as issue #140: closing it needs an
 * em-dash-side signal, not another branch here.
 *
 * So the scope is exact: a reported error (query fault, misconfigured database,
 * anything else the loader hands back) and a throw from the machinery around
 * the loader. That is the whole of what this page can see.
 */
let entry: Awaited<ReturnType<typeof getEmDashEntry>>["entry"] = null;
let contentUnavailable = false;
try {
	const read = await getEmDashEntry("products", slug);
	entry = read.entry;
	if (read.error !== undefined && read.error.name !== "LiveEntryNotFoundError") {
		contentUnavailable = true;
		console.error("[site-staging] product content read failed:", read.error);
	}
} catch (cause) {
	contentUnavailable = true;
	console.error("[site-staging] product content read threw:", cause);
}

if (entry === null) {
	// 503 for an outage, 404 for an address that resolves to nothing. The status
	// is the machine-readable half of the same sentence the page renders.
	Astro.response.status = contentUnavailable ? 503 : 404;
	if (contentUnavailable) {
		// A crawler is the whole reason this split exists, and a bare 503 leaves
		// it guessing: no header means back off by an unspecified amount, which
		// in practice is where "drop the URL" starts. 60s is the smallest honest
		// figure — this page cannot know how long the store will be down, so it
		// says "ask again soon" rather than naming a recovery time it invented.
		Astro.response.headers.set("Retry-After", "60");
	}
}

const content = entry !== null ? toCmsProductContent(entry.data as unknown as ProductEntryData) : null;

const result =
	content !== null
		? await dispatchOttaRoute<PdpRouteResult>(
				getPublicPluginApiRouteHandler(Astro.locals),
				STOREFRONT_PRODUCT_ROUTE,
				{ content },
				Astro.url,
			)
		: null;

const product: ProductViewModel | null = result !== null && result.ok ? result.product : null;
const jsonLd = result !== null && result.ok ? result.jsonLd : null;
const addToCart = product?.slots.addToCart ?? null;
/** The store's effective cart-hold window (issue #127) — what the hold note states. */
const cartHoldMinutes = result !== null && result.ok ? result.cartHoldMinutes : undefined;
const degraded = content !== null && product === null;
/* Storage contention (the plugin's BUSY, already retried once by the dispatch):
   the page still renders its content, but answers 503 + a short Retry-After so a
   crawler comes back rather than indexing a page with no price on it. */
const busy = isBusyResult(result);
if (busy) markBusy(Astro.response);
const error = Astro.url.searchParams.get("error");

/* The coil keys off the product's OWN identity, not the path the visitor
   typed (em-dash resolves an entry by slug OR id), so the SHAPE on this page is
   the one the catalog card drew. The TINT can differ, and that is by design:
   a card cycles its tint by grid position so every three cards show all three,
   and a PDP has no list to hold a position in, so it falls back to the slug's
   own hash (see `buildCoil`). The geometry is the product's; the tint belongs
   to the page. */
const art = content !== null ? productKey(content) : "";
const image = product?.images?.[0] ?? content?.images?.[0] ?? null;
const purchasable = product?.purchasable === true && product.price !== null;
const inStock = product?.availability === "in_stock";
/* NOT `!inStock`: degraded and unpriced products are also not in stock, and
   they are not sold out — the page does not know. Only the explicit token
   dims the art and closes the buy path. */
const soldOut = product?.availability === "out_of_stock";

/**
 * The model — every answer the view prints, decided here.
 *
 * `purchase` exists only for a priced, sellable product; within it the
 * add-to-cart fields exist only when the product is actually IN STOCK, and the
 * idempotency key is the plugin's (`addToCart.idempotencyKey`), never minted on
 * this side. `soldOut` is the explicit token, so a degraded or unpriced page —
 * which does not know the stock — neither dims its art nor offers the way on.
 */
const purchase: ProductPurchase | null =
	content !== null && purchasable && product?.price
		? {
				priceFormatted: product.price.formatted,
				priceStruck: !inStock,
				availability: product.availability,
				sku: product.sku,
				addToCart:
					addToCart && inStock
						? {
								sku: addToCart.sku,
								productId: addToCart.productId,
								idempotencyKey: addToCart.idempotencyKey,
								returnTo: content.url ?? `/products/${slug}`,
							}
						: null,
				/* The store's EFFECTIVE window (issue #127) — never a
				   hard-coded default, which was false on any store whose
				   operator changed the setting. */
				cartHoldMinutes,
				holdNote: holdNote(cartHoldMinutes),
				soldOut,
			}
		: null;

const model: ProductModel =
	content === null
		? { state: contentUnavailable ? "unavailable" : "notFound" }
		: {
				state: "ok",
				title: content.title,
				description: content.description ?? null,
				art,
				image,
				dimmed: soldOut,
				degradedLead: degraded
					? busy
						? cartErrorMessage(BUSY)
						: "Prices and stock are unavailable right now."
					: null,
				errorMessage: error !== null ? cartErrorMessage(error) : null,
				errorAction: error !== null ? cartErrorAction(error) : null,
				purchase,
				/* Decided once, here, as the contract states it — neither
				   purchasable nor degraded — so no view re-derives it. */
				showNotForSale: purchase === null && !degraded,
			};
---

{/* An unpriced or degraded product carries no currency, and the footer
    then names none rather than guessing (§7). */}
<Storefront
	view="product"
	model={model}
	jsonLd={jsonLd}
	title={content?.title ?? (contentUnavailable ? "Product unavailable" : "Product not found")}
	description={content?.description}
	currency={product?.price?.currency ?? null}
/>
