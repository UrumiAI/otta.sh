---
/**
 * PDP — thin theme page (ADR-0003): CMS read HERE, then the plugin's
 * public `storefront/product` route in-process; renders the view model,
 * the Product/Offer JSON-LD, and — for a purchasable product — the
 * add-to-cart form.
 *
 * The "Tempered" shape (docs/theme/TEMPERED.md §8): media left at 4/5, and a
 * right column that runs title → description → SPEC LEDGER → buy row → hold
 * note. Everything a shopper needs to decide sits in that ledger — price,
 * stock, sku — as label/value rows separated by hairlines, and the add-to-cart
 * button is the only filled element on the page.
 *
 * Idempotency: the form forwards the view model's `slots.addToCart`
 * idempotencyKey — minted FRESH by the plugin per rendered PDP (see
 * product-view-model.ts) — so a double-submit of the same rendered form
 * replays in the service instead of duplicating, while a fresh page load
 * mints a new key. The /cart/add endpoint never invents a key.
 *
 * TWO degraded states, and they are not the same state — the shop page's own
 * distinction, drawn here per product:
 *
 *  - COMMERCE unreachable: the route returns RENDER_FAILED and this page still
 *    renders the content (no price, no add-to-cart) with a designed notice —
 *    200, never a crash. Content visibility never depends on commerce.
 *  - CONTENT unreachable: there is nothing to render, and the page must not
 *    say "Product not found." about it. See the read below.
 */
import {
	STOREFRONT_PRODUCT_ROUTE,
	type PdpRouteResult,
	type ProductViewModel,
} from "@otta-sh/plugin";
import { getEmDashEntry } from "emdash";
import { safeJsonLdSerialize } from "emdash/page";
import { getPublicPluginApiRouteHandler } from "emdash/plugin-utils";
import MediaPanel from "../../components/MediaPanel.astro";
import Notice from "../../components/Notice.astro";
import PriceTag from "../../components/PriceTag.astro";
import QtyField from "../../components/QtyField.astro";
import StockRule from "../../components/StockRule.astro";
import Base from "../../layouts/Base.astro";
import { cartErrorMessage } from "../../lib/error-messages.js";
import { toCmsProductContent, type ProductEntryData } from "../../lib/products.js";
import { dispatchUrumiRoute } from "../../lib/urumi-api.js";

const { slug } = Astro.params;
if (slug === undefined) return Astro.redirect("/products");

/**
 * "This product does not exist" and "the store cannot be read right now" are
 * NOT the same page, and the read hands them over looking identical: a `null`
 * entry either way. Only `error` tells them apart, and this page used to
 * discard it — so a content-store outage answered every product URL with
 * "Product not found." at 404, which tells a shopper following a live link that
 * the thing they came for is gone, and tells a crawler to drop the catalog.
 *
 * The same distinction the shop page already draws (see the head of
 * `products/index.astro`); this is the PDP's half of it.
 *
 * `LiveEntryNotFoundError` is excluded because it IS the not-found case: astro
 * wraps a missing row in one and the loader surfaces it through `error`, which
 * is why `EntryResult.error`'s own JSDoc ("not set for not found") cannot be
 * taken at its word.
 *
 * The `try` is the third arm, and NOT for the reason it would be natural to
 * assume: a missing DB binding does not reach here as a throw. `getDb()` is
 * called INSIDE the loader's own `try`, so "EmDash database not configured"
 * comes back as a reported `{ error }` and is caught by the branch above. What
 * the `try` covers is everything OUTSIDE that catch — `getEmDashEntry` does a
 * dynamic `import("astro:content")` before the loader runs, wraps the read in
 * `cachedQuery`, and hydrates the row afterwards. A fault in any of those
 * throws, and an uncaught throw in page frontmatter is a 500 on a product URL.
 *
 * ── WHAT THIS DOES NOT CATCH, measured rather than assumed ─────────────────
 * A MISSING TABLE OR COLUMN. em-dash's loader catches those and returns a bare
 * `{ entry: null }` — no `error` key, no throw, no log (`isMissingTableError`
 * → bare `return`) — so a store whose `ec_products` table is gone still
 * renders "Product not found." at 404. Verified under a workerd preview
 * against a database with the table renamed away: 404, and nothing in the log.
 * The collection API has the same hole (see the shape-keyed warn in
 * `cart/index.astro`, which is the workaround there), but a SINGLE-entry read
 * has no equivalent signal to key on — "no row came back" is precisely what a
 * genuine 404 looks like. Filed as issue #140: closing it needs an
 * em-dash-side signal, not another branch here.
 *
 * So the scope is exact: a reported error (query fault, misconfigured database,
 * anything else the loader hands back) and a throw from the machinery around
 * the loader. That is the whole of what this page can see.
 */
let entry: Awaited<ReturnType<typeof getEmDashEntry>>["entry"] = null;
let contentUnavailable = false;
try {
	const read = await getEmDashEntry("products", slug);
	entry = read.entry;
	if (read.error !== undefined && read.error.name !== "LiveEntryNotFoundError") {
		contentUnavailable = true;
		console.error("[site-staging] product content read failed:", read.error);
	}
} catch (cause) {
	contentUnavailable = true;
	console.error("[site-staging] product content read threw:", cause);
}

if (entry === null) {
	// 503 for an outage, 404 for an address that resolves to nothing. The status
	// is the machine-readable half of the same sentence the page renders.
	Astro.response.status = contentUnavailable ? 503 : 404;
	if (contentUnavailable) {
		// A crawler is the whole reason this split exists, and a bare 503 leaves
		// it guessing: no header means back off by an unspecified amount, which
		// in practice is where "drop the URL" starts. 60s is the smallest honest
		// figure — this page cannot know how long the store will be down, so it
		// says "ask again soon" rather than naming a recovery time it invented.
		Astro.response.headers.set("Retry-After", "60");
	}
}

const content = entry !== null ? toCmsProductContent(entry.data as unknown as ProductEntryData) : null;

const result =
	content !== null
		? await dispatchUrumiRoute<PdpRouteResult>(
				getPublicPluginApiRouteHandler(Astro.locals),
				STOREFRONT_PRODUCT_ROUTE,
				{ content },
				Astro.url,
			)
		: null;

const product: ProductViewModel | null = result !== null && result.ok ? result.product : null;
const jsonLd = result !== null && result.ok ? result.jsonLd : null;
const addToCart = product?.slots.addToCart ?? null;
const degraded = content !== null && product === null;
const error = Astro.url.searchParams.get("error");

/* The coil keys off the product's OWN identity, not the path the visitor
   typed (em-dash resolves an entry by slug OR id), so the SHAPE on this page is
   the one the catalog card drew. The TINT can differ, and that is by design:
   a card cycles its tint by grid position so every three cards show all three,
   and a PDP has no list to hold a position in, so it falls back to the slug's
   own hash (see `buildCoil`). The geometry is the product's; the tint belongs
   to the page. */
const art = content !== null ? (content.slug ?? content.id) : "";
const image = product?.images?.[0] ?? content?.images?.[0] ?? null;
const purchasable = product?.purchasable === true && product.price !== null;
const inStock = product?.availability === "in_stock";
/* NOT `!inStock`: degraded and unpriced products are also not in stock, and
   they are not sold out — the page does not know. Only the explicit token
   dims the art and closes the buy path. */
const soldOut = product?.availability === "out_of_stock";
---

{/* An unpriced or degraded product carries no currency, and the footer
    then names none rather than guessing (§7). */}
<Base
	title={content?.title ?? (contentUnavailable ? "Product unavailable" : "Product not found")}
	description={content?.description}
	currency={product?.price?.currency ?? null}
>
	{
		content === null ? (
			contentUnavailable ? (
				/* NOT the not-found state, for the reason the shop page gives:
				   telling a shopper a product does not exist, when in fact the
				   store could not be read, is the wrong fact. §10 — what happened
				   and what to do, no apology, no internals. The crumb is still
				   offered: the shop page renders its own designed banner if the
				   outage is still on, so it is a real way forward rather than a
				   second dead end.

				   BUILT FROM THE SAME PARTS as the not-found sibling below and
				   as 404.astro — display-face line, one muted sentence, a way
				   out — because it is the same §8 state wearing a different
				   fact. The heading is not decoration: this was the one state
				   on the site whose <title> said something ("Product
				   unavailable") that its body never did, so a shopper landing
				   here read a stray banner and a link with nothing naming what
				   had happened. The Notice carries the second sentence rather
				   than repeating the first. */
				<div class="empty">
					<h1 class="title empty-title">This product is unavailable.</h1>
					<div class="empty-notice">
						<Notice>Try again in a moment.</Notice>
					</div>
					<a class="u-btn u-btn-ghost" href="/products">
						Back to all products
					</a>
				</div>
			) : (
				<div class="empty">
					<h1 class="title empty-title">Product not found.</h1>
					<p class="empty-copy">
						{/* States the fact and stops. The page knows the address
						    resolves to nothing; it does NOT know why, and "it may
						    have sold out and been retired" invents a story about a
						    product that may simply never have existed — or tells a
						    shopper chasing a live link that the thing they came for
						    is gone, on no evidence. */}
						Nothing here under that address.
					</p>
					<a class="u-btn u-btn-ghost" href="/products">
						Back to all products
					</a>
				</div>
			)
		) : (
			<>
				<p class="crumb">
					<a href="/products">← All products</a>
				</p>

				{/* The WRAPPER carries the spacing, not a class on the component —
				    see the note on the media panel below. */}
				{degraded && (
					<div class="notice-slot">
						<Notice lead="Prices and stock are unavailable right now.">
							Check back in a moment — everything else on this page is up to date.
						</Notice>
					</div>
				)}
				{error !== null && (
					<div class="notice-slot">
						<Notice>{cartErrorMessage(error)}</Notice>
					</div>
				)}

				<div class="pdp">
					{/* The product art, or the image when there is one (§5). 4/5 here:
					    the ratio is layout, so the page owns it.

					    The WRAPPER is not decoration: a page cannot style a
					    component's root element (Astro scopes each component's CSS
					    to its own hash — see src/lib/rest-props.ts), so the phone
					    width cap below has to sit on an element this page owns. */}
					<div class="art">
						{/* `dimmed` is a PROP, not a rule this page writes: Astro
						    scopes a component's CSS to its own hash, so a selector
						    here could never reach MediaPanel's root (see the note
						    on that prop). */}
						<MediaPanel
							slug={art}
							image={image}
							alt={content.title}
							ratio="4 / 5"
							dimmed={soldOut}
						/>
					</div>

					<div class="side">
						<div>
							<h1 class="title">{content.title}</h1>
							{content.description && <p class="desc">{content.description}</p>}
						</div>

						{purchasable && product?.price ? (
							<>
								{/* The spec ledger: label left, fact right, one hairline
								    between each — the whole decision in one block. */}
								<div class="spec">
									<div class="spec-row">
										<span class="u-label">Price</span>
										<PriceTag
											formatted={product.price.formatted}
											size="lg"
											soldOut={!inStock}
										/>
									</div>
									<div class="spec-row">
										<span class="u-label">Stock</span>
										<StockRule availability={product.availability} />
									</div>
									{product.sku !== null && (
										<div class="spec-row">
											<span class="u-label">SKU</span>
											<span class="u-mono sku">{product.sku}</span>
										</div>
									)}
								</div>

								{addToCart && inStock && (
									<div class="buy-block">
										<form class="buy" method="POST" action="/cart/add">
											<input type="hidden" name="sku" value={addToCart.sku} />
											<input
												type="hidden"
												name="productId"
												value={addToCart.productId}
											/>
											<input
												type="hidden"
												name="idempotencyKey"
												value={addToCart.idempotencyKey}
											/>
											<input
												type="hidden"
												name="returnTo"
												value={content.url ?? `/products/${slug}`}
											/>
											<QtyField name="qty" value={1} min={1} />
											<button class="u-btn" type="submit">
												Add to cart
											</button>
										</form>
										{/* The hold is worth telling a shopper about, and §10
										    keeps the duration visible because it is the
										    useful part.

										    The figure states the shipped DEFAULT:
										    `DEFAULT_HOLD_TTL_MS` in @otta-sh/domain is 15
										    minutes, and the service's only override is the
										    `CART_HOLD_TTL_MS` env var — the admin's
										    `holdTtlMinutes` setting is persisted but not
										    wired to anything (issue #127, which names this
										    very line). So the number is true of every
										    deployment that has not set that variable, and
										    is kept for that reason rather than softened to
										    "for a few minutes", which tells a shopper
										    nothing they can plan around. When #127 lands,
										    this copy has to read the effective TTL instead
										    of hard-coding the default. */}
										<p class="hold-note">
											Adding this holds one in stock for 15 minutes.
										</p>
									</div>
								)}

								{/* A sold-out PDP is otherwise a dead end: a price, a
								    ledger saying you cannot have it, and no way on.
								    §8 — a failure explains what still works.

								    ONE element does that here, and it is the door.
								    The fact is already stated twice above — the
								    ledger's Stock row reads "Sold out" and PriceTag
								    strikes the figure beside it — so a third
								    sentence saying the same thing would be the
								    theme repeating itself where the button should
								    be. The wording follows the ledger's: this page
								    says "Sold out", never "Out of stock", so the
								    shopper is not left matching two phrasings to
								    one fact. And it is not the crumb again — the
								    crumb goes BACK, this offers the alternative,
								    and it sits where the buy button would have. */}
								{soldOut && (
									<div class="buy-block">
										<div>
											<a class="u-btn u-btn-ghost" href="/products">
												See what's in stock
											</a>
										</div>
									</div>
								)}
							</>
						) : (
							!degraded && <p class="note">Not currently available for purchase</p>
						)}
					</div>
				</div>
			</>
		)
	}
	{
		/* safeJsonLdSerialize, NOT JSON.stringify: a CMS-authored title with
		   "</script>" would otherwise break out of this script tag (stored
		   XSS) — pinned by test/json-ld-xss.test.ts. */
		jsonLd && (
			<script is:inline type="application/ld+json" set:html={safeJsonLdSerialize(jsonLd)} />
		)
	}
</Base>

<style>
	/* §8: media left (~4/5), the decision on the right. */
	.pdp {
		display: grid;
		grid-template-columns: 1.25fr 1fr;
		gap: 3rem;
		align-items: start;
	}

	/* The mockup's 1.25fr column is drawn inside a ~700px frame; on a 72rem
	   page the same ratio turns a 4/5 panel into a poster and pushes the buy
	   row off the first screen. The cap keeps the panel the size the mockup
	   draws it while the ratio still decides the split. */
	.art {
		max-width: 30rem;
	}

	.side {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		min-width: 0;
	}

	/* §3: the display face, narrow. */
	.title {
		font-family: var(--u-display);
		font-variation-settings: "wdth" 78, "opsz" 48;
		font-weight: 700;
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		letter-spacing: -0.025em;
		line-height: 1;
		margin: 0;
		text-wrap: balance;
	}

	.desc {
		margin: 0.75rem 0 0;
		max-width: 40ch;
		color: var(--u-mute);
	}

	.crumb {
		margin: 0 0 1.5rem;
	}
	.crumb a {
		color: var(--u-mute);
		font-size: 0.8125rem;
		text-decoration: none;
	}
	.crumb a:hover {
		color: var(--u-ink);
		text-decoration: underline;
		text-decoration-color: var(--u-straw);
	}

	/* The spec ledger — hairlines only, never a box (§2). */
	.spec {
		display: flex;
		flex-direction: column;
		border-top: var(--u-hair);
	}
	.spec-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		padding-block: 0.625rem;
		border-bottom: var(--u-hair);
	}
	.sku {
		font-size: 0.75rem;
	}

	.buy-block {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.buy {
		display: flex;
		align-items: flex-end;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.hold-note {
		margin: 0;
		color: var(--u-mute);
		font-size: 0.75rem;
	}

	.note {
		margin: 0;
		color: var(--u-mute);
		font-size: 0.8125rem;
	}

	.notice-slot {
		margin-bottom: 1.5rem;
	}

	/* §8: an empty screen is an invitation to act, not an apology. */
	.empty {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
		padding-block: 2rem;
	}
	.empty-title {
		font-size: 1.75rem;
	}
	.empty-copy {
		margin: 0;
		max-width: 44ch;
		color: var(--u-mute);
	}

	/* The 503's Notice sits INSIDE the empty block, so the block's own `gap`
	   spaces it — `.notice-slot`'s banner margin would double up. `stretch`
	   because the block aligns its children to the start, which would otherwise
	   shrink-wrap the notice to its one short sentence; the cap is
	   `.empty-copy`'s, so the two read on the same measure. */
	.empty-notice {
		align-self: stretch;
		max-width: 44ch;
	}

	/* Buttons are `.u-btn` / `.u-btn .u-btn-ghost` (tokens.css) — §2's one shape,
	   written down once. The RANK is still this page's: add-to-cart is the only
	   filled element on the PDP (§8), and the two ways out — "Back to all
	   products" and the sold-out "See what's in stock" — are ghosts. */

	@media (max-width: 52rem) {
		.pdp {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		/* A full-width 4/5 panel eats a phone screen; cap it and let the buy
		   row sit closer to the fold. */
		.art {
			max-width: 20rem;
		}
	}
</style>
