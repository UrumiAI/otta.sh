---
/**
 * Cart view — the theme shim side of ADR-0003's cart contract: this page
 * reads ITS OWN `urumi_cart` cookie and passes the id as plain route input
 * to the plugin's public `storefront/cart/read` (plugin routes are
 * cookie-blind by design in sandboxed mode; ADR-0006 records the trusted-
 * mode caveat). Line totals are quantity-only — the cart wire carries no
 * price (a cart line snapshots no price; that is an order invariant).
 *
 * Idempotency: each rendered update/remove form embeds a fresh
 * crypto.randomUUID() key, so a double-submit of the same form replays in
 * the service instead of double-applying. The endpoints never invent keys.
 */
import {
	CART_COOKIE_NAME,
	STOREFRONT_CART_READ_ROUTE,
	totalQty,
	type CartReadRouteResult,
	type CartWire,
} from "@urumi/plugin";
import { getPublicPluginApiRouteHandler } from "emdash/plugin-utils";
import Base from "../../layouts/Base.astro";
import { cartMoneyCell, isCartPricingDegraded } from "../../lib/cart-view.js";
import { cartErrorMessage } from "../../lib/error-messages.js";
import { dispatchUrumiRoute } from "../../lib/urumi-api.js";

const cartId = Astro.cookies.get(CART_COOKIE_NAME)?.value;
const error = Astro.url.searchParams.get("error");

const result =
	cartId !== undefined && cartId.length > 0
		? await dispatchUrumiRoute<CartReadRouteResult>(
				getPublicPluginApiRouteHandler(Astro.locals),
				STOREFRONT_CART_READ_ROUTE,
				{ cartId },
				Astro.url,
			)
		: null;

const cart: CartWire | null = result !== null && result.ok ? result.cart : null;
const pricing = result !== null && result.ok ? result.pricing : null;
// A cart cookie exists but the read failed → distinguish "service down"
// (RENDER_FAILED / dispatch null) from "cart gone" (CART_NOT_FOUND).
const degraded =
	cartId !== undefined && cart === null && !(result !== null && !result.ok && "reason" in result);

/**
 * ABSENT pricing counts as degraded, not as "no prices" (§5). `pricing?.degraded`
 * on an undefined pricing is falsy, so a worker bundle predating the pricing
 * join rendered a total outage as if every line were simply unpriced: no banner,
 * every money cell an unexplained "—", the total row suppressed.
 */
const pricingDegraded = isCartPricingDegraded(pricing);

const lines = cart?.lines ?? [];
// One fresh key per rendered form (double-submit = replay, not duplicate).
const lineForms = lines.map((line) => ({
	line,
	updateKey: crypto.randomUUID(),
	removeKey: crypto.randomUUID(),
}));
---

{/* The nav badge and the footer currency both reuse THIS page's cart read —
    the layout makes no commerce call of its own, and it never invents either
    value. `null` when there is no cart to read, so the nav renders a bare
    "Cart" rather than a misleading "Cart (0)" and the footer names no
    currency rather than guessing one. */}
<Base
	title="Cart"
	cartCount={cart === null ? null : totalQty(cart)}
	currency={cart?.currency ?? null}
>
	<h1>Cart</h1>

	{error !== null && <p class="notice">{cartErrorMessage(error)}</p>}
	{degraded && (
		<p class="notice">The cart service is temporarily unavailable — please try again shortly.</p>
	)}
	{cart !== null && pricingDegraded && (
		<p class="notice">
			Pricing is temporarily unavailable — quantities and holds are still accurate.
		</p>
	)}

	{
		cart === null || lines.length === 0 ? (
			!degraded && (
				<p>
					Your cart is empty. <a href="/products">Browse products</a>.
				</p>
			)
		) : (
			<>
				<table>
					<thead>
						<tr>
							<th>SKU</th>
							<th>Qty</th>
							<th>Unit price</th>
							<th>Line subtotal</th>
							<th>Hold expires</th>
							<th />
						</tr>
					</thead>
					<tbody>
						{lineForms.map(({ line, updateKey, removeKey }) => {
							const linePricing = pricing?.lines.find((p) => p.lineId === line.lineId) ?? null;
							return (
								<tr>
									<td>{line.sku}</td>
									<td>
										<form method="POST" action="/cart/update">
											<input type="hidden" name="lineId" value={line.lineId} />
											<input type="hidden" name="idempotencyKey" value={updateKey} />
											<input type="number" name="qty" value={line.qty} min="1" step="1" />
											<button type="submit">Update</button>
										</form>
									</td>
									<td>{cartMoneyCell(linePricing?.unitPrice?.formatted, pricingDegraded)}</td>
									<td>{cartMoneyCell(linePricing?.lineTotal?.formatted, pricingDegraded)}</td>
									<td>{line.expiresAt ?? "—"}</td>
									<td>
										<form method="POST" action="/cart/remove">
											<input type="hidden" name="lineId" value={line.lineId} />
											<input type="hidden" name="idempotencyKey" value={removeKey} />
											<button type="submit">Remove</button>
										</form>
									</td>
								</tr>
							);
						})}
					</tbody>
				</table>
				<p>
					Total items: <strong>{totalQty(cart)}</strong> ({cart.currency})
				</p>
				{pricing?.total !== null && pricing?.total !== undefined && (
					<p>
						Total: <strong>{pricing.total.formatted}</strong>
						{!pricing.allLinesPriced && " (some items priced at checkout)"}
					</p>
				)}
				<p class="muted">
					Prices shown are informational and may change — your final total is calculated at
					checkout.
				</p>
				<p>
					<a href="/checkout">Proceed to checkout</a>
				</p>
			</>
		)
	}
</Base>

<style>
	table {
		border-collapse: collapse;
		width: 100%;
	}
	th,
	td {
		text-align: left;
		padding: 0.5rem;
		border-bottom: var(--u-hair);
	}
	form {
		display: flex;
		gap: 0.5rem;
	}
	input[type="number"] {
		width: 4.5rem;
	}
	.muted {
		color: var(--u-mute);
		font-size: 0.875rem;
	}
	.notice {
		background: #fff7e0;
		border: 1px solid #e6c200;
		border-radius: 0.5rem;
		padding: 0.75rem 1rem;
	}
</style>
