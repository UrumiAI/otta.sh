		font-family: var(--u-display);
		font-variation-settings: "wdth" 78, "opsz" 32;
		font-weight: 700;
		font-size: 1.75rem;
		letter-spacing: -0.025em;
		line-height: 1;
	}
	.terminal-body {
		margin: 0;
		max-width: 44ch;
		color: var(--u-mute);
	}

	/* The record. Hairlines only (§2) — this is a list of what left, and a box
