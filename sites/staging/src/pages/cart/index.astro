---
/**
 * Cart — "Tempered" increment 4 (docs/theme/TEMPERED.md §6, §7, §8).
 *
 * Lines, not a table: media, name + SKU + the hold ribbon, then the money and
 * the controls on the right, with the totals block bottom-right. The ribbon is
 * the theme's signature and it is the reason this page exists in the shape it
 * does — every line carries one, wired to that line's own `expiresAt`.
 *
 * ── the shim contract (unchanged) ───────────────────────────────────────────
 * The theme side of ADR-0003's cart contract: this page reads ITS OWN
 * `otta_cart` cookie and passes the id as plain route input to the plugin's
 * public `storefront/cart/read` (plugin routes are cookie-blind by design in
 * sandboxed mode; ADR-0006 records the trusted-mode caveat).
 *
 * Idempotency: each rendered update/remove form embeds a fresh
 * crypto.randomUUID() key, so a double-submit of the same form replays in the
 * service instead of double-applying. The endpoints never invent keys.
 *
 * ── what a cart line actually carries, and what this page may say ───────────
 * `CartLineWire` is `lineId · sku · productId · qty · reservationId ·
 * expiresAt`. No price (a cart line snapshots no price — that is an order
 * invariant, §7) and no title (it snapshots no content either). So:
 *
 *  - MONEY comes from the pricing SIBLING (`buildCartPricing`'s live join) and
 *    is informational, which is what the foot line says out loud. Every cell
 *    goes through `cart-view.ts`'s `lineMoneyText` — `cartMoneyCell` (which of
 *    the three "no figure" cases is this?), this page's casing, then
 *    `moneyCellText` (§7's rule that a cell either says something or says
 *    nothing at all — never a bare dash).
 *  - The NAME comes from this theme's own CMS read, keyed on the line's
 *    `productId` — the same tier-① content this store owns (ADR-0003), not a
 *    new field on the wire. ONE batched query for the whole cart. Anything
 *    missing (a legacy line with no productId, an entry unpublished since it
 *    was added, a read that fails) leaves the SKU standing alone rather than
 *    inventing a name: a SKU is a true thing about the line.
 */
import {
	CART_COOKIE_NAME,
	STOREFRONT_CART_READ_ROUTE,
	totalQty,
	type CartMoneyWire,
	type CartReadRouteResult,
	type CartWire,
	type CheckoutAmountView,
} from "@otta-sh/plugin";
import { getEmDashCollection } from "emdash";
import { getPublicPluginApiRouteHandler } from "emdash/plugin-utils";
import HoldClock from "../../components/HoldClock.astro";
import Storefront from "../../layouts/Storefront.astro";
import {
	isCartPricingDegraded,
	isCartTerminal,
	isKnownCartState,
	lineMoneyText,
	PRICED_AT_CHECKOUT_CELL,
} from "../../lib/cart-view.js";
import { cartErrorMessage } from "../../lib/error-messages.js";
import {
	productImage,
	productKey,
	productPath,
	type ProductEntryData,
} from "../../lib/products.js";
import { isUnpricedText, type SumRow } from "../../lib/totals.js";
import { BUSY, dispatchOttaRoute, isBusyResult, markBusy } from "../../lib/otta-api.js";
import type { CartModel } from "../../themes/contract.js";

const cartId = Astro.cookies.get(CART_COOKIE_NAME)?.value;
const error = Astro.url.searchParams.get("error");

const result =
	cartId !== undefined && cartId.length > 0
		? await dispatchOttaRoute<CartReadRouteResult>(
				getPublicPluginApiRouteHandler(Astro.locals),
				STOREFRONT_CART_READ_ROUTE,
				{ cartId },
				Astro.url,
			)
		: null;

const cart: CartWire | null = result !== null && result.ok ? result.cart : null;
const pricing = result !== null && result.ok ? result.pricing : null;
// A cart cookie exists but the read failed → distinguish "service down"
// (RENDER_FAILED / dispatch null) from "cart gone" (CART_NOT_FOUND).
const degraded =
	cartId !== undefined && cart === null && !(result !== null && !result.ok && "reason" in result);
/* BUSY (storage contention, already retried once): the same degraded banner with
   the busy copy, and a 503 + short Retry-After — the read was refused, not failed. */
const busy = isBusyResult(result);
if (busy) markBusy(Astro.response);

/**
 * ABSENT pricing counts as degraded, not as "no prices" (§5). `pricing?.degraded`
 * on an undefined pricing is falsy, so a worker bundle predating the pricing
 * join rendered a total outage as if every line were simply unpriced: no banner,
 * every money cell an unexplained "—", the total row suppressed.
 */
const pricingDegraded = isCartPricingDegraded(pricing);

const lines = cart?.lines ?? [];

/**
 * Issue #110: this cart has produced an order and can never produce another.
 *
 * `state` has been on the wire object this page reads all along and was simply
 * never looked at, so after a purchase `/cart` went on listing the items, their
 * live prices, their hold ribbons and their quantity controls as though nothing
 * had happened — which reads, right after paying, as "the purchase didn't
 * take". The controls were the sharper half of it: every one of them fails with
 * `CART_CHECKED_OUT`.
 *
 * NOTHING here deletes the `otta_cart` cookie, and the obvious fix that does
 * was rejected on exactly that ground: `/orders/<id>` offers a pending order a
 * "Complete payment" link that routes through `/checkout`, and `/checkout`
 * rebuilds its review form FROM this cookie. Deleting it strands a buyer
 * holding an order that reserves stock they can no longer pay for. The cart is
 * rendered honestly instead; the cookie is untouched.
 *
 * The predicate's narrowness, and why it is not the domain's `state !==
 * "active"`, are argued in `cart-view.ts`. So is the thing this page must never
 * imply: `checked_out` is set BEFORE the payment intent exists, so it is not a
 * claim that the buyer paid.
 */
const terminal = isCartTerminal(cart?.state);

if (cart !== null && !isKnownCartState(cart.state)) {
	// GATED on there being a cart. `cart?.state` is `undefined` on every empty
	// cart, every visit with no cookie and every degraded read — the most common
	// state of this page — so an ungated warn would fire on almost every request
	// and mean nothing by the time a real unknown state arrived.
	console.warn(
		`[site-staging] cart ${cart.cartId} carries an unrecognised state "${cart.state}"; it renders as a live cart, because a renderer that failed closed here would brick a working cart read-only.`,
	);
}

/**
 * The order this cart became — read off the cart row this page just fetched.
 *
 * `carts.order_id` is stamped inside the same guarded `UPDATE … WHERE
 * state='active'` that flips the cart to `checked_out` (#132), so the id and
 * the state can never be observed apart. It rides `CartWire.orderId`, and
 * `HttpCommerceClient.getCart` normalizes a missing, empty or non-string value
 * to `null` at the wire boundary — so no second guard here. Site and plugin
 * ship as ONE worker (`noExternal: ["@otta-sh/plugin"]` in `astro.config.ts`);
 * there is no skew between them for a local re-check to catch.
 *
 * It used to come from the `otta_checkout` handoff stash, and that is why the
 * panel's case B was the ordinary answer: `/orders/<id>` deletes the stash on
 * arrival and is also Stripe's `return_url`, so the buyer who had just paid —
 * the exact buyer this panel exists for — arrived at `/cart` with none. The
 * cart cannot be consumed by another page.
 *
 * Still NOT a payment signal: `cartStore.checkout()` runs before
 * `gateway.createIntent()`, so a pending, failed or expired order stamps a cart
 * identically. A non-null id licenses a link to `/orders/<id>` — which reads
 * the real order state and gates its own "Complete payment" on it — and never a
 * claim that the buyer paid.
 *
 * ── the `terminal ?` gate is load-bearing; do NOT simplify it away ───────────
 * It reads as redundant beside a bare `cart?.orderId ?? null`, and it is not.
 * "`active` ⟺ no order id" is enforced by `checkout` being the column's SINGLE
 * WRITER, not structurally: migration `0021_cart_order_id.ts` deliberately adds
 * no CHECK constraint, and says so in the place a future author would add one.
 * Gating on `state` rather than on the id keeps this page correct under BOTH
 * anomalies that permits — an `active` cart carrying a non-NULL id (reachable
 * only by a raw partial UPDATE) still renders as the live cart it is, with no
 * order link offered over its quantity fields; and a `checked_out` cart with a
 * NULL id — which `cart-fence.dialects.test.ts` constructs on purpose, so the
 * cart-state fence stays provably independent of this column — falls to the
 * panel's case B.
 */
const placedOrderId = terminal ? (cart?.orderId ?? null) : null;

/**
 * How many distinct products this page will ask for in ONE query.
 *
 * The array form of a `where` value compiles to a literal `WHERE id IN (?, ?,
 * …)` with one bound parameter per id, and D1 allows roughly a hundred bound
 * parameters per statement — em-dash's own SQL chunking is conservative at
 * fifty for exactly that reason. So fifty is the ceiling, and a cart carrying
 * more distinct products than that renders the overflow SKU-only rather than
 * issuing a statement the database would reject outright. (No cart in this
 * store comes close; the bound exists so the failure mode is a missing name
 * instead of a 500 if one ever does.)
 */
const CART_CONTENT_ID_CAP = 50;

/**
 * The line's name and its art: ONE read for the whole cart.
 *
 * It was one `getEmDashEntry` per distinct product, fired in parallel — an
 * uncapped fan-out of D1 round-trips on a public route, and `getEmDashEntry`
 * is NOT request-cached, so nothing collapsed them. `getEmDashCollection` with
 * an array `where` value is a single `WHERE id IN (…)`, and it is
 * `requestCached` — which is the whole win here, since it is what makes a
 * second read of the same ids inside one render free. Do NOT count on the L2
 * object cache for this call: its key includes the exact ORDERED id set, and on
 * a per-shopper route that set is close to unique per request, so the entry is
 * written far more often than it is read.
 *
 * One behavioural difference worth naming: a collection read is `status:
 * "published"` by default where an entry read is not, so a product unpublished
 * since it was added to the cart now falls back to its SKU. That is the right
 * answer on a shopper-facing page — this page must not name content the store
 * has taken down — and it is already one of the fallback cases above.
 *
 * A failure is a missing name, never a failed page: content is what this store
 * owns, and it must not take the cart down with it.
 */
const allProductIds = [
	...new Set(lines.map((line) => line.productId).filter((id): id is string => id !== null)),
];
const productIds = allProductIds.slice(0, CART_CONTENT_ID_CAP);
if (allProductIds.length > productIds.length) {
	// Silent truncation would render as "some lines just have no name", which is
	// indistinguishable from unpublished content and from an outage.
	console.warn(
		`[site-staging] cart carries ${allProductIds.length} distinct products, over the ${CART_CONTENT_ID_CAP}-id query cap; the remainder render SKU-only.`,
	);
}

const contentById = new Map<string, ProductEntryData>();
if (productIds.length > 0) {
	try {
		const { entries, error: contentError } = await getEmDashCollection("products", {
			where: { id: productIds },
			// Defensive second bound, the PLP's pattern: the `IN` list is already
			// capped, and this caps what may come back through it.
			limit: CART_CONTENT_ID_CAP,
		});
		/**
		 * `getEmDashCollection` does NOT throw for a CMS/DB fault — it RETURNS
		 * `{ entries: [], error }`. Destructuring only the data is how a D1
		 * outage renders every line SKU-only with nothing in the log to say why
		 * (see the reproduced-live investigation in `cart/add.ts`, which is the
		 * same lesson learned against `getEmDashEntry`).
		 *
		 * The not-found guard is belt-and-braces rather than dead code. A
		 * collection read HAS no "not found" — an id with no row is an absent
		 * row, not an error — but `EntryResult.error`'s own JSDoc said exactly
		 * that about the entry API and was wrong in practice (astro wraps the
		 * loader's "no row" in a `LiveEntryNotFoundError`), so the discriminant
		 * is stated rather than assumed.
		 */
		if (contentError !== undefined && contentError.name !== "LiveEntryNotFoundError") {
			console.error("[site-staging] cart line content lookup failed:", contentError);
		} else if (entries.length === 0) {
			/**
			 * `error` is not the only way this read fails, and it is not the
			 * likeliest one. em-dash's collection loader CATCHES missing-table
			 * and missing-column faults and returns a bare `{ entries: [] }` —
			 * no `error` key at all, only a `console.warn` of its own for the
			 * column case and nothing whatever for the table case. A `where`
			 * clause is exactly what trips the column path, so the branch above
			 * would never fire for the most probable failure of this query.
			 *
			 * Hence a warn keyed on the SHAPE of the answer: ids were asked for
			 * and none came back. That is benignly true when every product in
			 * the cart is genuinely unpublished, so this line says both — a log
			 * line on a real, if unusual, state is a cheap price for not
			 * swallowing a schema fault on a shopper-facing route.
			 */
			console.warn(
				`[site-staging] cart line content lookup returned nothing for ${productIds.length} id(s): every one of them is unpublished, or the collection loader swallowed a missing-table/column fault.`,
			);
		}
		for (const entry of entries) {
			const data = entry.data as unknown as ProductEntryData;
			// Keyed on the CONTENT id — which is what a cart line's `productId`
			// is, and the join key commerce uses. `entry.id` is the slug-derived
			// routing id and would miss every line.
			contentById.set(data.id, data);
		}
	} catch (cause) {
		// Backstop only: the contract above is "returns an error, never throws",
		// and a cart page is not the place to discover that it changed.
		console.error("[site-staging] cart line content lookup threw:", cause);
	}
}

/**
 * `lineMoneyText` is the ONE path a money string takes to this page's screen —
 * which of the three "no figure" cases is this (`cartMoneyCell`), this page's
 * sentence casing, then §7's last gate (`moneyCellText`, which forbids anything
 * that does not say something). It lives in `cart-view.ts` beside the cases it
 * decides between, so the whole composition can be executed by a test rather
 * than reassembled by one. Nothing renders money on this page beside it.
 *
 * ONE binding serves both arms, deliberately: on the TERMINAL path the money
 * composition and the two `crypto.randomUUID()` keys per line are computed and
 * then never read. That is nothing next to the network call this page has
 * already made, and a second, narrower view model would be a second place for
 * the title-or-SKU fallback rule to drift.
 */
const lineViews = lines.map((line) => {
	const content = line.productId === null ? null : (contentById.get(line.productId) ?? null);
	const linePricing = pricing?.lines.find((entry) => entry.lineId === line.lineId) ?? null;
	const unitPrice = lineMoneyText(linePricing?.unitPrice?.formatted, pricingDegraded);
	return {
		line,
		/** The display-face name, or null when this store cannot name the line. */
		title: content?.title ?? null,
		/** What a screen reader calls the line — never null, so every control on
		 *  the row is distinguishable from the one on the row above it. */
		name: content?.title ?? line.sku,
		image: content === null ? null : productImage(content),
		/** Keys the coil (§5). Any stable per-product string; the SKU is the
		 *  last resort so a contentless line still draws its own art. */
		artKey: content === null ? (line.productId ?? line.sku) : productKey(content),
		/** The product's page, only when the line can be named — the same path
		 *  its catalog card links to, off the same key as `artKey`. */
		href: content === null ? null : productPath(content.slug, content.id),
		money: lineMoneyText(linePricing?.lineTotal?.formatted, pricingDegraded),
		/** Only when it says something the line total does not: at qty 1 the two
		 *  figures are the same number twice, and when the unit price is PROSE
		 *  ("Priced at checkout") the line total is already saying it — "Priced
		 *  at checkout each" is not a sentence. */
		each: line.qty > 1 && !isUnpricedText(unitPrice) ? `${unitPrice} each` : null,
		// One fresh key per rendered form (double-submit = replay, not duplicate).
		updateKey: crypto.randomUUID(),
		removeKey: crypto.randomUUID(),
	};
});

/**
 * "3 items" (§8) — UNITS, the same number the nav badge carries.
 *
 * The mockup's header reads "3 items · 2 held" and this page shipped that, and
 * both halves of it were wrong at once. The item count sums units while the
 * held count counted LINES, so four units on three lines rendered "4 items · 3
 * held" with every unit held; and the held clause was a render-time snapshot
 * printed above ribbons that keep ticking, so it still said "2 held" over two
 * ribbons that had both gone to "Hold released".
 *
 * The clause is gone rather than fixed. Every line already carries a live
 * ribbon saying what its own hold is doing — that is the signature of the
 * theme and it is the truth as of this second. A second, staler copy of the
 * same fact one line above it is not worth keeping honest.
 *
 * To be plain about what this is: a DELIBERATE DEVIATION from the mockup, which
 * still draws the header as "3 items · 2 held". It was not an application of a
 * written rule when it was made — §8 has since written the decision down, and
 * the mockup carries a banner naming this frame superseded. The mockup's frame is
 * only self-consistent at quantity 1, where units, lines and holds are the same
 * number; the moment a shopper raises a quantity the two halves count different
 * things. Ratified by the director on that basis: where the drawing cannot be
 * made true, appearance yields to correctness. Restoring the clause means
 * re-deciding that, not just re-adding a span.
 */
const itemCount = cart === null ? 0 : totalQty(cart);
const summary =
	cart === null || lines.length === 0
		? null
		: `${itemCount} ${itemCount === 1 ? "item" : "items"}`;

/**
 * The totals block (§7). The cart has ONE figure — the sum of the lines that
 * could be priced — so the rows say exactly that and nothing more: no invented
 * shipping, no synthetic zero, no tax this store has not calculated. What is
 * missing is named in prose, not marked with a dash.
 */
const asMoney = (wire: CartMoneyWire): CheckoutAmountView => ({ money: wire, label: wire.formatted });
const asProse = (label: string): CheckoutAmountView => ({ money: null, label });

const cartTotal = pricing?.total ?? null;
/** Nothing on this cart carries a figure — and the two reasons for that read
 *  differently to a shopper, so they are not collapsed into one sentence. */
const NO_SUBTOTAL = pricingDegraded ? "Unavailable right now" : PRICED_AT_CHECKOUT_CELL;
const NO_TOTAL = pricingDegraded ? "Unavailable right now" : "Confirmed at checkout";

const sumRows: SumRow[] = [
	{
		label: "Subtotal",
		amount: cartTotal === null ? asProse(NO_SUBTOTAL) : asMoney(cartTotal),
		fallback: NO_SUBTOTAL,
	},
	// The cart cannot know a shipping figure — it is quoted one step later — and
	// §7 forbids rendering that as "Free" or as "$0.00".
	{ label: "Shipping", amount: asProse("At checkout"), fallback: "At checkout" },
];
const totalAmount = cartTotal === null ? asProse(NO_TOTAL) : asMoney(cartTotal);

/** The old page's "(some items priced at checkout)", as §7's footnote: a
 *  partial total is only honest when it says what it is short of. */
const partialNote =
	cartTotal !== null && pricing !== null && !pricing.allLinesPriced
		? "Some items are priced at checkout, so this total isn't complete yet."
		: null;
/**
 * The model — every answer the view prints, decided above.
 *
 * The arms are decided HERE and handed over as flags, in the order the view
 * must honour them: `empty` wins over `terminal` (a checked-out cart that
 * somehow carries no lines still gets the invitation), and a DEGRADED read is
 * not an empty cart — the view shows the invitation only when `!degraded`.
 */
const model: CartModel = {
	summary,
	errorMessage: error !== null ? cartErrorMessage(error) : null,
	degraded,
	/* BUSY is the page's to say, never a theme's: the view gets the copy. */
	degradedLead: busy ? cartErrorMessage(BUSY) : "Your cart is unavailable right now.",
	/* Not over the terminal panel: it shows neither prices nor holds, so
	   "quantities and holds are still exact" would be a banner about a page
	   that is not on screen. */
	pricingNotice: cart !== null && !terminal && pricingDegraded,
	empty: cart === null || lines.length === 0,
	terminal,
	placedOrderId,
	lineViews,
	sumRows,
	totalAmount,
	partialNote,
};

/**
 * The countdown's script (ADR-0012's one sanctioned pair: this page →
 * HoldClock). Only on the LIVE arm, and only when some line actually holds
 * stock — a module script on a page with nothing to count is weight for
 * nothing, and the empty and terminal arms render no ribbon.
 */
const hasLiveHolds =
	!model.empty && !terminal && lines.some((line) => line.expiresAt !== null);
---

{/* The nav badge and the footer currency both reuse THIS page's cart read —
    the layout makes no commerce call of its own, and it never invents either
    value. `null` when there is no cart to read, so the nav renders a bare
    "Cart" rather than a misleading "Cart (0)" and the footer names no
    currency rather than guessing one.

    A CHECKED-OUT cart counts as nothing to the badge for the same reason: a
    "Cart (3)" on every page after a purchase is the loudest version of the
    complaint in issue #110, and those three units are the order's now. The
    currency is NOT suppressed with it — the cart still has one, and the footer
    naming it is still true. */}
<Storefront
	view="cart"
	model={model}
	title="Cart"
	cartCount={cart === null || terminal ? null : totalQty(cart)}
	currency={cart?.currency ?? null}
>
	{hasLiveHolds && <HoldClock slot="head" />}
</Storefront>
