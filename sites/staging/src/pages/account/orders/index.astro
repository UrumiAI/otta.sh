---
/**
 * GET /account/orders — the signed-in customer's orders (issue #306, ADR-0004).
 *
 * Identity comes from the session and nowhere else: the page passes the
 * `otta_session` cookie's value to `storefront/account/orders`, and the plugin
 * resolves the customer from it. No customer id is ever named here, so there is
 * no one else's list to ask for. Guest orders placed under the same address
 * appear because verifying the link claimed them.
 *
 * No session, or one the plugin no longer honours ⇒ 303 to /account/login. The
 * response is `private, no-store`, so neither a shared cache nor the back button
 * after logout can replay it.
 */
import { ACCOUNT_ORDERS_ROUTE, type AccountOrdersResult } from "@otta-sh/plugin";
import { getPublicPluginApiRouteHandler } from "emdash/plugin-utils";
import Notice from "../../../components/Notice.astro";
import Base from "../../../layouts/Base.astro";
import {
	ACCOUNT_NO_STORE,
	currentSessionToken,
	orderMoney,
	orderStateLabel,
} from "../../../lib/account.js";
import { cartErrorMessage } from "../../../lib/error-messages.js";
import { dispatchOttaRoute, isBusyResult, markBusy } from "../../../lib/otta-api.js";

Astro.response.headers.set("Cache-Control", ACCOUNT_NO_STORE);

const sessionToken = currentSessionToken(Astro.cookies);
if (sessionToken === undefined) return Astro.redirect("/account/login", 303);

const result = await dispatchOttaRoute<AccountOrdersResult>(
	getPublicPluginApiRouteHandler(Astro.locals),
	ACCOUNT_ORDERS_ROUTE,
	{ sessionToken },
	Astro.url,
);
if (result !== null && !result.ok && "redirectTo" in result) {
	return Astro.redirect("/account/login", 303);
}

const orders = result !== null && result.ok ? result.orders : null;
if (orders === null) Astro.response.status = 503;
// Busy (storage contention): the same 503, plus Retry-After and the busy copy.
const busy = isBusyResult(result);
if (busy) markBusy(Astro.response);

const rows =
	orders?.map((order) => ({
		id: order.id,
		href: `/account/orders/${encodeURIComponent(order.id)}`,
		state: orderStateLabel(order.state),
		items: order.lines.reduce((sum, line) => sum + line.quantity, 0),
		total: orderMoney(order.totals.totalCents, order.totals.currency),
	})) ?? [];
---

<Base title="Your orders">
	<div class="head-row">
		<h1 class="title">Your orders</h1>
		<form method="POST" action="/account/logout">
			<button type="submit" class="u-btn u-btn-ghost">Sign out</button>
		</form>
	</div>

	{
		orders === null ? (
			<div class="notice-slot" role="alert">
				<Notice>{cartErrorMessage(busy ? "BUSY" : "SERVICE_UNAVAILABLE")}</Notice>
			</div>
		) : rows.length === 0 ? (
			<p class="empty">
				No orders yet. Orders you place with this email address — including as a guest — appear
				here. <a href="/products">Browse products</a>
			</p>
		) : (
			<ul class="orders">
				{rows.map((row) => (
					<li class="order">
						<a class="ref u-mono" href={row.href}>
							{row.id}
						</a>
						<span class="state">{row.state}</span>
						<span class="items">{row.items === 1 ? "1 item" : `${row.items} items`}</span>
						<span class="total u-mono">{row.total}</span>
					</li>
				))}
			</ul>
		)
	}
</Base>

<style>
	.head-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}
	.head-row form {
		margin: 0;
	}

	.title {
		font-family: var(--u-display);
		font-variation-settings: "wdth" 78, "opsz" 48;
		font-weight: 700;
		font-size: clamp(1.75rem, 4vw, 2.25rem);
		letter-spacing: -0.025em;
		line-height: 1;
		margin: 0;
	}

	.notice-slot {
		margin-bottom: 1.5rem;
	}

	.empty {
		margin: 0;
		font-size: 0.875rem;
		color: var(--u-mute);
	}

	.orders {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: var(--u-hair);
	}

	.order {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) 1fr auto auto;
		gap: 1rem;
		align-items: baseline;
		padding: 0.875rem 0;
		border-bottom: var(--u-hair);
		font-size: 0.875rem;
	}

	.ref {
		color: var(--u-ink);
		overflow-wrap: anywhere;
	}

	.state,
	.items {
		color: var(--u-mute);
	}

	.total {
		color: var(--u-ink);
		text-align: right;
	}

	@media (max-width: 40rem) {
		.order {
			grid-template-columns: minmax(0, 1fr) auto;
		}
	}
</style>
