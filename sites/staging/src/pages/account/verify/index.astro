---
/**
 * GET /account/verify?challenge=…&token=… — where the emailed magic link lands
 * (issue #306, ADR-0004).
 *
 * THIS PAGE REDEEMS NOTHING. It renders one button that POSTs the challenge and
 * token to `/account/verify/confirm`, and that endpoint redeems them. Mail
 * scanners pre-fetch the links in a message; if the GET redeemed, the scanner
 * would spend the single-use token and the customer's own click would fail.
 *
 * The token is in this page's URL, so the page's referrer policy is
 * `same-origin`: no Referer ever leaves for another host. It is deliberately NOT
 * `no-referrer`, the policy the order page uses. Under `no-referrer` a browser
 * sends `Origin: null` on this page's own form POST, the origin guard rejects
 * that as cross-site, and every login would 403 at /account/verify/confirm
 * (caught in a real browser by `e2e/account-login.spec.ts`). Nothing from the
 * query is rendered except into the two hidden inputs the form needs.
 */
import Notice from "../../../components/Notice.astro";
import Base from "../../../layouts/Base.astro";
import { ACCOUNT_NO_STORE } from "../../../lib/account.js";
import { cartErrorMessage } from "../../../lib/error-messages.js";

Astro.response.headers.set("Cache-Control", ACCOUNT_NO_STORE);

const challenge = Astro.url.searchParams.get("challenge") ?? "";
const token = Astro.url.searchParams.get("token") ?? "";
const usable = challenge.length > 0 && token.length > 0;
---

<Base title="Sign in">
	<meta name="referrer" content="same-origin" slot="head" />
	<h1 class="title">Sign in</h1>

	{
		usable ? (
			<form method="POST" action="/account/verify/confirm" class="form">
				<input type="hidden" name="challenge" value={challenge} />
				<input type="hidden" name="token" value={token} />
				<p class="lede">Continue to finish signing in. The link works once.</p>
				<div>
					<button type="submit" class="u-btn">
						Continue signing in
					</button>
				</div>
			</form>
		) : (
			<>
				<div class="notice-slot" role="alert">
					<Notice>{cartErrorMessage("LOGIN_LINK_INVALID")}</Notice>
				</div>
				<p class="back">
					<a href="/account/login">Request a new sign-in link</a>
				</p>
			</>
		)
	}
</Base>

<style>
	.title {
		font-family: var(--u-display);
		font-variation-settings: "wdth" 78, "opsz" 48;
		font-weight: 700;
		font-size: clamp(1.75rem, 4vw, 2.25rem);
		letter-spacing: -0.025em;
		line-height: 1;
		margin: 0 0 1rem;
	}

	.lede {
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--u-mute);
	}

	.form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		max-width: 26rem;
	}

	.notice-slot {
		margin-bottom: 1.5rem;
		max-width: 34rem;
	}

	.back {
		margin: 0;
		font-size: 0.8125rem;
	}
	.back a {
		color: var(--u-mute);
	}
	.back a:hover {
		color: var(--u-ink);
	}
</style>
