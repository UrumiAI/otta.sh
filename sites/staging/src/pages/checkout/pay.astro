---
/**
 * GET /checkout/pay — the ONE page on this site that ships client JavaScript,
 * and the one third-party origin we permit (ADR-0012).
 *
 * Card data goes browser → Stripe and never touches our origin, which is what
 * keeps the deployment at PCI SAQ-A. That is not a nice-to-have: a self-hosted
 * card form would put PAN data on our servers and move every merchant running
 * this theme to SAQ-D.
 *
 * Everything the FORM needs — the order id, the client secret and the order's
 * total — is in the first-party `otta_checkout` cookie the place endpoint set one
 * redirect ago. Re-deriving the secret would mean a GET that can create an order,
 * and re-deriving the TOTAL would quote a still-live cart rather than the amount
 * the PaymentIntent was minted for.
 *
 * The page makes exactly ONE commerce call, and it is a READ: the order's own
 * state, through the same public `storefront/order` route the confirmation page
 * uses. The stash outlives the order's hold, and a client secret stays payable
 * at Stripe until something withdraws it — so a form rendered from the cookie
 * alone let a buyer pay an order that had already EXPIRED, for stock already
 * back on sale. An order that is not `pending`, or whose hold has lapsed, now
 * goes to its confirmation page instead (`lib/pay-guard.ts`, ADR-0012's
 * 2026-10-02 amendment). An unanswerable read still renders the form: the
 * server cancels an expired order's intent and refunds a payment that lands
 * anyway, so this page is defence in depth, never the only line.
 *
 * The script reads its inputs from `data-` attributes rather than having them
 * baked into JS source (no `define:vars`), so Astro's attribute escaping is the
 * boundary and there is no string-assembly step to get wrong.
 *
 * ── What the theme owns here (docs/theme/TEMPERED.md §8, §9) ──────────────
 * The FRAME — a narrow single column, the trust line, the box the fields sit
 * in — plus one `appearance` object. Stripe's fields render in a cross-origin
 * iframe, so they are the one surface this theme cannot reach with its own CSS;
 * the appearance object is how the tokens get across. Nothing else on this page
 * changes: not the tokenization, not the confirm call, not the return url.
 */
import { STOREFRONT_ORDER_ROUTE, type OrderRouteResult } from "@otta-sh/plugin";
import { getPublicPluginApiRouteHandler } from "emdash/plugin-utils";
import Notice from "../../components/Notice.astro";
import Storefront from "../../layouts/Storefront.astro";
import { readCheckoutStash } from "../../lib/checkout-cookie.js";
import { cartErrorMessage } from "../../lib/error-messages.js";
import { dispatchOttaRoute, isBusyResult } from "../../lib/otta-api.js";
import { payHoldCopy } from "../../lib/hold.js";
import { payPageRedirect } from "../../lib/pay-guard.js";
import { STRIPE_PUBLISHABLE_KEY } from "../../lib/stripe-config.js";
import { PAY_CLOSED_LEAD } from "../../lib/pay-deadline.js";
import { payButtonLabel } from "../../lib/totals.js";
import type { PayModel } from "../../themes/contract.js";
import { keepPrivate } from "../../lib/no-store.js";

/* This page renders the PaymentIntent's client secret: never stored by a shared cache, and kept out of
   Astro's route cache, which ignores Cache-Control (middleware.ts, "TWO
   CACHES") — QA U-7. Called FIRST so no rendered branch (an error state, a
   busy 503) goes out without it; a redirect is its own response and carries
   no body to store. */
keepPrivate(Astro);

const stash = readCheckoutStash(Astro.cookies);
// No stash (direct hit, expired cookie, cleared browser): there is nothing to
// pay for here. Back to the review step, which will itself bounce to /cart if
// the cart is gone.
if (stash === null) return Astro.redirect("/checkout", 303);

const orderUrl = new URL(`/orders/${encodeURIComponent(stash.orderId)}`, Astro.url).toString();
const orderPath = `/orders/${encodeURIComponent(stash.orderId)}`;

// Is the stashed order still payable? Read its OWN state — never trust the cookie
// for that: it outlives the hold. Expired, cancelled, already paid, or past its
// hold ⇒ its confirmation page, which states the truth. 303, like every other
// redirect this flow makes, so a reload cannot re-POST anything.
const orderRead = await dispatchOttaRoute<OrderRouteResult>(
	getPublicPluginApiRouteHandler(Astro.locals),
	STOREFRONT_ORDER_ROUTE,
	{ orderId: stash.orderId },
	Astro.url,
);
const refuseTo = payPageRedirect(orderPath, orderRead, new Date());
if (refuseTo !== null) return Astro.redirect(refuseTo, 303);

/** "Pay $40.00" (§7) — or "Pay now" for a stash minted before the total shipped.
 *  The page never assembles this string; the amount was formatted by the plugin
 *  at place-time and the label rule lives in `totals.ts`. */
const payLabel = payButtonLabel(stash.total?.formatted);

/** The page's own deadline, for its script (QA2 M1c): the hold deadline AND the
 *  server's now, so the browser only measures the time elapsed since load and a
 *  wrong browser clock cannot move it. From the read the guard just made; an
 *  unanswerable read states none, and the script then closes nothing. */
const payDeadline =
	orderRead !== null && !isBusyResult(orderRead) && orderRead.ok
		? orderRead.order.holdExpiresAt
		: undefined;
const renderedAt = new Date().toISOString();

/** The frame around the card fields — see the `payment` slot below. */
const model: PayModel = {
	paymentConfigured: STRIPE_PUBLISHABLE_KEY !== undefined,
	/* QUOTED from error-messages.ts's STRIPE_NOT_CONFIGURED rather than
	   restated here (§10). */
	notConfiguredLead: cartErrorMessage("STRIPE_NOT_CONFIGURED"),
	orderPath,
	emailHint: stash.emailHint ?? null,
	/* From the read the guard just made — no second commerce call. An
	   unanswerable read rendered the form anyway; it simply states no deadline. */
	holdNote:
		orderRead !== null && !isBusyResult(orderRead) && orderRead.ok
			? payHoldCopy(orderRead.order.holdExpiresAt, new Date())
			: null,
};
---

{/* The currency is the stash's own, and it is here BECAUSE the button now shows
    money — §7's rule is that a page naming a price names the currency it is in.
    A pre-total stash carries neither: `null`, and the footer stays bare, which
    is still the truth about what this page printed. */}
<Storefront view="pay" model={model} title="Payment" currency={stash.total?.currency ?? null}>
	{/* THE PAYMENT SLOT — the Stripe mount, the pay button, the no-JS
	    explanation and the script, all of it this page's (ADR-0012): the view
	    frames it and renders it once. Only when a key is configured, which is
	    also the only time the view renders the slot. */}
	{
		model.paymentConfigured && (
			<Fragment slot="payment">
				<form id="payment-form">
					<div class="mount">
						<div
							id="payment-element"
							data-client-secret={stash.clientSecret}
							data-publishable-key={STRIPE_PUBLISHABLE_KEY}
							data-return-url={orderUrl}
							data-pay-deadline={payDeadline}
							data-pay-server-now={renderedAt}
						/>
					</div>
					<p id="payment-error" class="pay-error" role="alert" hidden />
					{/* QA2 M1c: shown by the deadline script when the hold runs out
					    while this page is open. Rendered hidden, never built by the
					    script, so its words and its link are the page's. What it
					    promises matches ADR-0022's 2026-10-03 amendment: a payment
					    that arrived in time is kept, a late one is refunded — the
					    order page says which. */}
					<div id="payment-closed" hidden>
						<Notice lead={PAY_CLOSED_LEAD}>
							This order can't be paid any more. If you paid just before, your order page shows
							whether the payment arrived in time — a payment that arrived too late is refunded.{" "}
							<a href={orderPath}>View your order</a>.
						</Notice>
					</div>
					<button id="payment-submit" type="submit" class="u-btn">
						{payLabel}
					</button>
				</form>

				<noscript>
					<Notice>
						Entering card details requires JavaScript, because your card number is handled
						directly by our payment provider and never touches this site.{" "}
						{model.holdNote !== null ? (
							<>
								{model.holdNote.lead}, until {model.holdNote.until} —
							</>
						) : (
							<>Your order is reserved for a limited time —</>
						)}{" "}
						enable JavaScript and reload, or <a href={orderPath}>view your order</a>.
					</Notice>
				</noscript>

				<script is:inline src="https://js.stripe.com/v3/"></script>
				<script is:inline>
					(function () {
						var mount = document.getElementById("payment-element");
						var form = document.getElementById("payment-form");
						var errorBox = document.getElementById("payment-error");
						var submit = document.getElementById("payment-submit");
						if (!mount || !form || !errorBox || !submit) return;

						function fail(message) {
							errorBox.textContent = message;
							errorBox.hidden = false;
							submit.disabled = true;
						}

						/** Set by the deadline script (below) when the hold runs out
						 *  while this page is open (QA2 M1c). */
						function payClosed() {
							return form.dataset.payClosed === "true";
						}

						/** Pay comes back after a failed attempt — unless the time to
						 *  pay ran out meanwhile. */
						function reenable() {
							submit.disabled = payClosed();
						}

						if (typeof Stripe !== "function") {
							fail(
								"We couldn't load our payment provider. No charge has been made — please check your connection and reload.",
							);
							return;
						}

						// Read once, into locals: the mount node is handed to Stripe
						// below and its children are replaced, so nothing later depends
						// on reading back through the DOM.
						var clientSecret = mount.dataset.clientSecret;
						var returnUrl = mount.dataset.returnUrl;

						// ── the theme, handed across the iframe boundary (§9) ─────────
						// Read back as COMPUTED values rather than written down here:
						// `var(--u-ink)` means nothing inside Stripe's iframe, and
						// reading the live value is also what makes the dark palette —
						// and a future `data-theme` toggle — work with no second copy of
						// the palette to drift.
						var root = document.documentElement;
						function token(name) {
							return getComputedStyle(root).getPropertyValue(name).trim();
						}

						/**
						 * WHY THE SELF-HOSTED FACES DO NOT CROSS.
						 *
						 * Stripe can load a custom font, but it fetches `fonts[].src`
						 * from ITS OWN origin — the js.stripe.com iframe — which makes it
						 * a cross-origin font fetch needing `Access-Control-Allow-Origin`
						 * on `/_astro/fonts/*` (the built `_headers` sets cache-control
						 * only), and needing our origin to be HTTPS, since that iframe is
						 * and a browser blocks mixed content outright. An earlier cut
						 * walked `document.styleSheets` to hand Stripe the build-hashed
						 * family and its woff2 URL; measured, the font never loaded and
						 * the labels rendered off the generic tail — the same result, for
						 * ~50 lines of stylesheet walking on the payment page.
						 *
						 * So: NAMES ONLY. `fontFamily` carries the page's own resolved
						 * stack (build-hashed family first, generic tail behind it), which
						 * is exactly right if the fonts are ever served with CORS from
						 * HTTPS, and degrades to the right generic today. If you re-add
						 * the file handoff, prove it with a network trace from the STRIPE
						 * FRAME — the rendering looks the same either way.
						 */
						/**
						 * The data face, for the eyebrow labels — its NAME from the token
						 * layer, never written down here (§2), and a monospace generic
						 * behind it.
						 *
						 * Only the first family, and this is measured, not fastidious. The
						 * token resolves to
						 * `"Martian Mono-<hash>", "Martian Mono-<hash> fallback: Arial",
						 * sans-serif` — Astro's build-hashed face, its metric-adjusted
						 * local alias, and a generic Astro appends. Handing that over
						 * whole puts the labels in Stripe's default SANS: neither named
						 * face can load inside a cross-origin frame, a generic always
						 * resolves, and the one sitting third in that list is `sans-serif`
						 * (the alias's name also carries a colon, which a validator is
						 * entitled to reject outright). Keeping the head and choosing the
						 * tail is what makes the fallback land on a monospace — and leaves
						 * the real face named, for the day these are served with CORS over
						 * HTTPS and it can actually load.
						 */
						function monoStack() {
							var named = token("--u-data").split(",")[0].trim();
							return named ? named + ", ui-monospace, monospace" : "ui-monospace, monospace";
						}

						/**
						 * The appearance, or `undefined` if it cannot be built honestly.
						 *
						 * Returning undefined rather than a half-built object is the
						 * point: if the token layer did not load, every value here is the
						 * empty string, `border: "1px solid "` is invalid, and Stripe
						 * throws — which the mount below would otherwise report to the
						 * buyer as "this store cannot take payment". A missing stylesheet
						 * is not an unpayable order.
						 */
						function appearance() {
							var ink = token("--u-ink");
							var surface = token("--u-surface");
							var edge = token("--u-edge");
							var straw = token("--u-straw");
							var mute = token("--u-mute");
							var bronze = token("--u-bronze");
							if (!ink || !surface || !edge || !straw || !mute || !bronze) return undefined;
							var radius = token("--u-r") || "2px";
							var hair = "1px solid " + edge;
							// §11's ring is straw, 2px, at 2px offset. Stripe's rules do
							// not accept `outline-offset`, so the gap is drawn instead: a
							// 2px shadow in the surface colour, then 2px of straw behind
							// it.
							var ring = "0 0 0 2px " + surface + ", 0 0 0 4px " + straw;
							var selected = "inset 0 -2px 0 " + straw;
							return {
								theme: "stripe",
								variables: {
									// INK, not straw. Stripe paints `colorPrimary` as a FILL
									// (the selected tab, the spinner), and §2's rule is that
									// straw is a fitting and never a ground under text —
									// that is what keeps every label at full contrast.
									// Straw still appears here, as the 2px underline and the
									// focus ring below.
									colorPrimary: ink,
									colorBackground: surface,
									colorText: ink,
									colorTextSecondary: mute,
									colorTextPlaceholder: mute,
									colorDanger: bronze,
									colorIcon: mute,
									fontFamily: getComputedStyle(document.body).fontFamily,
									fontSizeBase: "14px",
									borderRadius: radius,
									spacingUnit: "4px",
								},
								rules: {
									// The uppercase mono eyebrow, same recipe as `.u-label`.
									".Label": {
										color: mute,
										fontFamily: monoStack(),
										fontSize: "9px",
										fontWeight: "500",
										letterSpacing: "0.11em",
										textTransform: "uppercase",
									},
									".Input": {
										backgroundColor: surface,
										color: ink,
										border: hair,
										borderRadius: radius,
										boxShadow: "none",
										padding: "10px 12px",
									},
									".Input::placeholder": { color: mute },
									".Input:focus": { border: hair, boxShadow: ring },
									".Input--invalid": { border: "1px solid " + bronze, color: ink, boxShadow: "none" },
									// Focus must not erase the error: the bronze border is
									// the state, the ring is only where the caret is.
									".Input--invalid:focus": {
										border: "1px solid " + bronze,
										color: ink,
										boxShadow: ring,
									},
									".Tab": {
										backgroundColor: surface,
										border: hair,
										borderRadius: radius,
										boxShadow: "none",
										color: mute,
									},
									".Tab:hover": { color: ink, boxShadow: selected },
									".Tab:focus": { boxShadow: ring },
									".Tab--selected": {
										backgroundColor: surface,
										border: hair,
										color: ink,
										boxShadow: selected,
									},
									// Same reason as the invalid input: which method is
									// selected is state, the ring is only focus. Listed
									// after both so it wins on order.
									".Tab--selected:focus": { color: ink, boxShadow: selected + ", " + ring },
									".TabIcon--selected": { color: ink },
									".Error": { color: bronze, fontSize: "13px" },
									".TermsText": { color: mute, fontSize: "12px" },
								},
							};
						}

						/** Never throws. Decoration may fail; the payment may not. */
						function safeAppearance() {
							try {
								return appearance();
							} catch (err) {
								return undefined;
							}
						}

						// Stripe.js validates the key SYNCHRONOUSLY and throws on a
						// malformed one — a secret key pasted into the publishable slot is
						// the realistic way that happens. Unguarded, the throw takes the
						// rest of this function with it, including the submit binding, and
						// the pay button becomes a native submit that navigates nowhere
						// useful with nothing said.
						var stripe;
						try {
							stripe = Stripe(mount.dataset.publishableKey);
						} catch (err) {
							fail("We couldn't reach our payment provider. Refresh to try again.");
							return;
						}

						/**
						 * Mount the Payment Element, themed or not. Throws on a genuinely
						 * unusable client secret — which is the only thing the buyer is
						 * ever told about.
						 *
						 * The created element is kept so a failed attempt can be torn down.
						 * `create()` can succeed and `mount()` still throw, which leaves a
						 * live element bound to an Elements group nobody holds any more:
						 * its iframe stays in the DOM with its listeners attached, and
						 * clearing the node underneath it only detaches the frame.
						 */
						var pending = null;
						function mountElements(options) {
							var made = stripe.elements(options);
							pending = made.create("payment");
							pending.mount("#payment-element");
							return made;
						}

						/** Undo a half-finished mount, so the retry starts from an empty node
						 *  and nothing is left listening to a detached frame. */
						function discardMount() {
							if (pending !== null) {
								try {
									pending.destroy();
								} catch (err) {
									// Already gone, or never fully created. Either is fine.
								}
								pending = null;
							}
							mount.textContent = "";
						}

						var elements = null;
						var themed = safeAppearance();
						try {
							var options = { clientSecret: clientSecret };
							if (themed !== undefined) options.appearance = themed;
							elements = mountElements(options);
						} catch (err) {
							// A THEMING failure must never declare the order unpayable, so
							// the appearance is dropped and the untuned widget tried once
							// before anything is said. Only if THAT fails is the secret
							// itself the problem — a service running without a Stripe
							// secret key mints an offline, unpayable one, and Stripe.js
							// rejects it here, synchronously.
							elements = null;
							if (themed !== undefined) {
								try {
									discardMount();
									elements = mountElements({ clientSecret: clientSecret });
								} catch (retryErr) {
									discardMount();
									elements = null;
								}
							}
							if (elements === null) {
								// The give-up path, and it must leave nothing behind. The
								// untuned retry only runs when there WAS an appearance to
								// drop; with no appearance the first mount is the only one,
								// so it can reach here having half-created an element and
								// written into the node. Idempotent — the retry's own
								// discard already ran on the other route.
								discardMount();
								fail(
									"This store's payment provider is running in offline test mode; this order cannot be paid. No charge has been made.",
								);
								return;
							}
						}

						// ── the money path is wired FIRST ─────────────────────────────
						// Everything below this binding is decoration, and decoration
						// that throws on an old browser must not be able to leave "Pay
						// now" as a bare native submit that navigates with no payment and
						// no error.
						form.addEventListener("submit", function (event) {
							event.preventDefault();
							// The deadline script stops a late submit before it gets here;
							// this is the belt for a browser where that script did not run.
							if (payClosed()) return;
							errorBox.hidden = true;
							submit.disabled = true;
							stripe
								.confirmPayment({
									elements: elements,
									confirmParams: { return_url: returnUrl },
								})
								.then(function (result) {
									// Only IMMEDIATE errors land here; a success redirects
									// away to the return_url. Nothing on this page ever
									// decides that an order is paid — the webhook does.
									if (result && result.error) {
										fail(
											result.error.message ||
												"That payment could not be completed. No charge has been made.",
										);
										reenable();
										// `retheme` stands down while the submit is disabled, so a
										// palette that changed during the confirm was skipped.
										// Re-enabling the button is the moment it can catch up.
										retheme();
									}
								})
								.catch(function () {
									fail("That payment could not be completed. No charge has been made.");
									reenable();
									retheme();
								});
						});

						// ── decoration only, from here down ───────────────────────────
						// Both palettes are real and either can change while this page is
						// open: the OS preference flips, or a toggle stamps `data-theme`
						// on <html>. Re-reading the tokens and pushing a fresh appearance
						// is the whole of it.
						function retheme() {
							// Mid-confirm — a 3DS sheet may be open over these fields.
							// Repainting them under the buyer at that moment is the one
							// time a correct palette is the wrong thing to do.
							if (submit.disabled) return;
							var next = safeAppearance();
							if (next === undefined) return;
							try {
								elements.update({ appearance: next });
							} catch (err) {
								// A palette that did not repaint is not worth a payment.
							}
						}
						try {
							var media = window.matchMedia("(prefers-color-scheme: dark)");
							// Safari < 14 / iOS ≤ 13 give a MediaQueryList with no
							// addEventListener. Feature-detected rather than assumed —
							// the deprecated addListener is not worth reaching for when
							// the only cost of skipping is that the widget keeps the
							// palette it mounted with.
							if (media && typeof media.addEventListener === "function") {
								media.addEventListener("change", retheme);
							}
							if (window.MutationObserver) {
								new MutationObserver(retheme).observe(root, {
									attributes: true,
									attributeFilter: ["data-theme"],
								});
							}
						} catch (err) {
							// No live re-theming on this browser. The mounted appearance
							// stands, and the payment is untouched.
						}
					})();
				</script>

				{/* THE DEADLINE (QA2 M1c) — a bundled module, so it imports the
				    deciding (`lib/pay-deadline.ts`, tested with a fake clock) rather
				    than restating it. Still this page's own script: ADR-0012 lets
				    exactly this page carry client JS. At the deadline it disables
				    Pay, hides the hold sentence, shows the closed notice and marks
				    the form, which the inline handler above refuses on. */}
				<script>
					import { payCloseAt, startPayDeadline } from "../../lib/pay-deadline.js";

					const loadedAt = Date.now();
					const mount = document.getElementById("payment-element");
					const form = document.getElementById("payment-form");
					const submit = document.getElementById("payment-submit");
					const closedNotice = document.getElementById("payment-closed");
					if (mount && form && submit && closedNotice) {
						const deadline = startPayDeadline(
							payCloseAt(mount.dataset.payDeadline, mount.dataset.payServerNow, loadedAt),
							{
								close() {
									form.dataset.payClosed = "true";
									(submit as HTMLButtonElement).disabled = true;
									closedNotice.hidden = false;
									for (const note of document.querySelectorAll<HTMLElement>("[data-pay-hold]")) {
										note.hidden = true;
									}
								},
							},
							{
								now: () => Date.now(),
								setTimer: (fn, ms) => window.setTimeout(fn, ms),
								clearTimer: (handle) => window.clearTimeout(handle as number),
							},
						);
						// A throttled or sleeping tab: re-check the moment it is looked at.
						const wake = (): void => void deadline.check();
						document.addEventListener("visibilitychange", wake);
						window.addEventListener("focus", wake);
						window.addEventListener("pageshow", wake);
						// CAPTURE on the document runs before the form's own handler, so
						// a submit after the deadline never reaches Stripe.
						document.addEventListener(
							"submit",
							(event) => {
								if (event.target !== form || deadline.allowSubmit()) return;
								event.preventDefault();
								event.stopImmediatePropagation();
							},
							true,
						);
					}
				</script>
			</Fragment>
		)
	}
</Storefront>

<style>
	/* The frame (steps, title, column, trust line, the way back) is the theme
	   view's; what is styled here is what this page itself renders into the
	   view's `payment` slot. */
	#payment-form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		align-items: flex-start;
	}

	/* The box Stripe's own fields sit in. The theme owns this hairline; the
	   fields inside it are styled by the appearance object above and by nothing
	   here — a scoped rule cannot cross into their iframe. */
	.mount {
		width: 100%;
		border: var(--u-hair);
		border-radius: var(--u-r);
		padding: 1.125rem;
		background: var(--u-surface);
	}

