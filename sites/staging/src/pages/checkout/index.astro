---
/**
 * GET /checkout — the review step. Zero client JS (the whole page is a form
 * POST); the only JS on this site lives one step later, on /checkout/pay.
 *
 * One dispatch does everything: `storefront/checkout/summary` returns both the
 * line items (from the cart + commerce join) and the QUOTE's totals, which are
 * authoritative — they are what `createOrderFromCart` will charge.
 *
 * Two things this page must never do:
 *  - render a payable-looking button over a cart that cannot be ordered. Every
 *    non-renderable state 303s to /cart instead (checkoutEntryRedirect).
 *  - render the pipeline's synthetic zeros as "Free shipping" / "Tax: $0.00".
 *    Nothing is configured, so nothing was calculated, and the totals block
 *    says exactly that. The rule is `Sum`'s, not this page's: the page hands
 *    over the view model's `CheckoutAmountView`s untouched and never inspects a
 *    label (docs/theme/TEMPERED.md §7).
 *
 * The coupon (#305 part 1) rides the URL as `?coupon=` (checkout-selection.ts):
 * a refused one is a notice beside the undiscounted totals, never a bounce. Once
 * the cart has become an order the review is LOCKED to that order — its totals,
 * its coupon — and the order's state decides what may be offered: a pending
 * order can still be paid, an ended one cannot (the page offers a new cart and
 * no pay button), and a paid one never reaches here (checkoutEntryRedirect sends
 * it to its confirmation).
 *
 * DELIVERY (#305 part 2, ADR-0021). The shipping/tax zone is derived from
 * where the order goes, so the review asks for that first: a second zero-JS GET
 * form — `?country=&region=&method=`, only coarse codes and an opaque id in the
 * URL — prices the cart for the destination and offers the matched zone's
 * delivery options as radios (a lone priced option comes back preselected).
 * The place form then carries the destination and the method the totals were
 * priced with as hidden fields, and the typed street address beside them. As
 * with the coupon, resubmitting the delivery form loses typed address fields.
 *
 * Shape (§8): step track, then two panels — the details form left (~1.15fr),
 * the order ledger + totals right.
 */
import {
	CART_COOKIE_NAME,
	STOREFRONT_CHECKOUT_SUMMARY_ROUTE,
	type CheckoutSummaryRouteResult,
} from "@otta-sh/plugin";
import { getPublicPluginApiRouteHandler } from "emdash/plugin-utils";
import Storefront from "../../layouts/Storefront.astro";
import { checkoutEmailNote, currentSessionToken, signedInEmail } from "../../lib/account.js";
import { keepPrivate } from "../../lib/no-store.js";
import { checkoutEntryRedirect } from "../../lib/checkout-redirect.js";
import { resumeHref } from "../../lib/checkout-resume.js";
import { reviewErrorToken } from "../../lib/checkout-review.js";
import {
	readCouponParam,
	readDestinationParams,
	readMethodParam,
} from "../../lib/checkout-selection.js";
import { countryOptions } from "../../lib/countries.js";
import { SITE_LOCALE } from "../../lib/site-locale.js";
import { cartErrorMessage } from "../../lib/error-messages.js";
import { checkoutFootnote } from "../../lib/totals.js";
import { STRIPE_PUBLISHABLE_KEY } from "../../lib/stripe-config.js";
import { dispatchOttaRoute } from "../../lib/otta-api.js";
import type { CheckoutModel } from "../../themes/contract.js";

/* This page renders one shopper's cart, email and delivery choice: never stored by a shared cache, and kept out of
   Astro's route cache, which ignores Cache-Control (middleware.ts, "TWO
   CACHES") — QA U-7. Called FIRST so no rendered branch (an error state, a
   busy 503) goes out without it; a redirect is its own response and carries
   no body to store. */
keepPrivate(Astro);

/* The coupon rides this page's URL, so no Referer carrying it may leave for
   another origin. Sent as a HEADER as well as the meta below, as defence in
   depth: the header covers every subresource fetched before the parser reaches
   the meta, which arrives through `<slot name="head">` after the layout's
   preloads. `same-origin`, not `no-referrer` — see the meta's comment. */
Astro.response.headers.set("Referrer-Policy", "same-origin");

const cartId = Astro.cookies.get(CART_COOKIE_NAME)?.value;
const error = Astro.url.searchParams.get("error");
/** Trimmed, case kept. A code over the plugin's cap is refused HERE (as not
 *  found) and never dispatched. */
const coupon = readCouponParam(Astro.url);
/** Where the order goes (ADR-0021). A region that is not even a code is refused
 *  HERE and never dispatched; a destination that changed from the one the page
 *  was rendered for drops the method chosen for the old one. */
const destinationRead = readDestinationParams(Astro.url);
const method = destinationRead.methodDropped ? undefined : readMethodParam(Astro.url);

const result =
	cartId !== undefined && cartId.length > 0
		? await dispatchOttaRoute<CheckoutSummaryRouteResult>(
				getPublicPluginApiRouteHandler(Astro.locals),
				STOREFRONT_CHECKOUT_SUMMARY_ROUTE,
				{
					cartId,
					locale: SITE_LOCALE,
					...(coupon.couponCode !== undefined ? { couponCode: coupon.couponCode } : {}),
					...(destinationRead.destination !== undefined
						? { destination: destinationRead.destination }
						: {}),
					...(method !== undefined ? { shippingMethodId: method } : {}),
				},
				Astro.url,
			)
		: null;

/* A BUSY summary (already retried once) deliberately takes the same 303 to
   /cart?error=BUSY as every other non-renderable state, NOT a 503 here: /checkout
   is a transactional GET only a buyer with a cart reaches (nothing to crawl or
   cache), and /cart is where they can act — it shows the busy copy, and its own
   cart read answers 503 + Retry-After if the store is still busy. Rendering a
   bare busy page here would strand the buyer on a step with nothing to do. */
const redirect = checkoutEntryRedirect(cartId, result);
if (redirect !== null) {
	const target = new URL(redirect.path, Astro.url);
	if (redirect.error !== undefined) target.searchParams.set("error", redirect.error);
	return Astro.redirect(target.pathname + target.search, 303);
}

// `checkoutEntryRedirect` returning null means exactly this shape.
const summary = result as Extract<CheckoutSummaryRouteResult, { ok: true }>;
const { lines, totals } = summary;

/** No key ⇒ no payment step, and NO order is created: creating one would hold
 *  stock for a payment the buyer cannot make. (A key that is present but
 *  malformed never reaches here — it fails the build; see stripe-config.ts.) */
const paymentConfigured = STRIPE_PUBLISHABLE_KEY !== undefined;

/** The dead-cart trap's exit, offered only where it applies. */
const checkedOut = error === "CART_CHECKED_OUT";

/** LOCKED: this cart has already become an order (pending or ended — a paid one
 *  was redirected above). ENDED: that order can no longer be paid, and
 *  `expireOrders` does not reopen the cart, so a pay button would lead nowhere. */
const locked = summary.orderCreated ? summary.order : null;
const ended = locked?.phase === "ended";

/** The `?error=` this render may show. A LOCKED review drops it: a place-time
 *  refusal describes a form that is no longer here — typically the history entry
 *  Back returns to from the pay page (QA U-2). */
const shownError = reviewErrorToken(error, locked !== null);

/** The coupon refusal to explain, from the plugin or from the cap check above.
 *  Its code goes back into the field so a typo can be fixed. */
const couponError = summary.selectionErrors.coupon ?? coupon.rejected ?? null;
const couponValue = couponError?.code ?? summary.selection.couponCode ?? "";
const shippingError = summary.selectionErrors.shippingMethod ?? null;
/** A refused destination — by the plugin, or by the shape check above. */
const destinationError = summary.selectionErrors.destination ?? destinationRead.rejected ?? null;

/** The destination the totals were priced for, or null. */
const destination = summary.selection.destination;
/** What the delivery form's fields show: the priced destination, else what was
 *  typed and refused (so a typo can be fixed). */
const countryValue = destination?.country ?? destinationRead.rejected?.country ?? "";
const regionValue = destination?.region ?? destinationRead.rejected?.region ?? "";

/** The delivery form: an unlocked cart that ships, in a store with zones. */
const showDelivery = locked === null && summary.requiresShipping && summary.shipping.status !== "no_zones";
/** The address block: an unlocked cart that ships. On a store with NO zones
 *  it also asks for the country; otherwise the country/region are the hidden
 *  destination above. */
const showAddress = locked === null && summary.requiresShipping;
/** Named in the same language the summary formatted the money in. */
const countries = countryOptions(SITE_LOCALE);
const countryName = (code: string): string => countries.find((c) => c.code === code)?.label ?? code;

/** The option the totals were priced with — stated beside the submit, so the
 *  method charged is on the page even if a radio was changed without Update. */
const chosenOption =
	summary.shipping.options.find((option) => option.id === summary.selection.shippingMethodId) ??
	null;

/** Why the place button is not offered yet (unlocked only). */
const notReadyCopy = summary.shipping.noOptions
	? cartErrorMessage("SHIPPING_METHOD_REQUIRED")
	: summary.shipping.status === "matched"
		? "Choose a delivery option above to continue."
		: "Choose where we're delivering above to continue.";

/** The signed-in shopper's own address, prefilled into the email field — the
 *  order is filed under their account only when placed with it (the plugin's
 *  rule; place.ts forwards the session). `null` when signed out. */
if (currentSessionToken(Astro.cookies) !== undefined) keepPrivate(Astro);
const accountEmail = await signedInEmail(
	getPublicPluginApiRouteHandler(Astro.locals),
	Astro.cookies,
	Astro.url,
);

/** Name / SKU / qty / money. The name is the summary's `title` — the string
 *  the order will snapshot (the locked review's IS the snapshot) — so this,
 *  the last summary before paying, reads as the receipt will. A line the store
 *  cannot name leaves the SKU standing alone, never a made-up name. The money
 *  cell is `lineTotal.formatted` or the honest prose; never assembled. */
const ledgerRows = lines.map((line) => ({
	...(line.title !== null ? { title: line.title } : {}),
	sku: line.sku,
	qty: line.qty,
	money: line.lineTotal?.formatted ?? "priced at checkout",
}));

/** The coupon code rides on the row's own label rather than a second line: it
 *  IS the name of that discount, and the totals block has one slot per row. */
const discountLabel =
	totals.appliedCouponCode !== null ? `Discount · ${totals.appliedCouponCode}` : "Discount";

/**
 * Straight off the view model (§7). The only thing this page adds is the
 * `fallback` for the discount row — the page knows WHY it is empty ("no coupon
 * applied"), which is the one thing `Sum` cannot work out for itself.
 */
const sumRows = [
	{ label: "Subtotal", amount: totals.subtotal },
	{ label: discountLabel, amount: totals.discount, fallback: "No coupon applied" },
	{ label: "Shipping", amount: totals.shipping },
	{ label: "Tax", amount: totals.tax },
];
/**
 * The model — every answer the view prints. The refusals arrive as COPY: the
 * token-to-sentence mapping (§10) is the page's, so no theme can print a raw
 * token or phrase one differently.
 */
const model: CheckoutModel = {
	summary,
	errorMessage: shownError !== null ? cartErrorMessage(shownError) : null,
	checkedOut,
	locked: locked === null ? null : { id: locked.id, resumeHref: resumeHref(locked.id) },
	ended,
	couponValue,
	couponError: couponError !== null ? cartErrorMessage(couponError.reason) : null,
	destinationError: destinationError !== null ? cartErrorMessage(destinationError.reason) : null,
	shippingError: shippingError !== null ? cartErrorMessage(shippingError.reason) : null,
	noOptionsCopy: cartErrorMessage("SHIPPING_METHOD_REQUIRED"),
	destination,
	destinationName: destination !== null ? countryName(destination.country) : null,
	countryValue,
	regionValue,
	countries,
	showDelivery,
	showAddress,
	chosenOption,
	notReadyCopy,
	paymentConfigured,
	/* Quoted from error-messages.ts's STRIPE_NOT_CONFIGURED rather than
	   restated (§10). */
	notConfiguredLead: cartErrorMessage("STRIPE_NOT_CONFIGURED"),
	emailValue: accountEmail ?? "",
	emailNote: checkoutEmailNote(accountEmail),
	ledgerRows,
	sumRows,
	footnote: checkoutFootnote(summary.uncalculatedReason, sumRows, totals.totalExcludesUncalculated),
};
---

{/* The footer's currency comes from the totals this page already holds —
    the layout never invents one (§7). */}
<Storefront view="checkout" model={model} title="Checkout" currency={totals.total.money?.currency ?? null}>
	{/* The coupon code is in this page's URL; no subresource or outbound link
	    may carry it off to another host in a Referer. `same-origin`, NOT
	    `no-referrer`: under `no-referrer` browsers send `Origin: null` on this
	    page's own form POSTs (/checkout/place, /checkout/new-cart) — Fetch's
	    "append a request `Origin` header" — the origin guard reads that as
	    cross-site, and every real order is refused with a 403 (the bug
	    /account/verify hit in #329). `same-origin` still sends no Referer to any
	    other origin; the full-URL Referer those POSTs do carry is cut off by
	    their responses' own `no-referrer` header (cart-actions.ts,
	    `withoutReferrer`). Also sent as a response header (frontmatter). */}
	<meta name="referrer" content="same-origin" slot="head" />
</Storefront>
