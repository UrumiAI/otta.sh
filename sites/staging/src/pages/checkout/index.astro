---
/**
 * GET /checkout — the review step. Zero client JS (the whole page is a form
 * POST); the only JS on this site lives one step later, on /checkout/pay.
 *
 * One dispatch does everything: `storefront/checkout/summary` returns both the
 * line items (from the cart + commerce join) and the QUOTE's totals, which are
 * authoritative — they are what `createOrderFromCart` will charge.
 *
 * Two things this page must never do:
 *  - render a payable-looking button over a cart that cannot be ordered. Every
 *    non-renderable state 303s to /cart instead (checkoutEntryRedirect).
 *  - render the pipeline's synthetic zeros as "Free shipping" / "Tax: $0.00".
 *    Nothing is configured, so nothing was calculated, and the totals block
 *    says exactly that. The rule is `Sum`'s, not this page's: the page hands
 *    over the view model's `CheckoutAmountView`s untouched and never inspects a
 *    label (docs/theme/TEMPERED.md §7).
 *
 * Shape (§8): step track, then two panels — the details form left (~1.15fr),
 * the order ledger + totals right.
 */
import {
	CART_COOKIE_NAME,
	STOREFRONT_CHECKOUT_SUMMARY_ROUTE,
	type CheckoutSummaryRouteResult,
} from "@urumi/plugin";
import { getPublicPluginApiRouteHandler } from "emdash/plugin-utils";
import Ledger from "../../components/Ledger.astro";
import Notice from "../../components/Notice.astro";
import StepTrack from "../../components/StepTrack.astro";
import Sum from "../../components/Sum.astro";
import Base from "../../layouts/Base.astro";
import { checkoutEntryRedirect } from "../../lib/checkout-redirect.js";
import { cartErrorMessage } from "../../lib/error-messages.js";
import { STRIPE_PUBLISHABLE_KEY } from "../../lib/stripe-config.js";
import { dispatchUrumiRoute } from "../../lib/urumi-api.js";

const cartId = Astro.cookies.get(CART_COOKIE_NAME)?.value;
const error = Astro.url.searchParams.get("error");

const result =
	cartId !== undefined && cartId.length > 0
		? await dispatchUrumiRoute<CheckoutSummaryRouteResult>(
				getPublicPluginApiRouteHandler(Astro.locals),
				STOREFRONT_CHECKOUT_SUMMARY_ROUTE,
				{ cartId },
				Astro.url,
			)
		: null;

const redirect = checkoutEntryRedirect(cartId, result);
if (redirect !== null) {
	const target = new URL(redirect.path, Astro.url);
	if (redirect.error !== undefined) target.searchParams.set("error", redirect.error);
	return Astro.redirect(target.pathname + target.search, 303);
}

// `checkoutEntryRedirect` returning null means exactly this shape.
const summary = result as Extract<CheckoutSummaryRouteResult, { ok: true }>;
const { lines, totals } = summary;

/** No key ⇒ no payment step, and NO order is created: creating one would hold
 *  stock for a payment the buyer cannot make. (A key that is present but
 *  malformed never reaches here — it fails the build; see stripe-config.ts.) */
const paymentConfigured = STRIPE_PUBLISHABLE_KEY !== undefined;

/** The dead-cart trap's exit, offered only where it applies. */
const checkedOut = error === "CART_CHECKED_OUT";

/** SKU / qty / money — the same tape the home page opens with, itemised. The
 *  money cell is `lineTotal.formatted` or the honest prose; never assembled. */
const ledgerRows = lines.map((line) => ({
	sku: line.sku,
	qty: line.qty,
	money: line.lineTotal?.formatted ?? "priced at checkout",
}));

/** The coupon code rides on the row's own label rather than a second line: it
 *  IS the name of that discount, and the totals block has one slot per row. */
const discountLabel =
	totals.appliedCouponCode !== null ? `Discount · ${totals.appliedCouponCode}` : "Discount";

/**
 * Straight off the view model (§7). The only thing this page adds is the
 * `fallback` for the discount row — the page knows WHY it is empty ("no coupon
 * applied"), which is the one thing `Sum` cannot work out for itself.
 */
const sumRows = [
	{ label: "Subtotal", amount: totals.subtotal },
	{ label: discountLabel, amount: totals.discount, fallback: "No coupon applied" },
	{ label: "Shipping", amount: totals.shipping },
	{ label: "Tax", amount: totals.tax },
];
---

{/* The footer's currency comes from the totals this page already holds —
    the layout never invents one (§7). */}
<Base title="Checkout" currency={totals.total.money?.currency ?? null}>
	{/* The components are wrapped rather than handed a class: a page's scoped
	    selector deliberately cannot reach a component's root (see
	    src/lib/rest-props.ts), so spacing AROUND one belongs to an element the
	    page owns. */}
	<div class="steps"><StepTrack current="details" /></div>
	<h1 class="title">Checkout</h1>

	{error !== null && <div class="notice-slot"><Notice>{cartErrorMessage(error)}</Notice></div>}

	{
		checkedOut && (
			<form method="POST" action="/checkout/new-cart" class="restart">
				<button type="submit" class="u-btn u-btn-ghost">
					Start a new cart
				</button>
			</form>
		)
	}

	<div class="cols">
		<section class="panel">
			<div class="panel-head">
				<h2 class="u-label head-label">Your details</h2>
			</div>

			<form method="POST" action="/checkout/place" class="details">
				{/* STABLE per cart (checkout:<cartId>), so a reload or a double-submit
				    replays into the SAME order and the same PaymentIntent instead of
				    minting a second order the CART_CHECKED_OUT fence would reject. */}
				<input type="hidden" name="idempotencyKey" value={summary.idempotencyKey} />

				{/* The note is a SIBLING of the label, not inside it. Nested, its
				    ~25 words join the field's ACCESSIBLE NAME and get read out in
				    full every time the input takes focus; `aria-describedby` is how
				    a hint attaches — announced after the name, and as a hint. */}
				<div class="field">
					<label class="u-label" for="email">
						Email <span class="req">required</span>
					</label>
					<input
						type="email"
						id="email"
						name="email"
						required
						autocomplete="email"
						aria-describedby="email-note"
					/>
					<span class="note" id="email-note">
						We use this to send your order confirmation and to link the order to your account if
						you sign in later.
					</span>
				</div>

				<fieldset class="group">
					<legend class="u-label head-label">Delivery address</legend>
					<p class="note group-note">
						Optional — fill it in completely, or leave it entirely blank.
					</p>
					<div class="fields">
						<label class="field span2">
							<span class="u-label">Full name</span>
							<input type="text" name="name" autocomplete="name" />
						</label>
						<label class="field span2">
							<span class="u-label">Address line 1</span>
							<input type="text" name="line1" autocomplete="address-line1" />
						</label>
						<label class="field span2">
							<span class="u-label">Address line 2</span>
							<input type="text" name="line2" autocomplete="address-line2" />
						</label>
						<label class="field">
							<span class="u-label">City</span>
							<input type="text" name="city" autocomplete="address-level2" />
						</label>
						<label class="field">
							<span class="u-label">Region / state</span>
							<input type="text" name="region" autocomplete="address-level1" />
						</label>
						<label class="field">
							<span class="u-label">Postal code</span>
							<input type="text" name="postalCode" autocomplete="postal-code" />
						</label>
						<label class="field">
							<span class="u-label">Country</span>
							<input type="text" name="country" autocomplete="country-name" />
						</label>
						<label class="field span2">
							<span class="u-label">Phone</span>
							<input type="tel" name="phone" autocomplete="tel" />
						</label>
					</div>
				</fieldset>

				{
					paymentConfigured ? (
						<div>
							<button type="submit" class="u-btn">
								Continue to payment
							</button>
						</div>
					) : (
						/* Lead QUOTED from error-messages.ts's STRIPE_NOT_CONFIGURED
						   rather than restated here (§10). */
						<Notice lead={cartErrorMessage("STRIPE_NOT_CONFIGURED")}>
							This order can't be placed. Nothing has been charged and your cart is unchanged.
						</Notice>
					)
				}
			</form>
		</section>

		<section class="panel">
			<div class="panel-head">
				<h2 class="u-label head-label">Your order</h2>
			</div>

			{
				summary.hasUnpricedLines && (
					<Notice>
						Live prices for some items are temporarily unavailable — the totals below come from
						the store and are what you will be charged.
					</Notice>
				)
			}

			<Ledger rows={ledgerRows} />
			<Sum
				rows={sumRows}
				total={totals.total}
				excludesUncalculated={totals.totalExcludesUncalculated}
			/>
		</section>
	</div>

	<p class="back"><a href="/cart">Back to cart</a></p>
</Base>

<style>
	.steps {
		margin-bottom: 1.75rem;
	}

	/* §3: the display face, narrow. One size down from the order stamp — this
	   page's weight belongs on the panels, not the title. */
	.title {
		font-family: var(--u-display);
		font-variation-settings: "wdth" 78, "opsz" 48;
		font-weight: 700;
		font-size: clamp(1.75rem, 4vw, 2.25rem);
		letter-spacing: -0.025em;
		line-height: 1;
		margin: 0 0 1.5rem;
		text-wrap: balance;
	}

	/* `.notice-slot` is the name every other page gives this wrapper — the PDP,
	   the PLP and the cart all use it — so it is what this one uses too. */
	.notice-slot,
	.restart {
		margin-bottom: 1.5rem;
	}
	.restart {
		margin-top: -0.5rem;
	}

	/* §8: ~1.15fr / 1fr — the form carries more, so it gets more. */
	.cols {
		display: grid;
		grid-template-columns: 1.15fr 1fr;
		gap: 3rem;
		align-items: start;
	}

	.panel {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		/* Without this a long SKU in the ledger can widen its grid track and take
		   the page with it (§11). */
		min-width: 0;
	}

	.panel-head {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding-bottom: 0.75rem;
		border-bottom: var(--u-hair);
	}
	/* A section's own name reads at full contrast; a field's does not. These are
	   real <h2>/<legend> elements — the eyebrow is a TREATMENT, not a demotion,
	   so a screen reader still gets a heading to navigate by — which leaves only
	   the UA margin to undo. `.u-label` (tokens.css) already beats the UA sheet
	   on specificity for size and weight. */
	.head-label {
		margin: 0;
		color: var(--u-ink);
	}

	.details {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		min-width: 0;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		min-width: 0;
	}

	.field input {
		width: 100%;
		padding: 0.625rem 0.75rem;
		border: var(--u-hair);
		border-radius: var(--u-r);
		background: var(--u-surface);
		color: var(--u-ink);
		font-family: var(--u-body);
		font-size: 0.875rem;
	}

	.note {
		margin: 0;
		font-size: 0.75rem;
		line-height: 1.5;
		color: var(--u-mute);
	}

	/* "required" must not fuse into the uppercase mono label beside it, so it
	   steps out of the label's recipe entirely — body face, sentence case, and
	   straw as a fitting rather than a colour-coded badge (§2). */
	.req {
		font-family: var(--u-body);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0;
		text-transform: none;
		color: var(--u-straw);
	}
	.req::before {
		content: "· ";
		color: var(--u-edge);
	}

	/* A real <fieldset>/<legend> — the address block is one answer in eight
	   boxes and a screen reader should hear it that way — with the browser's
	   box removed so the theme's own hairline is the only divider (§2). */
	.group {
		border: none;
		margin: 0;
		padding: 0;
		min-width: 0;
	}
	.group legend {
		padding: 0;
		color: var(--u-ink);
	}
	/* The address block gets the same head treatment as a panel: its own name,
	   its own note, and the hairline that separates a section from its fields. */
	.group-note {
		padding: 0.25rem 0 0.75rem;
		margin-bottom: 1rem;
		border-bottom: var(--u-hair);
	}

	.fields {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.875rem;
	}
	.span2 {
		grid-column: 1 / -1;
	}

	/* "Continue to payment" is `.u-btn` and the dead-cart escape is
	   `.u-btn .u-btn-ghost` (tokens.css) — §2's one shape, written down once.
	   This page's copy of it had already drifted from the others' (it wrote the
	   transparent inset as `rgba(0, 0, 0, 0)`, which is also the only raw colour
	   left anywhere in the theme). */

	.back {
		margin: 2.5rem 0 0;
		font-size: 0.8125rem;
	}
	.back a {
		color: var(--u-mute);
	}
	.back a:hover {
		color: var(--u-ink);
	}

	/* The two panels stop being two columns well before the phone: the address
	   grid needs the width more than the layout needs the split.

	   DELIBERATE, and it looks like an oversight: stacked, the details panel
	   comes first, so "Continue to payment" sits ABOVE the order summary. That
	   is the mockup's own stacking (details panel, then order panel), it keeps
	   DOM order and focus order identical, and the summary a shopper is
	   reviewing is the thing they scroll to last on the way back up. Reordering
	   with `order:` would split the visual and tab sequences. */
	@media (max-width: 54rem) {
		.cols {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}

	@media (max-width: 26rem) {
		.fields {
			grid-template-columns: 1fr;
		}
	}
</style>
