---
/**
 * MediaPanel — where a product's picture goes (docs/theme/TEMPERED.md §4, §5).
 *
 * A neutral `--u-panel` ground carrying ONE generated coil, keyed to the
 * product's slug so a fresh install with no photography still looks
 * intentional and no two products repeat. When the product actually has an
 * image, the image replaces the coil entirely — the panel is never a frame
 * around a photo, it is the fallback FOR one.
 *
 * The coil is `aria-hidden`: it carries no information, it is generated art.
 */
import type { HTMLAttributes } from "astro/types";
import { buildCoil, COIL_HEIGHT, COIL_WIDTH } from "../lib/coil.js";
import { restProps } from "../lib/rest-props.js";

interface Props extends HTMLAttributes<"span"> {
	/** Keys the coil's GEOMETRY — any stable per-product string (slug, or the
	 *  id when a product has no slug). Same value in ⇒ same drawing, always. */
	slug: string;
	/** The product's position in the list being rendered, which cycles the
	 *  TINT so every three products show all three (see `coilTint`). Omit it
	 *  off a list — the tint then falls back to the slug's own hash. */
	index?: number;
	/** The product's image. Present ⇒ the coil is not drawn at all (§5). */
	image?: string | null;
	/** Alt text for that image. Empty by default: on a card the product title
	 *  sits directly beneath, and repeating it is noise to a screen reader. A
	 *  page where the image is the ONLY description of the product passes real
	 *  text. */
	alt?: string;
	/** The panel's shape. The catalog runs 4/3, the PDP 4/5, a cart thumbnail
	 *  1 — the ratio is layout, so the page owns it. */
	ratio?: string;
	/**
	 * Dims the art, for a product that cannot be bought right now.
	 *
	 * A PROP rather than something the parent styles from outside, and that is
	 * not a preference: Astro scopes a component's CSS to its OWN hash, so a
	 * parent rule like `.card[cid-parent] .card-media[cid-parent]` must not
	 * match this element, which carries this component's hash instead. The
	 * first cut of ProductCard did exactly that, and the dimming silently did
	 * nothing.
	 *
	 * "Must not", and not "cannot", because it only holds while this root
	 * carries ONE hash. Astro hands a nested component its parent's scope key
	 * as a prop, so spreading `...rest` raw would stamp that key back onto this
	 * element and the parent's rule would match after all. `restProps` drops
	 * it, which is what makes the sentence above true again.
	 */
	dimmed?: boolean;
}

const {
	slug,
	index,
	image = null,
	alt = "",
	ratio = "4 / 3",
	dimmed = false,
	class: className,
	...rest
} = Astro.props;

const coil = image === null ? buildCoil(slug, index) : null;
---

<span class:list={["media", dimmed && "dimmed", className]} style={`--media-ratio: ${ratio}`} {...restProps(rest)}>
	{
		coil === null ? (
			<img src={image} alt={alt} loading="lazy" decoding="async" />
		) : (
			/* The tint arrives as a custom property and is applied from the style
			   block below, NOT as a `fill="var(…)"` presentation attribute. A
			   var() in an SVG presentation attribute has a long history of not
			   resolving in WebKit, and the failure mode is not subtle: `fill`
			   falls back to its initial value, which is BLACK, so every card on
			   the page renders as a black square with a black coil on it. */
			<svg
				viewBox={`0 0 ${COIL_WIDTH} ${COIL_HEIGHT}`}
				preserveAspectRatio="xMidYMid slice"
				aria-hidden="true"
				focusable="false"
				style={`--coil-tint: var(${coil.tint})`}
			>
				<rect class="panel" width={COIL_WIDTH} height={COIL_HEIGHT} />
				<path class="coil" d={coil.path} />
			</svg>
		)
	}
</span>

<style>
	/* §2: 2px radius, no border, no shadow. The panel's own ground is the only
	   fill in the theme, and it means exactly one thing: "image goes here". */
	.media {
		display: block;
		position: relative;
		aspect-ratio: var(--media-ratio, 4 / 3);
		border-radius: var(--u-r);
		overflow: hidden;
		background: var(--u-panel);
	}

	.media svg,
	.media img {
		display: block;
		width: 100%;
		height: 100%;
		/* The coil slices; a photograph is cropped to the same box rather than
		   letterboxed, so a row of cards keeps one baseline grid. */
		object-fit: cover;
	}

	.panel {
		fill: var(--u-panel);
	}

	.coil {
		fill: var(--coil-tint);
		opacity: var(--u-coil-a);
	}

	/* Sold out dims the art rather than stamping the card — the product is
	   still worth looking at, it just cannot be bought today. */
	.dimmed {
		opacity: 0.45;
	}
</style>
