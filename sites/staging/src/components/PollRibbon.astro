---
/**
 * PollRibbon — the hold ribbon running INDETERMINATE (docs/theme/TEMPERED.md
 * §6), for `/orders/<id>` while an order is pending.
 *
 * Its authority is §6 — "the same ribbon reappears on `/orders/<id>` while an
 * order is `pending`, running indeterminate … with the poll count in mono" —
 * and NOT the §4 component table, which still lists this as a variant of
 * `HoldRibbon`. Splitting it was forced by ADR-0012 (see below); the spec text
 * catches up in its own [Docs] change.
 *
 * Same grammar as `HoldRibbon`: a 2px track in `--u-edge` and a violet mark,
 * so a shopper who has read the cart's hold has read this too. What differs is
 * what it means. A hold has a duration, so its ribbon drains against a real
 * `expiresAt` and needs a client clock. A poll has no duration — the webhook
 * lands when it lands — so there is nothing to count down, the sweep says only
 * "still working", and the COUNT beside it carries all the information.
 *
 * Which is the reason this is its own file rather than a `variant` on
 * `HoldRibbon`. That component carries a bundled `<script>` for its countdown,
 * and Astro emits a component's script whenever the component renders — so
 * sharing one would have put ~1 kB of countdown machinery on the confirmation
 * page, which ADR-0012 decision 2 keeps free of client JavaScript. Nothing here
 * runs in the browser: the sweep is a CSS animation on a page that reloads
 * itself through a bounded `<meta http-equiv="refresh">`, and the count is
 * rendered by the server on every hop.
 *
 * That is a PROPERTY, not a preference — `checkout-client-js.test.ts` walks
 * each page's component imports transitively and fails if any browser code
 * reaches a page specified to have none.
 *
 * The sweep IS decoration — the count is the information — so unlike the
 * countdown it is NOT exempt from the reduced-motion clamp, and it settles into
 * a static filled track rather than freezing mid-stride at a keyframe.
 */
import type { HTMLAttributes } from "astro/types";
import { restProps } from "../lib/rest-props.js";

interface Props extends HTMLAttributes<"div"> {
	/** "Checking 3 of 8" — which hop of the page's bounded poll this is. */
	poll: number;
	pollMax: number;
	label?: string;
}

const { poll, pollMax, label = "Checking", class: className, ...rest } = Astro.props;
---

<div class:list={["poll", className]} {...restProps(rest)}>
	<div class="track"><span class="sweep"></span></div>
	<div class="meta">
		<span class="u-label label">{label}</span>
		<span class="u-mono clock">{poll} of {pollMax}</span>
	</div>
</div>

<style>
	.poll {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}

	/* §2: 2px, the same bar the hold ribbon and the stock rule use. The theme
	   has one bar and it is always this one. */
	.track {
		position: relative;
		height: 2px;
		border-radius: 1px;
		background: var(--u-edge);
		overflow: hidden;
	}

	.sweep {
		position: absolute;
		inset: 0 auto 0 0;
		width: 34%;
		background: var(--u-violet);
		animation: poll-sweep 1.6s ease-in-out infinite;
	}

	@keyframes poll-sweep {
		from {
			transform: translateX(-100%);
		}
		to {
			transform: translateX(320%);
		}
	}

	.meta {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
	}

	/* In progress — the same violet the cart's hold uses. */
	.label,
	.clock {
		color: var(--u-violet);
	}

	.clock {
		font-size: 0.6875rem;
		font-weight: 500;
		white-space: nowrap;
	}

	/* Decoration, so it goes — but it goes to a state that still reads as "in
	   progress", not to a bare track. */
	@media (prefers-reduced-motion: reduce) {
		.sweep {
			animation: none;
			transform: none;
			width: 100%;
			opacity: 0.4;
		}
	}
</style>
