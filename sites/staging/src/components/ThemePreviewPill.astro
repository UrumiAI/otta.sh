---
/**
 * The "you are previewing" marker an ADMIN sees on the storefront while a live
 * theme preview is on (`src/lib/theme-preview.ts`, ADR-0024 as amended
 * 2026-09-30). Nobody else ever renders it: the Storefront shell passes it only
 * when the middleware recorded a preview for this request, which it does only
 * for an admin.
 *
 * THEME-NEUTRAL BY INVERSION. It reads the ACTIVE theme's own tokens, swapped —
 * `--u-ink` as the fill and `--u-ground` as the text — so it is legible on
 * every theme (each one's ink and ground are its highest-contrast pair) and
 * wears that theme's face and corner rather than a look of its own.
 *
 * NO CLIENT JS (ADR-0012's fence): "Exit preview" is a plain link to
 * `?preview_theme=off`, which the middleware answers by clearing the cookie and
 * redirecting to the clean URL. `pointer-events` stay on so the link works, and
 * the pill sits bottom-centre, clear of every theme's header and bag.
 */
interface Props {
	/** The previewed theme's label. */
	label: string;
	/** Where "Exit preview" goes. */
	exitHref: string;
}

const { label, exitHref } = Astro.props;
---

<aside class="preview" aria-label="Theme preview">
	<span class="dot" aria-hidden="true"></span>
	<span>Previewing <strong>{label}</strong> — not live</span>
	<span class="sep" aria-hidden="true"></span>
	<a href={exitHref}>Exit preview</a>
</aside>

<style>
	.preview {
		position: fixed;
		inset-block-end: 16px;
		inset-inline-start: 50%;
		translate: -50% 0;
		z-index: 2147483000;
		display: flex;
		align-items: center;
		gap: 10px;
		max-inline-size: calc(100vw - 32px);
		padding: 8px 16px;
		border-radius: var(--u-r);
		background: var(--u-ink);
		color: var(--u-ground);
		font-family: var(--u-body);
		font-size: 13px;
		line-height: 1.3;
		letter-spacing: 0;
		text-transform: none;
		box-shadow: 0 6px 24px -8px color-mix(in srgb, var(--u-ink) 60%, transparent);
		white-space: nowrap;
	}
	.preview strong {
		font-weight: 650;
	}
	.dot {
		inline-size: 7px;
		block-size: 7px;
		border-radius: 50%;
		background: currentColor;
		opacity: 0.7;
		flex: none;
	}
	.sep {
		inline-size: 1px;
		align-self: stretch;
		background: currentColor;
		opacity: 0.3;
	}
	.preview a {
		color: inherit;
		font-weight: 650;
		text-decoration-line: underline;
		text-underline-offset: 3px;
	}
	@media (max-width: 480px) {
		.preview {
			font-size: 12px;
			gap: 8px;
			padding: 8px 12px;
		}
	}
</style>
