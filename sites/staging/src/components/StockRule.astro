---
/**
 * StockRule — stock state as a rule, not a badge (docs/theme/TEMPERED.md §4).
 *
 * A short 2px rule in mono caps: solid when the thing is in stock, dashed when
 * it is not. Explicitly NOT a coloured pill — the tempering colours are
 * reserved for the states a shopper is waiting on (held, expiring, pending),
 * and spending violet on "in stock" would flatten the one signal the cart
 * depends on. Both states sit in `--u-mute`; the RULE carries the difference.
 *
 * The availability token comes verbatim off the product view model
 * (`AvailabilityToken`), so the theme localizes and the plugin decides.
 *
 * The mockup used to track `.s-stock` at 0.09em while `.s-label` tracked at
 * 0.11em. §3 states ONE figure for uppercase mono labels — 0.11em — and this is
 * one, so it takes the shared `.u-label` recipe rather than carrying a magic
 * number of its own; the mockup has since been synced to match.
 */
import type { AvailabilityToken } from "@urumi/plugin";
import type { HTMLAttributes } from "astro/types";
import { restProps } from "../lib/rest-props.js";

interface Props extends HTMLAttributes<"span"> {
	/** The view model's own token. `null` — not purchasable at all — renders
	 *  nothing: there is no stock fact to state. */
	availability: AvailabilityToken | null;
	/** Overrides the default wording, for a store that shows counts
	 *  ("3 left"). The state still decides the rule. */
	label?: string;
}

const { availability, label, class: className, ...rest } = Astro.props;

const state = availability === "in_stock" ? "in" : "out";
const text = label ?? (availability === "in_stock" ? "In stock" : "Sold out");
---

{
	availability !== null && (
		<span class:list={["u-label", "stock", className]} data-state={state} {...restProps(rest)}>
			{text}
		</span>
	)
}

<style>
	.stock {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
	}

	/* The rule itself. `currentColor` so it can never drift from its label. */
	.stock::before {
		content: "";
		flex: none;
		width: 1.25rem;
		height: 2px;
		border-radius: 1px;
		background: currentColor;
	}

	/* Sold out: the continuous rule breaks. Same device as the released hold
	   and the expired order stamp — a broken line means "this is not running". */
	.stock[data-state="out"]::before {
		background: repeating-linear-gradient(90deg, currentColor 0 3px, transparent 3px 6px);
	}
</style>
