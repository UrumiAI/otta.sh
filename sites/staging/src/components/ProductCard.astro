---
/**
 * ProductCard — one product in the catalog grid (docs/theme/TEMPERED.md §4).
 *
 * No card border, no shadow, no box: §2's "one hairline, never a box". The only
 * rule on the card is the one above its foot, and the grid's air does the rest
 * of the separating. The whole card is the link — the media, the title and the
 * price are all the same target, because on a catalog page they are all the
 * same intent.
 *
 * The FOOT is the fussy part: `margin-top: auto` pins it to the bottom of the
 * card so a three-line description and a one-line description still put their
 * price rules on the same baseline across a row. Without it the grid reads as
 * ragged even though every card is the same height.
 */
import type { AvailabilityToken } from "@urumi/plugin";
import type { HTMLAttributes } from "astro/types";
import MediaPanel from "./MediaPanel.astro";
import PriceTag from "./PriceTag.astro";
import StockRule from "./StockRule.astro";

interface Props extends HTMLAttributes<"a"> {
	href: string;
	title: string;
	/** Keys the coil's geometry (§5) — the slug, or the id when there is none. */
	slug: string;
	/** Position in the grid, which cycles the coil's tint so every three cards
	 *  show all three. Omit off a list. */
	index?: number;
	description?: string | null;
	image?: string | null;
	/** Pre-formatted, off the view model's `price.formatted`. `null` when the
	 *  product is not purchasable — the card then says so in prose rather than
	 *  showing a figure the store never quoted (§7). */
	price?: string | null;
	availability?: AvailabilityToken | null;
	/** The prose that replaces the price when there is none. */
	priceNote?: string;
	/**
	 * The card title's heading level.
	 *
	 * A card is not always the second level of its page: on a catalog page it
	 * sits under an h1, but under a section that already has its own h2 a
	 * hard-coded h2 skips no levels only by luck. The page knows; the card
	 * does not.
	 *
	 * Named `level` and not `as` — see StateStamp for why.
	 */
	level?: "h2" | "h3";
}

const {
	href,
	title,
	slug,
	index,
	description = null,
	image = null,
	price = null,
	availability = null,
	priceNote = "Not currently available for purchase",
	level = "h2",
	class: className,
	...rest
} = Astro.props;

const soldOut = availability === "out_of_stock";
const Heading = level;
---

<a class:list={["card", className]} href={href} data-sold-out={soldOut ? "" : undefined} {...rest}>
	{/* `dimmed` is a PROP, not a parent CSS rule: Astro scopes each
	    component's styles to its own hash, so a descendant selector written
	    here could never reach MediaPanel's root element. */}
	<MediaPanel slug={slug} index={index} image={image} dimmed={soldOut} />
	<Heading class="card-title">{title}</Heading>
	{description !== null && description !== "" && <p class="card-desc">{description}</p>}
	<span class="card-foot">
		{
			price === null ? (
				<span class="card-note">{priceNote}</span>
			) : (
				<PriceTag formatted={price} soldOut={soldOut} />
			)
		}
		<StockRule availability={availability} />
	</span>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
		text-decoration: none;
		color: inherit;
		/* Fills its grid cell, which is what lets the foot's `margin-top: auto`
		   align feet across the row. */
		height: 100%;
	}

	/* §3: the display face, narrow. Titles carry the weight on this page —
	   there is no other emphasis on a card. */
	.card-title {
		font-family: var(--u-display);
		font-variation-settings: "wdth" 78, "opsz" 48;
		font-weight: 700;
		font-size: 1.375rem;
		letter-spacing: -0.025em;
		line-height: 1;
		margin: 0;
		text-wrap: balance;
	}

	.card-desc {
		margin: 0;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--u-mute);
	}

	/* The one rule on the card, and the reason the row reads as a shelf. */
	.card-foot {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 0.625rem;
		border-top: var(--u-hair);
		margin-top: auto;
	}

	.card-note {
		font-size: 0.75rem;
		color: var(--u-mute);
	}

	/* Straw is the fitting: it underlines, it never fills (§2). */
	.card:hover .card-title {
		text-decoration: underline;
		text-decoration-color: var(--u-straw);
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
	}
</style>
