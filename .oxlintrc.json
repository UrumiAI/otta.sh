{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "error",
		"suspicious": "error"
	},
	"ignorePatterns": ["**/dist/**", "**/node_modules/**"],
	"env": {
		"node": true
	},
	"overrides": [
		{
			"files": ["packages/plugin/src/manifest.ts"],
			"rules": {
				"no-underscore-dangle": [
					"error",
					{
						"allow": ["__OTTA_EXTRA_ALLOWED_HOSTS__"]
					}
				]
			}
		},
		{
			"files": ["packages/plugin/src/payments/stripe-wiring.ts"],
			"rules": {
				"no-underscore-dangle": [
					"error",
					{
						"allow": ["__OTTA_DEV_STRIPE_OFFLINE__"]
					}
				]
			}
		},
		{
			"files": ["packages/domain/src/**/*.ts"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"paths": [
							{ "name": "pg", "message": "@urumi.ai/otta-domain is IO-free (DEVELOPMENT.md §3)" },
							{
								"name": "kysely",
								"message": "@urumi.ai/otta-domain is IO-free (DEVELOPMENT.md §3)"
							},
							{
								"name": "better-sqlite3",
								"message": "@urumi.ai/otta-domain is IO-free (DEVELOPMENT.md §3)"
							},
							{ "name": "hono", "message": "@urumi.ai/otta-domain is IO-free (DEVELOPMENT.md §3)" },
							{
								"name": "node:http",
								"message": "@urumi.ai/otta-domain is IO-free (DEVELOPMENT.md §3)"
							},
							{
								"name": "node:https",
								"message": "@urumi.ai/otta-domain is IO-free (DEVELOPMENT.md §3)"
							},
							{
								"name": "node-fetch",
								"message": "@urumi.ai/otta-domain is IO-free (DEVELOPMENT.md §3)"
							}
						]
					}
				]
			}
		}
	]
}
