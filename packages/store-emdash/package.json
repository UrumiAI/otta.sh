{
	"name": "@urumi.ai/otta-store-emdash",
	"version": "0.1.1",
	"description": "Commerce store adapters for Otta over the EmDash plugin-storage primitives — bound to a structural StorageAccess port, never to the host at runtime. REQUIRES the conditional-write primitives (updateIf/getVersioned/compareAndSet/compareAndDelete), first published in emdash 0.38.0.",
	"homepage": "https://github.com/UrumiAI/otta.sh#readme",
	"bugs": {
		"url": "https://github.com/UrumiAI/otta.sh/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/UrumiAI/otta.sh.git",
		"directory": "packages/store-emdash"
	},
	"files": [
		"dist",
		"!dist/tsc"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./testing": "./test/describe-each-dialect.ts"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"prepublishOnly": "tsdown",
		"test:d1": "vitest run --config vitest.d1.config.ts"
	},
	"dependencies": {
		"@urumi.ai/otta-domain": "workspace:*"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.1.8",
		"@emdash-cms/cloudflare": "1.0.1",
		"@types/better-sqlite3": "catalog:",
		"@types/pg": "catalog:",
		"better-sqlite3": "catalog:",
		"emdash": "1.0.1",
		"kysely": "catalog:",
		"pg": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"emdash": "^1.0.1"
	}
}
