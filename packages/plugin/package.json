{
	"name": "@urumi/plugin",
	"version": "0.0.1",
	"description": "Urumi EmDash plugin — sandbox-clean (workerd, Block Kit, ctx.http + allowedHosts only). No React, no DB/storage capability.",
	"homepage": "https://github.com/UrumiAI/otta.sh#readme",
	"bugs": {
		"url": "https://github.com/UrumiAI/otta.sh/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/UrumiAI/otta.sh.git",
		"directory": "packages/plugin"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./plugin": "./src/plugin.ts",
		"./sandbox-entry": "./src/sandbox-entry.ts"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"./plugin": {
				"types": "./dist/plugin.d.mts",
				"default": "./dist/plugin.mjs"
			},
			"./sandbox-entry": {
				"types": "./dist/sandbox-entry.d.mts",
				"default": "./dist/sandbox-entry.mjs"
			}
		}
	},
	"scripts": {
		"build": "tsdown"
	},
	"devDependencies": {
		"@hono/node-server": "catalog:",
		"@types/node": "catalog:",
		"@urumi/domain": "workspace:*",
		"@urumi/payments-stripe": "workspace:*",
		"@urumi/service": "workspace:*",
		"@urumi/store-postgres": "workspace:*",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"workerd": "^1.20260710.1"
	}
}
