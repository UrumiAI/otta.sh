{
	"name": "@urumi.ai/otta-plugin",
	"version": "0.2.0",
	"description": "Otta EmDash plugin — sandbox-clean (workerd, Block Kit, ctx.http + allowedHosts only). Runs commerce in-process on the host-injected ctx.storage; no React, no DB driver.",
	"homepage": "https://github.com/UrumiAI/otta.sh#readme",
	"bugs": {
		"url": "https://github.com/UrumiAI/otta.sh/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/UrumiAI/otta.sh.git",
		"directory": "packages/plugin"
	},
	"files": [
		"dist",
		"!dist/tsc",
		"!dist/**/*.d.mts.map",
		"THIRD_PARTY_NOTICES"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./plugin": "./src/plugin.ts",
		"./sandbox-entry": "./src/sandbox-entry.ts",
		"./subdivisions": "./src/subdivisions.ts",
		"./testing": "./src/testing.ts",
		"./trusted": "./src/trusted.ts"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"./plugin": {
				"types": "./dist/plugin.d.mts",
				"default": "./dist/plugin.mjs"
			},
			"./sandbox-entry": {
				"types": "./dist/sandbox-entry.d.mts",
				"default": "./dist/sandbox-entry.mjs"
			},
			"./subdivisions": {
				"types": "./dist/subdivisions.d.mts",
				"default": "./dist/subdivisions.mjs"
			},
			"./testing": {
				"types": "./dist/testing.d.mts",
				"default": "./dist/testing.mjs"
			},
			"./trusted": {
				"types": "./dist/trusted.d.mts",
				"default": "./dist/trusted.mjs"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"prepublishOnly": "tsdown"
	},
	"dependencies": {
		"@urumi.ai/otta-admin-presentation": "workspace:*",
		"@urumi.ai/otta-domain": "workspace:*",
		"@urumi.ai/otta-payments-stripe": "workspace:*",
		"@urumi.ai/otta-store-emdash": "workspace:*"
	},
	"devDependencies": {
		"emdash": "1.3.1",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"workerd": "^1.20260710.1"
	},
	"peerDependencies": {
		"emdash": "^1.3.1"
	}
}
