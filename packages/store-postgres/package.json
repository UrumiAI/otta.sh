{
	"name": "@urumi/store-postgres",
	"version": "0.1.0",
	"description": "Kysely-backed store adapters for Urumi — dialect-parameterized over better-sqlite3 (local) and pg (CI/prod).",
	"license": "MIT",
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./testing": "./src/testing.ts"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"./testing": {
				"types": "./dist/testing.d.mts",
				"default": "./dist/testing.mjs"
			}
		}
	},
	"scripts": {
		"build": "tsdown"
	},
	"dependencies": {
		"@urumi/domain": "workspace:*",
		"better-sqlite3": "catalog:",
		"kysely": "catalog:",
		"pg": "catalog:"
	},
	"devDependencies": {
		"@types/better-sqlite3": "catalog:",
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
