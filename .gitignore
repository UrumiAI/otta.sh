# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo
.wrangler/

# Host build artifacts — the EmDash CLI writes the applied-migration manifest
# next to the site on build; it is derived from the installed host, not source.
sites/*/.emdash/

# Local dev data
*.db
*.db-shm
*.db-wal
uploads/
.env
.env.*
!.env.example

# Test coverage and packed tarballs
coverage/
*.tgz

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
.vscode/
.idea/

# Claude Code per-user settings
.claude/settings.local.json

draft-plans/

# QA / e2e screenshot artifacts — never commit ad-hoc verification screenshots
/*.png
.playwright-mcp/
